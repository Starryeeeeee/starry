---
// 浮动唱片播放器：左下角圆盘，播放时旋转 + 边缘进度环，hover 展开曲名
// 加歌：往 public/music/ 放文件，并在下方 tracks 里加一行
import { u } from '../lib/base';

const tracks = [
  { file: 'komorebi.mp3', title: 'Komorebi', artist: '田熊理秀' },
];

const first = tracks[0];
---

<div class="music-dock" data-track-count={tracks.length}>
  <button
    class="music-disc"
    type="button"
    aria-label={`播放音乐：${first.title} - ${first.artist}`}
    aria-pressed="false"
  >
    <svg class="music-ring" viewBox="0 0 56 56" aria-hidden="true">
      <circle class="ring-track" cx="28" cy="28" r="26" />
      <circle class="ring-progress" cx="28" cy="28" r="26" />
    </svg>
    <span class="music-vinyl" aria-hidden="true">
      <svg viewBox="0 0 56 56">
        <circle cx="28" cy="28" r="27" fill="var(--ink)" />
        <circle cx="28" cy="28" r="24" fill="none" stroke="var(--line)" stroke-width="0.8" />
        <circle cx="28" cy="28" r="19" fill="none" stroke="var(--line)" stroke-width="0.6" />
        <circle cx="28" cy="28" r="9" fill="var(--accent)" />
        <circle cx="28" cy="28" r="2.4" fill="var(--bg)" />
        <path d="M28 1.5 A26.5 26.5 0 0 1 51 14" fill="none" stroke="var(--bg)" stroke-width="1.6" opacity="0.55" />
      </svg>
      <svg class="music-note" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M9 18V6l10-2v12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="6.5" cy="18" r="2.6" fill="currentColor" />
        <circle cx="16.5" cy="16" r="2.6" fill="currentColor" />
      </svg>
    </span>
  </button>
  <span class="music-label">
    <b class="music-title">{first.title}</b>
    <i class="music-artist">{first.artist}</i>
  </span>
  <audio preload="none" src={u(`/music/${first.file}`)}></audio>
</div>

<style>
  .music-dock {
    position: fixed;
    left: 22px;
    bottom: 22px;
    z-index: 40; /* 头部 50、灯箱 100 之下 */
    display: flex;
    align-items: center;
    gap: 0;
  }

  .music-disc {
    position: relative;
    width: 52px;
    height: 52px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: none;
    cursor: pointer;
    flex-shrink: 0;
  }

  /* 进度环：骑在圆盘外缘 */
  .music-ring {
    position: absolute;
    inset: -3px;
    width: calc(100% + 6px);
    height: calc(100% + 6px);
    transform: rotate(-90deg);
    pointer-events: none;
  }

  .ring-track {
    fill: none;
    stroke: color-mix(in srgb, var(--ink) 14%, transparent);
    stroke-width: 2;
  }

  .ring-progress {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 163.4; /* 2πr, r=26 */
    stroke-dashoffset: 163.4;
    transition: stroke-dashoffset 0.3s linear;
  }

  .music-vinyl {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    box-shadow: 0 2px 10px rgba(22, 22, 45, 0.18), 0 0 0 3px var(--bg);
    transition: transform 0.25s var(--ease-out, ease);
  }

  .music-vinyl > svg:first-child {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
  }

  .music-disc:hover .music-vinyl {
    transform: scale(1.06);
  }

  .music-disc:active .music-vinyl {
    transform: scale(0.96);
  }

  /* 唱片中心的小音符：暂停时显示，播放时淡出（唱盘转动自带信息量） */
  .music-note {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 13px;
    height: 13px;
    color: var(--bg);
    transform: translate(-50%, -50%);
    transition: opacity 0.2s ease;
  }

  :global(.music-playing) .music-note {
    opacity: 0;
  }

  /* 播放时唱片旋转 */
  .music-vinyl {
    animation: spin 14s linear infinite;
    animation-play-state: paused;
  }

  :global(.music-playing) .music-vinyl {
    animation-play-state: running;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* 曲名标签：默认收起，hover/播放时滑出 */
  .music-label {
    display: flex;
    flex-direction: column;
    gap: 1px;
    max-width: 0;
    margin-left: 0;
    padding: 6px 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-6px);
    transition: max-width 0.35s var(--ease-out, ease), opacity 0.25s ease,
      transform 0.35s var(--ease-out, ease), margin-left 0.35s var(--ease-out, ease);
    pointer-events: none;
  }

  .music-dock:hover .music-label,
  :global(.music-playing) .music-dock:not(:hover) .music-label,
  :global(.music-paused-open) .music-label {
    max-width: 180px;
    margin-left: 10px;
    opacity: 1;
    transform: none;
  }

  .music-title {
    font-size: 0.82rem;
    font-weight: 650;
    line-height: 1.3;
  }

  .music-artist {
    font-size: 0.72rem;
    font-style: normal;
    color: var(--ink-3);
    line-height: 1.3;
  }

  @media (prefers-reduced-motion: reduce) {
    .music-vinyl {
      animation: none;
    }
    .music-label {
      transition: none;
    }
  }

  @media (max-width: 640px) {
    .music-dock {
      left: 16px;
      bottom: 16px;
    }
    .music-disc {
      width: 44px;
      height: 44px;
    }
  }
</style>

<script>
  // 播放器逻辑：点击切换播放/暂停；进度环跟随；播完自动收起
  const dock = document.querySelector<HTMLElement>('.music-dock');
  const btn = dock?.querySelector<HTMLButtonElement>('.music-disc');
  const audio = dock?.querySelector<HTMLAudioElement>('audio');
  const progress = dock?.querySelector<SVGCircleElement>('.ring-progress');
  const CIRC = 163.4;

  if (dock && btn && audio && progress) {
    const setState = (playing: boolean) => {
      document.body.classList.toggle('music-playing', playing);
      btn.setAttribute('aria-pressed', String(playing));
      btn.setAttribute(
        'aria-label',
        (playing ? '暂停音乐：' : '播放音乐：') +
          (btn.getAttribute('aria-label')?.split('：')[1] ?? ''),
      );
    };

    btn.addEventListener('click', () => {
      if (audio.paused) {
        void audio.play();
      } else {
        audio.pause();
      }
    });

    audio.addEventListener('play', () => setState(true));
    audio.addEventListener('pause', () => setState(false));

    audio.addEventListener('timeupdate', () => {
      if (audio.duration > 0) {
        progress.style.strokeDashoffset = String(CIRC * (1 - audio.currentTime / audio.duration));
      }
    });

    audio.addEventListener('ended', () => {
      progress.style.strokeDashoffset = String(CIRC);
      setState(false);
    });
  }
</script>
