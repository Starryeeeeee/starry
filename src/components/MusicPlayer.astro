---
// 左下角音乐播放器：APlayer（github.com/DIYgod/APlayer，MIT 许可）固定迷你模式
// ——中文个人站事实标准，替代原先手写的黑胶圆盘。加歌：往 public/music/ 放
// 文件，并在下方 audio 列表里加一行（name / artist / url 必填，cover 可选）
import { u } from '../lib/base';
import 'aplayer/dist/APlayer.min.css';

const audio = [
  {
    name: 'Komorebi',
    artist: '田熊理秀',
    url: u('/music/komorebi.mp3'),
    cover: u('/music/cover.svg'),
  },
];
---

<div id="site-aplayer" data-audio={JSON.stringify(audio)}></div>

<style>
  /* APlayer 固定模式：贴左下角，层级压过头部(50)、让位灯箱(100) */
  :global(.aplayer.aplayer-fixed) {
    left: 18px;
    bottom: 18px;
    z-index: 60;
  }

  /* 皮肤对齐站内令牌：面板底、列表、文字全部跟随明暗主题，去掉默认白底 */
  :global(.aplayer.aplayer-fixed .aplayer-body),
  :global(.aplayer.aplayer-fixed .aplayer-list) {
    background: var(--surface) !important;
    color: var(--ink-2);
  }

  :global(.aplayer.aplayer-fixed .aplayer-body .aplayer-music) {
    display: none; /* 固定迷你态宽度太窄，曲名交给展开后的完整面板 */
  }

  :global(.aplayer .aplayer-list ol li) {
    border-top-color: var(--line) !important;
  }

  :global(.aplayer .aplayer-list ol li:hover),
  :global(.aplayer .aplayer-list ol li.aplayer-list-on) {
    background: var(--wash) !important;
  }

  :global(.aplayer .aplayer-list ol li .aplayer-list-author) {
    color: var(--ink-3) !important;
  }

  :global(.aplayer .aplayer-icon) {
    fill: var(--ink-3);
  }

  /* 展开/收起箭头按钮：默认自带浅灰底，换成站内色 */
  :global(.aplayer .aplayer-miniswitcher) {
    background: var(--surface-2) !important;
  }

  :global(.aplayer .aplayer-miniswitcher:hover) {
    background: var(--wash) !important;
  }

  :global(.aplayer .aplayer-miniswitcher .aplayer-icon) {
    fill: var(--ink-2);
  }

  /* 暗色下给迷你圆盘压一圈和站内一致的描边 */
  :global([data-theme='dark'] .aplayer.aplayer-fixed .aplayer-body .aplayer-pic) {
    box-shadow: 0 0 0 2px var(--line);
  }
</style>

<script>
  import APlayer from 'aplayer';

  const mount = document.getElementById('site-aplayer');
  const audio = JSON.parse(mount?.dataset.audio ?? '[]');

  if (mount && audio.length > 0) {
    new APlayer({
      container: mount,
      fixed: true,
      mini: true,
      autoplay: false,
      loop: 'all',
      order: 'random',
      volume: 0.7,
      theme: '#5f7f9e',
      audio,
    });
  }
</script>
