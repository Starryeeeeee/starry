---
import avatar from '../assets/avatar.jpg';
import { u } from '../lib/base';

const { pathname } = Astro.url;

// 主导航收敛为 6 项：高频内容在前，身份页收尾，细分栏目进「更多」。
// 以后加栏目先问一句：它值得挤掉主位吗？不值得就进 secondary。
const primary = [
  { href: '/', label: '首页' },
  { href: '/posts/', label: '文章' },
  { href: '/moments/', label: '废话条' },
  { href: '/kb/', label: '知识库' },
  { href: '/projects/', label: '作品' },
  { href: '/about/', label: '关于' },
];

const secondary = [
  { href: '/skills/', label: 'Skills' },
  { href: '/gallery/', label: '画廊' },
  { href: '/quotes/', label: '箴言' },
  { href: '/views/', label: '看法' },
  { href: '/changelog/', label: '建站日志' },
];

// 传入未加前缀的路径，比较时统一补上 base（构建时 Astro.url.pathname 含 base）
const isActive = (href: string) => {
  const full = u(href);
  return href === '/' ? pathname === full : pathname === full || pathname.startsWith(full);
};
---

<header class="site-header" data-nav>
  <div class="container wide header-inner">
    <a href={u('/')} class="brand" aria-label="回到首页">
      <span class="brand-avatar" aria-hidden="true">
        <img src={avatar.src} alt="" width="30" height="30" />
      </span>
      <span class="brand-cn">星野漫游</span>
      <span class="brand-en">Starry Roam</span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      <div class="nav-links" id="nav-links">
        <span class="nav-pill" aria-hidden="true"></span>
        {primary.map((item) => (
          <a href={u(item.href)} aria-current={isActive(item.href) ? 'true' : undefined}>
            {item.label}
          </a>
        ))}

        <div class="nav-more">
          <button
            class="nav-more-btn"
            type="button"
            aria-expanded="false"
            aria-controls="nav-more-menu"
            aria-current={secondary.some((item) => isActive(item.href)) ? 'true' : undefined}
            data-nav-more
          >
            更多
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 9l6 6 6-6" />
            </svg>
          </button>
          <div class="nav-more-menu" id="nav-more-menu" hidden>
            {secondary.map((item) => (
              <a href={u(item.href)} aria-current={isActive(item.href) ? 'true' : undefined}>
                {item.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="nav-tools">
        <a class="icon-btn admin-entry" href={u('/admin/')} aria-label="站长管理入口" title="站长入口：登录后可发布内容">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
        </a>
      </div>

    </nav>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="展开导航" data-nav-toggle>
        <svg class="nav-toggle-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg class="nav-toggle-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = document.querySelector<HTMLElement>('[data-nav-toggle]');
  const moreBtn = document.querySelector<HTMLElement>('[data-nav-more]');
  const moreMenu = document.getElementById('nav-more-menu');

  // ---- 移动端抽屉：就地展开，不开浮层，避免 sticky 与层级的连锁问题 ----
  const setDrawer = (open: boolean) => {
    header?.classList.toggle('nav-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? '收起导航' : '展开导航');
  };

  toggle?.addEventListener('click', () => {
    setDrawer(!header?.classList.contains('nav-open'));
  });

  // ---- 滑动指示条：鼠标划过时滑到哪一项，离开时回落到当前页 ----
  const navLinks = document.getElementById('nav-links');
  const navPill = navLinks?.querySelector<HTMLElement>('.nav-pill');
  const navItems = navLinks
    ? Array.from(
        navLinks.querySelectorAll<HTMLElement>(':scope > a, :scope > .nav-more > .nav-more-btn'),
      )
    : [];
  // 当前页可能在二级里，这时「更多」按钮带 aria-current，指示条就停在它上面
  const activeNavItem = navLinks?.querySelector<HTMLElement>('[aria-current="true"]') ?? null;

  const placePill = (el: HTMLElement | null) => {
    if (!navPill || !navLinks || !el) return;
    const host = navLinks.getBoundingClientRect();
    const r = el.getBoundingClientRect();
    if (!r.width) {
      navPill.dataset.show = 'false';
      return;
    }
    navPill.style.setProperty('--pill-x', `${Math.round(r.left - host.left)}px`);
    navPill.style.setProperty('--pill-w', `${Math.round(r.width)}px`);
    navPill.dataset.show = 'true';
  };

  for (const el of navItems) {
    el.addEventListener('mouseenter', () => placePill(el));
    el.addEventListener('focus', () => placePill(el));
  }
  navLinks?.addEventListener('mouseleave', () => placePill(activeNavItem));

  // 首帧与窗口变化时重算（字体加载完宽度会变，也要重算一次）
  placePill(activeNavItem);
  document.fonts?.ready.then(() => placePill(activeNavItem));
  let navResize: number | undefined;
  addEventListener('resize', () => {
    clearTimeout(navResize);
    navResize = window.setTimeout(() => placePill(activeNavItem), 120);
  });

  // ---- 桌面「更多」下拉 ----
  const setMore = (open: boolean) => {
    if (!moreMenu) return;
    moreMenu.hidden = !open;
    moreBtn?.setAttribute('aria-expanded', String(open));
  };

  moreBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    setMore(moreMenu?.hidden ?? true);
  });

  // 点外面 / 按 Esc 关闭；Esc 时把焦点还给触发按钮
  document.addEventListener('click', (e) => {
    if (!moreMenu || moreMenu.hidden) return;
    const target = e.target as Node;
    if (!moreMenu.contains(target) && !moreBtn?.contains(target)) setMore(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (moreMenu && !moreMenu.hidden) {
      setMore(false);
      moreBtn?.focus();
    }
    if (header?.classList.contains('nav-open')) {
      setDrawer(false);
      toggle?.focus();
    }
  });

  // 点导航里的链接后收起，避免返回上一页时抽屉还开着
  document.querySelectorAll('#nav-links a, #nav-more-menu a').forEach((a) => {
    a.addEventListener('click', () => {
      setDrawer(false);
      setMore(false);
    });
  });

  // 视口变宽后清掉移动端状态，防止桌面出现悬空展开
  matchMedia('(min-width: 901px)').addEventListener('change', (e) => {
    if (e.matches) setDrawer(false);
  });
</script>
