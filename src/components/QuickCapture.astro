---
// 全站快速记录：右下角浮动笔，点开弹出居中 Modal（手机端底部面板），写完即走
// 仅在站长已登录（localStorage 有 PAT）时显示；访客不可见
// 发布通道与 /admin 相同：往仓库 src/data/moments.md 追加一条，push 自动部署
// 位置走 global.css 的悬浮操作区约定（--fab-*），与 AI 星球挂件共用一条 dock 列
import penIcon from '../icons/ui/pen-line.svg?raw';
---

<div class="quick-capture" data-open="false" hidden>
  <!-- 遮罩 + 居中 Modal（手机端贴底弹出） -->
  <div class="qc-overlay" data-qc-overlay hidden>
    <div class="qc-modal" role="dialog" aria-modal="true" aria-label="快速记录">
      <div class="qc-types" role="radiogroup" aria-label="发布到">
        <button type="button" class="qc-type active" data-qc-type="moment" aria-pressed="true">废话条</button>
        <button type="button" class="qc-type" data-qc-type="quote" aria-pressed="false">箴言</button>
        <button type="button" class="qc-type" data-qc-type="view" aria-pressed="false">看法</button>
      </div>
      <div class="qc-stems" data-qc-stems hidden>
        <button type="button" class="qc-stem" data-qc-stem="今天发现：">今天发现：</button>
        <button type="button" class="qc-stem" data-qc-stem="我想记住：">我想记住：</button>
        <button type="button" class="qc-stem" data-qc-stem="反思：">反思：</button>
        <button type="button" class="qc-stem" data-qc-stem="读到一条：">读到一条：</button>
      </div>
      <textarea class="qc-text" data-qc-text rows="4" maxlength="500" placeholder="记一笔…（Enter 发送，Shift+Enter 换行）"></textarea>
      <div class="qc-foot">
        <span class="qc-hint" data-qc-hint></span>
        <button class="qc-send" type="button" data-qc-send>发布</button>
      </div>
    </div>
  </div>
  <button class="qc-fab" type="button" aria-label="快速记录" aria-expanded="false">
    <span class="qc-fab-icon" aria-hidden="true"><Fragment set:html={penIcon} /></span>
  </button>
</div>

<style>
  .quick-capture {
    position: fixed;
    /* dock 上位：星球在下方 --fab-bottom，快速记录在它上面一格（仅首页有星球时） */
    right: calc(var(--fab-right) + env(safe-area-inset-right, 0px));
    bottom: calc(var(--fab-bottom) + env(safe-area-inset-bottom, 0px));
    z-index: 91; /* 星球挂件 90、画廊灯箱 100 之下 */
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--fab-gap);
  }
  .quick-capture[hidden] {
    display: none;
  }
  /* 首页有星球挂件：快速记录让出它的位置，竖排成一列 */
  .quick-capture.has-pet {
    bottom: calc(
      var(--fab-bottom) + env(safe-area-inset-bottom, 0px) + var(--fab-size) + var(--fab-gap)
    );
  }

  /* ---- 遮罩 + Modal ---- */
  .qc-overlay {
    position: fixed;
    inset: 0;
    z-index: 120; /* 星球挂件 90、画廊灯箱 100 之上 */
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: color-mix(in srgb, var(--ink) 30%, transparent);
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
  }
  .qc-overlay[hidden] {
    display: none;
  }
  .qc-modal {
    width: min(500px, 100%);
    padding: 18px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 18px 60px rgba(22, 22, 45, 0.22);
    animation: qc-in 0.22s var(--ease-out, ease);
  }
  @keyframes qc-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .qc-modal {
      animation: none;
    }
  }

  .qc-types {
    display: flex;
    gap: 4px;
    margin-bottom: 10px;
  }
  /* 速记模板：把「开头」垫进输入框，降低起草成本（2026-11-14 采纳 Copilot 建议） */
  .qc-stems {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 8px;
  }
  .qc-stems[hidden] {
    display: none;
  }
  .qc-stem {
    padding: 4px 10px;
    font-family: inherit;
    font-size: 0.8rem;
    color: var(--ink-2);
    background: var(--wash);
    border: none;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .qc-stem:hover {
    background: color-mix(in srgb, var(--accent) 14%, var(--wash));
  }
  .qc-type {
    padding: 5px 13px;
    font-family: inherit;
    font-size: 0.84rem;
    color: var(--ink-2);
    background: none;
    border: none;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: color 0.2s ease, background 0.2s ease;
  }
  .qc-type.active {
    color: var(--accent-ink);
    background: var(--wash);
    font-weight: 650;
  }
  .qc-text {
    width: 100%;
    padding: 10px 12px;
    font-family: var(--font-body);
    /* 1rem：低于 16px 会触发 iOS 聚焦自动缩放 */
    font-size: 1rem;
    line-height: 1.7;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    resize: vertical;
    min-height: 96px;
  }
  .qc-text:focus {
    outline: 2px solid var(--accent);
    outline-offset: 0;
    border-color: transparent;
  }
  .qc-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 10px;
  }
  .qc-hint {
    font-size: 0.8rem;
    color: var(--ink-3);
    line-height: 1.5;
    min-height: 1.2em;
  }
  .qc-hint a {
    color: var(--accent-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .qc-hint.err {
    color: var(--rose);
  }
  .qc-send {
    flex-shrink: 0;
    padding: 8px 22px;
    font-family: inherit;
    font-size: 0.88rem;
    font-weight: 550;
    color: var(--on-solid);
    background: var(--accent);
    border: none;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: transform 0.15s ease, filter 0.2s ease;
  }
  .qc-send:hover {
    filter: brightness(1.06);
  }
  .qc-send:active {
    transform: scale(0.96);
  }
  .qc-send[disabled] {
    opacity: 0.55;
    cursor: default;
    transform: none;
  }

  /* ---- 浮动笔按钮 ---- */
  .qc-fab {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg);
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(22, 22, 45, 0.22);
    transition: transform 0.2s var(--ease-out, ease), background 0.2s ease;
  }
  .qc-fab:hover {
    transform: translateY(-2px) rotate(6deg);
  }
  .qc-fab:active {
    transform: scale(0.94);
  }
  .qc-fab-icon svg {
    display: block;
    width: 19px;
    height: 19px;
  }
  /* 打开时笔变成关闭态（旋转 45° 提示可收起） */
  .quick-capture[data-open='true'] .qc-fab {
    transform: rotate(8deg);
    background: var(--accent);
    color: var(--on-solid);
  }

  @media (max-width: 640px) {
    /* 手机端：Modal 贴底弹出，适配安全区，不被键盘顶住关键内容 */
    .qc-overlay {
      align-items: flex-end;
      padding: 0;
    }
    .qc-modal {
      width: 100%;
      border-radius: 16px 16px 0 0;
      border-left: none;
      border-right: none;
      border-bottom: none;
      padding: 16px 16px calc(16px + env(safe-area-inset-bottom, 0px));
      animation: qc-sheet 0.26s var(--ease-out, ease);
    }
    .qc-fab {
      width: 42px;
      height: 42px;
    }
  }
  @keyframes qc-sheet {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qc-fab,
    .qc-send {
      transition: none;
    }
  }
</style>

<script>
  // ============ 快速记录：往仓库 moments.md 追加一条（与 /admin 同通道） ============
  // Token 只从 localStorage 读取：不进 URL、不进控制台、不出现在错误信息里。
  import { u } from '../lib/base';
  import {
    MOMENTS_FILE_PATH,
    momentsFileBody,
    newMomentId,
    parseMomentsFile,
    toFileStamp,
    type FileMoment,
    type MomentKind,
  } from '../lib/moments-file';

  const REPO = 'Starryeeeeee/starry';
  const BRANCH = 'main';
  const TOKEN_KEY = 'sr-admin-token';
  const TYPE_NAMES: Record<string, string> = { moment: '废话条', quote: '箴言', view: '看法' };

  const root = document.querySelector<HTMLElement>('.quick-capture')!;
  const overlay = root.querySelector<HTMLElement>('[data-qc-overlay]')!;
  const fab = root.querySelector<HTMLButtonElement>('.qc-fab')!;
  const text = root.querySelector<HTMLTextAreaElement>('[data-qc-text]')!;
  const hint = root.querySelector<HTMLElement>('[data-qc-hint]')!;
  const sendBtn = root.querySelector<HTMLButtonElement>('[data-qc-send]')!;
  const typeBtns = [...root.querySelectorAll<HTMLButtonElement>('.qc-type')];

  const token = () => localStorage.getItem(TOKEN_KEY) ?? '';
  const label = () => root.querySelector<HTMLButtonElement>('[data-qc-type].active')?.dataset.qcType ?? 'moment';
  const typeName = () => TYPE_NAMES[label()] ?? '废话条';

  // 首页有星球挂件 → 快速记录让出下位，竖排成 dock（其他页面独占下位）
  root.classList.toggle('has-pet', !!document.querySelector('.starp-root'));

  // 仅站长可见：有令牌才显示（访客看不到这个入口）
  function refreshVisible() {
    root.hidden = !token();
  }
  refreshVisible();
  // 站主在别的标签页登录/退出时同步
  window.addEventListener('storage', (e) => {
    if (e.key === TOKEN_KEY) refreshVisible();
  });
  // /admin 的退出按钮会广播这个自定义事件，同一页面内即时同步
  window.addEventListener('sr-token-changed', refreshVisible);

  let hintTimer: number | undefined;
  function say(m: string, isErr = false) {
    hint.textContent = m;
    hint.classList.toggle('err', isErr);
    clearTimeout(hintTimer);
    hintTimer = window.setTimeout(() => (hint.textContent = ''), 4200);
  }

  // 草稿本地暂存：切页、断网、误退都不丢——输入即存，发布成功即清
  const DRAFT_KEY = 'sr-qc-draft';
  const saveDraft = () => {
    if (text.value.trim()) localStorage.setItem(DRAFT_KEY, text.value);
    else localStorage.removeItem(DRAFT_KEY);
  };
  text.addEventListener('input', saveDraft);

  function setOpen(open: boolean) {
    root.dataset.open = String(open);
    fab.setAttribute('aria-expanded', String(open));
    overlay.hidden = !open;
    if (open) {
      // 未登录：给出登录指引，不显示输入框
      const loggedIn = !!token();
      text.hidden = !loggedIn;
      sendBtn.hidden = !loggedIn;
      (root.querySelector('.qc-types') as HTMLElement).hidden = !loggedIn;
      (root.querySelector('[data-qc-stems]') as HTMLElement).hidden = !loggedIn;
      if (!loggedIn) {
        hint.classList.add('err');
        hint.innerHTML =
          '还没有登录——先去 <a href="' +
          u('/admin/') +
          '">管理面板</a> 用令牌登录，回来就能一键记录。';
      } else {
        hint.classList.remove('err');
        hint.textContent = '发布到「' + typeName() + '」';
        if (!text.value) text.value = localStorage.getItem(DRAFT_KEY) ?? '';
        text.focus();
      }
    } else {
      // 关闭后焦点回到快速记录按钮（键盘可达性）
      fab.focus();
    }
  }

  fab.addEventListener('click', () => setOpen(root.dataset.open !== 'true'));
  // 点遮罩空白处关闭（点 Modal 本身不关）
  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) setOpen(false);
  });

  for (const b of typeBtns) {
    b.addEventListener('click', () => {
      typeBtns.forEach((x) => {
        x.classList.toggle('active', x === b);
        x.setAttribute('aria-pressed', String(x === b));
      });
      hint.textContent = '发布到「' + typeName() + '」';
    });
  }

  // 速记模板：点一下把「开头」垫进输入框（已带开头就不重复）
  for (const b of [...root.querySelectorAll<HTMLButtonElement>('[data-qc-stem]')]) {
    b.addEventListener('click', () => {
      const stem = b.dataset.qcStem ?? '';
      if (!text.value.startsWith(stem)) text.value = stem + text.value;
      text.focus();
    });
  }

  text.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      sendBtn.click();
    }
    if (e.key === 'Escape') setOpen(false);
  });

  /** 把 GitHub 错误翻译成人话；令牌内容绝不进入错误信息 */
  function friendlyError(status: number, message: string): string {
    if (status === 401) return '登录已过期，请到 /admin 重新粘贴令牌（草稿还留着）';
    if (status === 403)
      return message.includes('rate limit')
        ? 'GitHub 限流了，休息几分钟再试（草稿还留着）'
        : '令牌权限不够：需要 repo 权限，去 /admin 检查';
    if (status === 422) return 'GitHub 拒绝了这条内容，换个说法再试（草稿还留着）';
    if (status === 409) return '动态文件刚被别处改过且重试仍冲突，稍等几秒再点一次发布';
    return `发布失败（${status}）：草稿已保留，稍后重试`;
  }

  const b64 = (s: string) => btoa(String.fromCharCode(...new TextEncoder().encode(s)));

  /** 读动态文件：解析后的条目 + 写回需要的 sha */
  const readMoments = async (): Promise<{ sha: string; entries: FileMoment[] }> => {
    const r = await fetch(
      `https://api.github.com/repos/${REPO}/contents/${MOMENTS_FILE_PATH}?ref=${BRANCH}`,
      {
        headers: { Authorization: `Bearer ${token()}`, Accept: 'application/vnd.github+json' },
      },
    );
    if (!r.ok) {
      const body = (await r.json().catch(() => ({}))) as { message?: string };
      throw Object.assign(new Error(friendlyError(r.status, body.message ?? '')), { status: r.status });
    }
    const data = (await r.json()) as { content: string; sha: string };
    const text = new TextDecoder().decode(
      Uint8Array.from(atob(data.content.replace(/\s/g, '')), (c) => c.charCodeAt(0)),
    );
    return { sha: data.sha, entries: parseMomentsFile(text) };
  };

  /** 写回动态文件；sha 冲突（恰有另一处同时写入）自动重读重试一次 */
  const writeMoments = async (entries: FileMoment[], sha: string, message: string) => {
    const bodyText = momentsFileBody(entries);
    const attempt = (currentSha: string) =>
      fetch(`https://api.github.com/repos/${REPO}/contents/${MOMENTS_FILE_PATH}`, {
        method: 'PUT',
        headers: {
          Authorization: `Bearer ${token()}`,
          Accept: 'application/vnd.github+json',
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ message, branch: BRANCH, content: b64(bodyText), sha: currentSha }),
      });
    let r = await attempt(sha);
    if (r.status === 409 || r.status === 422) {
      const fresh = await readMoments();
      r = await attempt(fresh.sha);
    }
    return r;
  };

  sendBtn.addEventListener('click', async () => {
    const value = text.value.trim();
    if (!value) return say('写点什么再发', true);
    sendBtn.disabled = true;
    say('发布中…');
    try {
      // 1) 往动态文件追加一条 —— 这一步成功才算记录成功
      const at = new Date();
      const entry: FileMoment = {
        id: newMomentId(at),
        at: toFileStamp(at),
        kind: label() as MomentKind,
        text: value,
      };
      const { sha, entries } = await readMoments();
      const r = await writeMoments([entry, ...entries], sha, `发动态：${value.slice(0, 20)}`);
      if (!r.ok) {
        const body = (await r.json().catch(() => ({}))) as { message?: string };
        throw Object.assign(new Error(friendlyError(r.status, body.message ?? '')), { status: r.status });
      }
      // 2) 写文件本身就是 commit，push 自动触发部署，无需再单独触发构建
      text.value = '';
      localStorage.removeItem(DRAFT_KEY);
      const where = label() === 'quote' ? '/quotes/' : label() === 'view' ? '/views/' : '/moments/';
      hint.innerHTML =
        '已发布到「' + typeName() + '」，1-2 分钟上站 · <a href="' + u(where) + '">立即查看</a>';
      window.setTimeout(() => setOpen(false), 1600);
    } catch (e) {
      // 草稿（text.value）故意保留，重试不丢内容
      const err = e as Error;
      const isNetwork =
        err instanceof TypeError || /failed to fetch|networkerror|load failed/i.test(err.message ?? '');
      say(
        isNetwork
          ? '网络连不上 GitHub——草稿已保留，稍后重试'
          : err.message || '网络异常，草稿已保留，稍后重试',
        true,
      );
    }
    sendBtn.disabled = false;
  });
</script>
