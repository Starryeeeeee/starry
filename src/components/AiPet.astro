---
// 星野挂件：右下角的星球宠物 + 深空观测终端。
// 终端视觉 = Game1（Starryeeeeee/Game1）的深空玻璃窗语言
//   （rgba 深空底 + 霁蓝辉光边框 + mac 红黄绿圆点 + 方块光标）
//   × GitHub 终端作品集的成熟范式（欢迎横幅/行内 prompt/↑↓ 历史）。
// 复用 src/lib/ai.ts 的全部能力（模型档案 / 站内资料检索 / Markdown 渲染）。
// 接通方式：站长浏览器有模型档案 → 直连；否则 site-config.json 的 ai.proxyUrl
//   （Cloudflare Worker 代理）→ 访客可用；都没有 → 温和提示未接通。
// 宠物形象：Microsoft Fluent Emoji "ringed-planet"（MIT），见 src/icons/friendly/planet.svg。
import planetSvg from '../icons/friendly/planet.svg?raw';
---

<div class="starp-root">
  <section class="starp-panel" data-starp-panel hidden role="dialog" aria-label="星野助手 · 观测终端">
    <header class="starp-head">
      <span class="starp-dot red" data-starp-close role="button" tabindex="0" aria-label="关闭终端" title="关闭"></span>
      <span class="starp-dot yellow" data-starp-min role="button" tabindex="0" aria-label="收起到标题栏" title="收起"></span>
      <span class="starp-dot green" data-starp-grow role="button" tabindex="0" aria-label="加高终端" title="加高"></span>
      <span class="starp-title">STARRY // OBSERVATORY TERMINAL</span>
    </header>
    <div class="starp-body" data-starp-chat aria-live="polite"></div>
    <form class="starp-inputline" data-starp-form>
      <span class="starp-host" aria-hidden="true">guest@starry:~$</span>
      <input type="text" data-starp-input aria-label="向星野助手提问" autocomplete="off"
             spellcheck="false" enterkeyhint="send" />
      <span class="starp-cursor" aria-hidden="true"></span>
    </form>
  </section>

  <button class="starp-fab" type="button" data-starp-fab aria-label="召唤星野助手" aria-expanded="false">
    <span class="starp-pet" set:html={planetSvg} />
  </button>
</div>

<style>
  .starp-root {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 90;
  }
  .starp-fab {
    display: block;
    width: 58px;
    height: 58px;
    padding: 0;
    border: none;
    background: none;
    border-radius: 50%;
    cursor: pointer;
    animation: starp-float 4.5s ease-in-out infinite;
    transition: transform 0.2s var(--ease-out, ease);
  }
  .starp-fab:hover {
    transform: scale(1.08);
  }
  .starp-fab:active {
    transform: scale(0.94);
  }
  .starp-pet {
    display: block;
    width: 46px;
    height: 46px;
    margin: 0 auto;
    filter: drop-shadow(0 4px 10px rgba(48, 53, 58, 0.18));
  }
  .starp-pet :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .starp-root.thinking .starp-pet {
    animation: starp-wiggle 0.9s ease-in-out infinite;
  }
  @keyframes starp-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }
  @keyframes starp-wiggle {
    0%,
    100% {
      transform: rotate(-6deg);
    }
    50% {
      transform: rotate(8deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .starp-fab,
    .starp-root.thinking .starp-pet {
      animation: none;
    }
  }
  /* 深空观测终端：Game1 的玻璃窗语言 */
  .starp-panel {
    position: absolute;
    right: 0;
    bottom: 70px;
    width: min(400px, calc(100vw - 24px));
    height: 420px;
    display: flex;
    flex-direction: column;
    background: rgba(6, 12, 24, 0.92);
    border: 1px solid rgba(90, 142, 200, 0.4);
    border-radius: 10px;
    box-shadow:
      0 0 60px rgba(40, 90, 150, 0.28),
      0 0 0 1px rgba(90, 142, 200, 0.08),
      inset 0 0 50px rgba(30, 70, 120, 0.08);
    backdrop-filter: blur(8px);
    overflow: hidden;
    font-family: var(--font-mono);
    transition: height 0.35s var(--ease-out, ease);
  }
  .starp-panel.min {
    height: auto;
  }
  .starp-panel.tall {
    height: min(560px, 76vh);
  }
  .starp-head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background: rgba(10, 20, 36, 0.75);
    border-bottom: 1px solid rgba(90, 142, 200, 0.22);
    flex-shrink: 0;
  }
  .starp-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
    cursor: pointer;
    transition: filter 0.15s ease, transform 0.15s ease;
  }
  .starp-dot:hover {
    filter: brightness(1.25);
    transform: scale(1.12);
  }
  .starp-dot.red {
    background: #ff5f56;
  }
  .starp-dot.yellow {
    background: #ffbd2e;
  }
  .starp-dot.green {
    background: #27c93f;
  }
  .starp-title {
    margin-left: 8px;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: rgba(140, 180, 220, 0.72);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .starp-body {
    flex: 1;
    overflow-y: auto;
    padding: 14px 16px;
    color: #c8ddf4;
    font-size: 0.84rem;
    line-height: 1.8;
    scrollbar-width: thin;
    scrollbar-color: rgba(90, 142, 200, 0.3) transparent;
  }
  .starp-panel.min .starp-body,
  .starp-panel.min .starp-inputline {
    display: none;
  }
  .starp-inputline {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    padding: 10px 16px;
    border-top: 1px solid rgba(90, 142, 200, 0.22);
  }
  .starp-host {
    font-size: 0.8rem;
    color: rgba(133, 240, 184, 0.85);
    flex-shrink: 0;
  }
  .starp-inputline input {
    flex: 1;
    min-width: 0;
    border: none;
    background: none;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: #f2fbff;
    outline: none;
    caret-color: #79a8dc;
  }
  .starp-inputline input::placeholder {
    color: rgba(140, 180, 220, 0.4);
  }
  /* 方块光标：输入框未聚焦时在行尾闪烁，聚焦后让位给真光标 */
  .starp-cursor {
    display: inline-block;
    width: 8px;
    height: 1.1em;
    background: #79a8dc;
    flex-shrink: 0;
    animation: starp-blink 1s steps(1) infinite;
    opacity: 0;
  }
  .starp-inputline.idle .starp-cursor {
    opacity: 1;
  }
  @keyframes starp-blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .starp-cursor {
      animation: none;
    }
  }
  @media (max-width: 560px) {
    .starp-root {
      right: 12px;
      bottom: 12px;
    }
    .starp-panel {
      right: -60px;
      bottom: 74px;
    }
  }
</style>

<!-- 终端行是 JS 运行时创建的：scoped 样式匹配不到，必须走全局块（.starp- 前缀防污染） -->
<style is:global>
  .starp-line {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    margin: 0 0 8px;
  }
  .starp-line.cmd {
    color: rgba(180, 215, 245, 0.92);
  }
  .starp-line.cmd .starp-ps1 {
    color: rgba(133, 240, 184, 0.85);
  }
  .starp-line.err {
    color: #ff9fae;
  }
  .starp-line.ok {
    color: #85f0b8;
  }
  .starp-line.answer {
    color: #e8f4ff;
  }
  .starp-msg.bot.md {
    white-space: normal;
  }
  .starp-msg.bot.md > :first-child {
    margin-top: 0;
  }
  .starp-msg.bot.md > :last-child {
    margin-bottom: 0;
  }
  .starp-msg.bot.md p {
    margin: 5px 0;
  }
  .starp-msg.bot.md ul,
  .starp-msg.bot.md ol {
    margin: 5px 0;
    padding-left: 1.3em;
  }
  .starp-msg.bot.md code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: rgba(10, 20, 36, 0.85);
    border: 1px solid rgba(90, 142, 200, 0.2);
    padding: 0.1em 0.4em;
    border-radius: 5px;
  }
  .starp-msg.bot.md pre {
    background: rgba(10, 20, 36, 0.85);
    border: 1px solid rgba(90, 142, 200, 0.2);
    border-radius: 8px;
    padding: 8px 10px;
    overflow-x: auto;
    margin: 6px 0;
  }
  .starp-msg.bot.md pre code {
    background: none;
    border: none;
    padding: 0;
  }
  .starp-msg.bot.md a {
    color: #79a8dc;
    text-underline-offset: 3px;
  }
  .starp-msg.bot.md h3,
  .starp-msg.bot.md h4,
  .starp-msg.bot.md h5 {
    margin: 8px 0 3px;
    font-size: 0.9em;
    font-weight: 650;
  }
  .starp-src {
    margin-top: 6px;
    padding-top: 5px;
    border-top: 1px dashed rgba(90, 142, 200, 0.25);
    font-size: 0.7rem;
    color: rgba(150, 195, 235, 0.72);
    overflow-wrap: anywhere;
  }
  .starp-src a {
    color: #79a8dc;
  }
  /* 思考中：三个小点透明度呼吸，不改布局 */
  .starp-dots {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    margin-left: 7px;
    height: 1em;
  }
  .starp-dots i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #79a8dc;
    opacity: 0.25;
    animation: starp-dot 1.2s ease-in-out infinite;
  }
  .starp-dots i:nth-child(2) {
    animation-delay: 0.18s;
  }
  .starp-dots i:nth-child(3) {
    animation-delay: 0.36s;
  }
  @keyframes starp-dot {
    0%,
    100% {
      opacity: 0.25;
    }
    40% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .starp-dots i {
      animation: none;
      opacity: 0.5;
    }
  }
</style>

<script>
  import { u } from '../lib/base';
  import {
    loadProfiles,
    loadActiveProfileId,
    aiChat,
    searchIndex,
    buildContextBlock,
    renderMarkdown,
    type AiConfig,
    type AiIndexEntry,
    type AiMessage,
  } from '../lib/ai';

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const root = $('.starp-root');
  const panel = $('[data-starp-panel]');
  const fab = $('[data-starp-fab]');
  const chat = $('[data-starp-chat]');
  const form = $('[data-starp-form]') as HTMLFormElement;
  const input = $('[data-starp-input]') as HTMLInputElement;
  const inputLine = $('.starp-inputline');

  const HISTORY_KEY = 'sr-pet-chat';
  type PetMsg = { role: 'user' | 'bot'; content: string };
  let history: PetMsg[] = [];
  try {
    const raw = JSON.parse(localStorage.getItem(HISTORY_KEY) ?? '[]') as PetMsg[];
    if (Array.isArray(raw)) history = raw.slice(-24);
  } catch {
    history = [];
  }
  const saveHistory = () =>
    localStorage.setItem(HISTORY_KEY, JSON.stringify(history.slice(-24)));

  let index: AiIndexEntry[] | null = null;
  let indexAt = 0;
  async function ensureIndex(): Promise<AiIndexEntry[]> {
    if (index && Date.now() - indexAt < 10 * 60 * 1000) return index;
    const r = await fetch(u('/api-index.json'));
    if (!r.ok) throw new Error('站内索引还没构建好');
    index = ((await r.json()) as { entries: AiIndexEntry[] }).entries ?? [];
    indexAt = Date.now();
    return index;
  }

  let siteCfg: { ai?: { proxyUrl?: string; model?: string } } | null = null;
  async function proxyEndpoint(): Promise<AiConfig | null> {
    if (siteCfg === null) {
      try {
        const r = await fetch(u('/site-config.json'));
        siteCfg = (await r.json()) as typeof siteCfg;
      } catch {
        siteCfg = {};
      }
    }
    const url = siteCfg?.ai?.proxyUrl?.trim();
    return url
      ? {
          baseUrl: url.replace(/\/+$/, ''),
          model: siteCfg?.ai?.model?.trim() || 'agnes-2.5-flash',
          apiKey: '',
        }
      : null;
  }

  async function currentEndpoint(): Promise<{ cfg: AiConfig; name: string } | null> {
    const profiles = loadProfiles();
    const prof = profiles.find((p) => p.id === loadActiveProfileId()) ?? profiles[0] ?? null;
    if (prof) return { cfg: prof, name: prof.name };
    const proxied = await proxyEndpoint();
    if (proxied) return { cfg: proxied, name: '星渚' };
    return null;
  }

  /** 终端行：ps1 前缀 + 文本；kind 决定配色（Game1 的 line-* 语义） */
  function line(
    kind: 'cmd' | 'err' | 'ok' | 'answer' | 'plain',
    text: string,
    ps1?: string,
  ): HTMLElement {
    const div = document.createElement('div');
    div.className = `starp-line ${kind}`;
    if (ps1) {
      const p = document.createElement('span');
      p.className = 'starp-ps1';
      p.textContent = ps1;
      div.appendChild(p);
      div.appendChild(document.createTextNode(' ' + text));
    } else {
      div.textContent = text;
    }
    chat.appendChild(div);
    chat.scrollTop = chat.scrollHeight;
    return div;
  }

  function thinkingLine(label: string): HTMLElement {
    const div = line('plain', label);
    const dots = document.createElement('span');
    dots.className = 'starp-dots';
    for (let i = 0; i < 3; i++) dots.appendChild(document.createElement('i'));
    div.appendChild(dots);
    return div;
  }

  function answerLine(el: HTMLElement, content: string) {
    el.className = 'starp-line answer starp-msg bot md';
    el.innerHTML = content;
  }

  async function ask(q: string) {
    line('cmd', q, 'guest@starry:~$');
    const bubble = thinkingLine('星渚 接入观测终端');
    const ep = await currentEndpoint();
    if (!ep) {
      bubble.classList.remove('starp-dots');
      bubble.classList.add('err');
      bubble.textContent =
        '观测终端还没有接通模型：站长在 /admin 配好模型后，这台浏览器就能直接用；访客则等站长部署好 Cloudflare Worker 代理后自动接入。';
      return;
    }
    root.classList.add('thinking');
    input.disabled = true;
    try {
      const entries = await ensureIndex();
      const hits = searchIndex(entries, q, 4);
      const persona = ep.name.split('（')[0].trim() || ep.name;
      const system =
        `你是「${persona}」，个人网站「星野漫游」的站内助手，由站长亲手配置并起了这个名字。` +
        `有人问你是谁、是什么模型、来自哪家公司时：你就是${persona}，是星野漫游的一员，不要提及底层模型与服务商。` +
        '请优先依据站内资料回答；资料里没有的就直说没有，不要编造。用简体中文回答，简洁自然。' +
        '\n\n== 站内资料 ==\n' +
        (buildContextBlock(hits) || '（本次未检索到相关站内资料）');
      const recent: AiMessage[] = history.slice(-6).map((m) => ({
        role: m.role === 'user' ? 'user' : 'assistant',
        content: m.content,
      }));
      const reply = await aiChat(
        ep.cfg,
        [
          { role: 'system', content: system },
          ...recent,
          { role: 'user', content: q },
        ],
        { maxTokens: 1500 },
      );
      history.push({ role: 'user', content: q }, { role: 'bot', content: reply });
      saveHistory();
      answerLine(bubble, await renderMarkdown(reply));
      if (hits.length) {
        const src = document.createElement('div');
        src.className = 'starp-src';
        src.textContent = '参考：' + hits.map((h) => h.entry.title).slice(0, 3).join('、');
        bubble.appendChild(src);
      }
      chat.scrollTop = chat.scrollHeight;
    } catch (e) {
      bubble.classList.remove('starp-dots');
      bubble.classList.add('err');
      bubble.textContent = '出错了：' + (e as Error).message;
    } finally {
      root.classList.remove('thinking');
      input.disabled = false;
      input.focus();
    }
  }

  // ---------- 事件 ----------
  let booted = false;
  function boot() {
    // 欢迎横幅：终端作品集的惯例开局
    line('ok', '┌─ 星野漫游 · 观测终端 v1.0');
    line('plain', '│ 连接星球资料库成功，我是星渚——这颗星球的管理员。');
    line('plain', '│ 问我关于站上的一切：文章、知识库、废话条、项目。');
    line('plain', '└─ 输入问题开始，↑↓ 可翻历史记录。');
    chat.scrollTop = chat.scrollHeight;
    booted = true;
  }

  function setOpen(open: boolean) {
    panel.hidden = !open;
    fab.setAttribute('aria-expanded', String(open));
    if (open) {
      if (!booted) boot();
      input.focus();
    }
  }

  fab.addEventListener('click', () => setOpen(panel.hidden));
  const dotClose = $('[data-starp-close]') as HTMLElement;
  const dotMin = $('[data-starp-min]') as HTMLElement;
  const dotGrow = $('[data-starp-grow]') as HTMLElement;
  const closeBy = (el: HTMLElement, fn: () => void) => {
    el.addEventListener('click', fn);
    el.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
        e.preventDefault();
        fn();
      }
    });
  };
  closeBy(dotClose, () => setOpen(false));
  closeBy(dotMin, () => panel.classList.toggle('min'));
  closeBy(dotGrow, () => panel.classList.toggle('tall'));

  // 输入框聚焦态切换方块光标（聚焦时用真光标）
  input.addEventListener('focus', () => inputLine.classList.remove('idle'));
  input.addEventListener('blur', () => inputLine.classList.add('idle'));
  inputLine.classList.add('idle');

  // 提交 + ↑↓ 历史记录（终端惯例）
  const cmdHistory: string[] = [];
  let cmdAt = -1;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const q = input.value.trim();
    if (!q) return;
    input.value = '';
    cmdHistory.push(q);
    cmdAt = cmdHistory.length;
    void ask(q);
  });
  input.addEventListener('keydown', (e) => {
    const k = (e as KeyboardEvent).key;
    if (k === 'ArrowUp' && cmdHistory.length) {
      e.preventDefault();
      cmdAt = Math.max(0, cmdAt - 1);
      input.value = cmdHistory[cmdAt] ?? '';
    } else if (k === 'ArrowDown' && cmdHistory.length) {
      e.preventDefault();
      cmdAt = Math.min(cmdHistory.length, cmdAt + 1);
      input.value = cmdHistory[cmdAt] ?? '';
    }
  });
  document.addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent).key === 'Escape' && !panel.hidden) setOpen(false);
  });
</script>
