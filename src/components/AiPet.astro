---
// 星野挂件：右下角的星球宠物 + 站内资料问答面板。
// 视觉跟全站一致（纸白 + 细线 + 小圆角），不再用深空玻璃/终端语言；
// 形象与全部能力保留：模型档案 / 站内资料检索 / Markdown / 历史 / 逐字打出。
// 复用 src/lib/ai.ts 的全部能力。
// 接通方式：站长浏览器有模型档案 → 直连；否则 site-config.json 的 ai.proxyUrl
//   （Cloudflare Worker 代理）→ 访客可用；都没有 → 温和提示未接通。
// 宠物形象：Microsoft Fluent Emoji "ringed-planet"（MIT），见 src/icons/friendly/planet.svg。
import planetSvg from '../icons/friendly/planet.svg?raw';
---

<div class="starp-root">
  <div class="starp-scrim" data-starp-scrim aria-hidden="true"></div>

  <section class="starp-panel" data-starp-panel hidden role="dialog" aria-label="星渚 · 站内资料问答">
    <header class="starp-head">
      <span class="starp-title">星渚<em>站内资料问答</em></span>
      <div class="starp-actions">
        <span class="starp-act" data-starp-min role="button" tabindex="0" aria-label="收起面板" title="收起">—</span>
        <span class="starp-act" data-starp-grow role="button" tabindex="0" aria-label="加高面板" title="加高">＋</span>
        <span class="starp-act close" data-starp-close role="button" tabindex="0" aria-label="关闭面板" title="关闭">✕</span>
      </div>
    </header>
    <div class="starp-body" data-starp-chat aria-live="polite"></div>
    <form class="starp-inputline" data-starp-form>
      <input type="text" data-starp-input aria-label="向星渚提问" autocomplete="off"
             spellcheck="false" enterkeyhint="send" placeholder="问点关于这个站的…" />
    </form>
  </section>

  <button class="starp-fab" type="button" data-starp-fab aria-label="召唤星野助手" aria-expanded="false">
    <span class="starp-pet" set:html={planetSvg} />
  </button>
</div>

<style>
  .starp-root {
    position: fixed;
    /* 悬浮操作区统一取位（global.css 约定），带安全区 */
    right: calc(var(--fab-right) + env(safe-area-inset-right, 0px));
    bottom: calc(var(--fab-bottom) + env(safe-area-inset-bottom, 0px));
    z-index: 90;
  }
  /* 手机端抽屉的遮罩；桌面形态不用 */
  .starp-scrim {
    display: none;
    position: fixed;
    inset: 0;
    background: rgb(0 0 0 / 34%);
  }
  /* hidden 会被下面的 display:flex 覆盖（全站第三次踩这个坑），统一压回来 */
  .starp-root [hidden] {
    display: none !important;
  }
  .starp-fab {
    display: block;
    width: 58px;
    height: 58px;
    padding: 0;
    border: none;
    background: none;
    border-radius: 50%;
    cursor: pointer;
    animation: starp-float 4.5s ease-in-out infinite;
    transition: transform 0.2s var(--ease-out, ease);
  }
  .starp-fab:hover {
    transform: scale(1.08);
  }
  .starp-fab:active {
    transform: scale(0.94);
  }
  .starp-pet {
    display: block;
    width: 46px;
    height: 46px;
    margin: 0 auto;
    filter: drop-shadow(0 3px 8px rgba(90, 72, 48, 0.14));
  }
  .starp-pet :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .starp-root.thinking .starp-pet {
    animation: starp-wiggle 0.9s ease-in-out infinite;
  }
  @keyframes starp-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }
  @keyframes starp-wiggle {
    0%,
    100% {
      transform: rotate(-6deg);
    }
    50% {
      transform: rotate(8deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .starp-fab,
    .starp-root.thinking .starp-pet {
      animation: none;
    }
  }

  /* 面板：和正文同一套纸白语言（surface + 细线 + 小圆角），不再用深空玻璃 */
  .starp-panel {
    position: absolute;
    right: calc(var(--fab-size) + 12px);
    bottom: 0;
    width: min(400px, calc(100vw - var(--fab-right) * 2 - var(--fab-size) - 12px));
    height: 420px;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    overflow: hidden;
    transition: height 0.35s var(--ease-out, ease);
  }
  .starp-panel.min {
    height: auto;
  }
  .starp-panel.tall {
    height: min(560px, 76vh);
  }
  .starp-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 10px 10px 10px 16px;
    border-bottom: 1px solid var(--line);
    flex-shrink: 0;
  }
  .starp-title {
    display: flex;
    align-items: baseline;
    gap: 8px;
    min-width: 0;
    font-family: var(--font-body);
    font-size: var(--text-md);
    color: var(--ink);
  }
  .starp-title em {
    font-style: normal;
    font-size: var(--text-2xs);
    letter-spacing: 0.04em;
    color: var(--ink-3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .starp-actions {
    display: flex;
    align-items: center;
    gap: 2px;
    flex-shrink: 0;
  }
  .starp-act {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--ink-3);
    font-family: inherit;
    font-size: 12px;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .starp-act:hover {
    background: var(--wash);
    color: var(--ink);
  }
  .starp-act.close:hover {
    color: var(--danger);
  }
  .starp-body {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: 1.85;
    color: var(--ink-2);
    scrollbar-width: thin;
  }
  .starp-panel.min .starp-body,
  .starp-panel.min .starp-inputline {
    display: none;
  }
  .starp-inputline {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    padding: 10px 12px 12px;
    border-top: 1px solid var(--line);
  }
  .starp-inputline input {
    flex: 1;
    min-width: 0;
    padding: 9px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--ink);
    outline: none;
    transition: border-color 0.2s ease;
  }
  .starp-inputline input::placeholder {
    color: var(--ink-3);
  }
  .starp-inputline input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 0;
    border-color: transparent;
  }
  /* 横屏或矮窗口：面板高度跟着视口收，不探出屏幕顶部 */
  @media (min-width: 641px) and (max-height: 560px) {
    .starp-panel {
      height: min(420px, calc(100dvh - 24px));
    }
    .starp-panel.tall {
      height: min(560px, calc(100dvh - 24px));
    }
  }

  /* ---- 手机：面板改成贴底的抽屉 ----
     旧写法把 left/right 都算在 58px 的挂件盒子上，宽度只剩 34px，
     正文被挤成「一行一个字」。改为相对视口定位，整条贴底展开。 */
  @media (max-width: 640px) {
    .starp-root.open .starp-scrim {
      display: block;
    }

    /* 抽屉铺到屏幕底部，右下角的星球会压在输入框上，打开时先收起来 */
    .starp-root.open .starp-fab {
      opacity: 0;
      pointer-events: none;
    }
    .starp-root.open .starp-fab,
    .starp-root.open .starp-pet {
      animation: none;
    }

    .starp-panel {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      width: auto;
      height: min(74dvh, 560px);
      padding-bottom: env(safe-area-inset-bottom, 0px);
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      border-bottom: 0;
      box-shadow: 0 -12px 40px rgba(90, 72, 48, 0.18);
    }
    .starp-panel.tall {
      height: min(90dvh, 760px);
    }
    .starp-panel.min {
      height: auto;
    }

    /* 抽屉形态不需要「收起 / 加高」，只留关闭 */
    .starp-act[data-starp-min],
    .starp-act[data-starp-grow] {
      display: none;
    }
    .starp-head {
      padding: 12px 10px 12px 18px;
    }
    .starp-act {
      width: 32px;
      height: 32px;
      font-size: 14px;
    }
    .starp-body {
      padding: 14px 16px;
    }
    .starp-inputline {
      padding: 10px 14px;
    }
    /* iOS 上输入框小于 16px，聚焦时会把整页自动放大 */
    .starp-inputline input {
      padding: 11px 14px;
      font-size: 16px;
    }
  }
</style>

<!-- 终端行是 JS 运行时创建的：scoped 样式匹配不到，必须走全局块（.starp- 前缀防污染） -->
<style is:global>
  /* 手机抽屉展开时，右下角快速记录入口让位（两个 fixed 按钮会叠在抽屉上） */
  @media (max-width: 640px) {
    body.starp-sheet-open .quick-capture {
      opacity: 0;
      pointer-events: none;
    }
  }
  .starp-line {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    margin: 0 0 12px;
  }
  /* 提问行：小标签 + 正文，不用终端提示符 */
  .starp-line.cmd {
    color: var(--ink);
    font-weight: 500;
  }
  .starp-line.cmd .starp-ps1 {
    display: inline-block;
    margin-right: 8px;
    padding: 1px 7px;
    border-radius: var(--radius-pill);
    background: var(--surface-2);
    color: var(--ink-3);
    font-family: var(--font-sans);
    font-size: var(--text-2xs);
    font-weight: 400;
  }
  .starp-line.err {
    color: var(--danger-ink);
  }
  .starp-line.ok {
    color: var(--accent-2-ink);
  }
  .starp-line.answer {
    color: var(--ink-2);
  }
  .starp-msg.bot.md {
    white-space: normal;
  }
  .starp-msg.bot.md > :first-child {
    margin-top: 0;
  }
  .starp-msg.bot.md > :last-child {
    margin-bottom: 0;
  }
  .starp-msg.bot.md p {
    margin: 6px 0;
  }
  .starp-msg.bot.md ul,
  .starp-msg.bot.md ol {
    margin: 6px 0;
    padding-left: 1.4em;
  }
  .starp-msg.bot.md code {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--surface-2);
    padding: 0.1em 0.4em;
    border-radius: var(--radius-sm);
  }
  .starp-msg.bot.md pre {
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 10px 12px;
    overflow-x: auto;
    margin: 8px 0;
  }
  .starp-msg.bot.md pre code {
    background: none;
    border: none;
    padding: 0;
  }
  .starp-msg.bot.md a {
    color: var(--accent-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .starp-msg.bot.md h3,
  .starp-msg.bot.md h4,
  .starp-msg.bot.md h5 {
    margin: 10px 0 4px;
    font-size: 0.95em;
    font-weight: 600;
    color: var(--ink);
  }
  .starp-src {
    margin-top: 8px;
    padding-top: 6px;
    border-top: 1px dashed var(--line);
    font-family: var(--font-sans);
    font-size: var(--text-2xs);
    color: var(--ink-3);
    overflow-wrap: anywhere;
  }
  .starp-src a {
    color: var(--accent-ink);
  }
  /* 思考中：三个小点透明度呼吸，不改布局 */
  .starp-dots {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    margin-left: 7px;
    height: 1em;
  }
  .starp-dots i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.25;
    animation: starp-dot 1.2s ease-in-out infinite;
  }
  .starp-dots i:nth-child(2) {
    animation-delay: 0.18s;
  }
  .starp-dots i:nth-child(3) {
    animation-delay: 0.36s;
  }
  @keyframes starp-dot {
    0%,
    100% {
      opacity: 0.25;
    }
    40% {
      opacity: 1;
    }
  }
  /* 打字机进行中：行尾小方块光标 */
  .starp-line.typing::after {
    content: '';
    display: inline-block;
    width: 0.45em;
    height: 1em;
    margin-left: 2px;
    vertical-align: -0.12em;
    background: var(--accent);
    animation: starp-caret 0.9s steps(1) infinite;
  }
  @keyframes starp-caret {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .starp-dots i {
      animation: none;
      opacity: 0.5;
    }
    .starp-line.typing::after {
      display: none;
    }
  }
</style>

<script>
  import { u } from '../lib/base';
  import {
    loadProfiles,
    loadActiveProfileId,
    aiChat,
    searchIndex,
    buildContextBlock,
    renderMarkdown,
    type AiConfig,
    type AiIndexEntry,
    type AiMessage,
  } from '../lib/ai';
  import { typeInto } from '../lib/typewriter';

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const root = $('.starp-root');
  const panel = $('[data-starp-panel]');
  const fab = $('[data-starp-fab]');
  const chat = $('[data-starp-chat]');
  const form = $('[data-starp-form]') as HTMLFormElement;
  const input = $('[data-starp-input]') as HTMLInputElement;

  const HISTORY_KEY = 'sr-pet-chat';
  type PetMsg = { role: 'user' | 'bot'; content: string };
  let history: PetMsg[] = [];
  try {
    const raw = JSON.parse(localStorage.getItem(HISTORY_KEY) ?? '[]') as PetMsg[];
    if (Array.isArray(raw)) history = raw.slice(-24);
  } catch {
    history = [];
  }
  const saveHistory = () =>
    localStorage.setItem(HISTORY_KEY, JSON.stringify(history.slice(-24)));

  let index: AiIndexEntry[] | null = null;
  let indexAt = 0;
  async function ensureIndex(): Promise<AiIndexEntry[]> {
    if (index && Date.now() - indexAt < 10 * 60 * 1000) return index;
    const r = await fetch(u('/api-index.json'));
    if (!r.ok) throw new Error('站内索引还没构建好');
    index = ((await r.json()) as { entries: AiIndexEntry[] }).entries ?? [];
    indexAt = Date.now();
    return index;
  }

  let siteCfg: { ai?: { proxyUrl?: string; model?: string } } | null = null;
  async function proxyEndpoint(): Promise<AiConfig | null> {
    if (siteCfg === null) {
      try {
        const r = await fetch(u('/site-config.json'));
        siteCfg = (await r.json()) as typeof siteCfg;
      } catch {
        siteCfg = {};
      }
    }
    const url = siteCfg?.ai?.proxyUrl?.trim();
    return url
      ? {
          baseUrl: url.replace(/\/+$/, ''),
          model: siteCfg?.ai?.model?.trim() || 'agnes-2.5-flash',
          apiKey: '',
        }
      : null;
  }

  async function currentEndpoint(): Promise<{ cfg: AiConfig; name: string } | null> {
    const profiles = loadProfiles();
    const prof = profiles.find((p) => p.id === loadActiveProfileId()) ?? profiles[0] ?? null;
    if (prof) return { cfg: prof, name: prof.name };
    const proxied = await proxyEndpoint();
    if (proxied) return { cfg: proxied, name: '星渚' };
    return null;
  }

  /** 终端行：ps1 前缀 + 文本；kind 决定配色（Game1 的 line-* 语义） */
  function line(
    kind: 'cmd' | 'err' | 'ok' | 'answer' | 'plain',
    text: string,
    ps1?: string,
  ): HTMLElement {
    const div = document.createElement('div');
    div.className = `starp-line ${kind}`;
    if (ps1) {
      const p = document.createElement('span');
      p.className = 'starp-ps1';
      p.textContent = ps1;
      div.appendChild(p);
      div.appendChild(document.createTextNode(' ' + text));
    } else {
      div.textContent = text;
    }
    chat.appendChild(div);
    chat.scrollTop = chat.scrollHeight;
    return div;
  }

  function thinkingLine(label: string): HTMLElement {
    const div = line('plain', label);
    const dots = document.createElement('span');
    dots.className = 'starp-dots';
    for (let i = 0; i < 3; i++) dots.appendChild(document.createElement('i'));
    div.appendChild(dots);
    return div;
  }

  async function ask(q: string) {
    line('cmd', q, '你');
    const bubble = thinkingLine('星渚 正在翻站内的资料');
    const ep = await currentEndpoint();
    if (!ep) {
      bubble.classList.remove('starp-dots');
      bubble.classList.add('err');
      bubble.textContent =
        '观测终端还没有接通模型：站长在 /admin 配好模型后，这台浏览器就能直接用；访客则等站长部署好 Cloudflare Worker 代理后自动接入。';
      return;
    }
    root.classList.add('thinking');
    input.disabled = true;
    try {
      const entries = await ensureIndex();
      const hits = searchIndex(entries, q, 4);
      const persona = ep.name.split('（')[0].trim() || ep.name;
      const system =
        `你是「${persona}」，个人网站「星野漫游」的站内助手，由站长亲手配置并起了这个名字。` +
        `有人问你是谁、是什么模型、来自哪家公司时：你就是${persona}，是星野漫游的一员，不要提及底层模型与服务商。` +
        '请优先依据站内资料回答；资料里没有的就直说没有，不要编造。用简体中文回答，简洁自然。' +
        '\n\n== 站内资料 ==\n' +
        (buildContextBlock(hits) || '（本次未检索到相关站内资料）');
      const recent: AiMessage[] = history.slice(-6).map((m) => ({
        role: m.role === 'user' ? 'user' : 'assistant',
        content: m.content,
      }));
      const reply = await aiChat(
        ep.cfg,
        [
          { role: 'system', content: system },
          ...recent,
          { role: 'user', content: q },
        ],
        { maxTokens: 1500 },
      );
      history.push({ role: 'user', content: q }, { role: 'bot', content: reply });
      saveHistory();
      bubble.classList.remove('starp-dots');
      bubble.classList.add('answer', 'starp-msg', 'bot');
      // 打字机：逐字揭示已渲染好的 Markdown（reduced-motion 用户直接整段显示）
      await typeInto(bubble, await renderMarkdown(reply), { scrollContainer: chat });
      if (hits.length) {
        const src = document.createElement('div');
        src.className = 'starp-src';
        src.textContent = '参考：' + hits.map((h) => h.entry.title).slice(0, 3).join('、');
        bubble.appendChild(src);
      }
      chat.scrollTop = chat.scrollHeight;
    } catch (e) {
      bubble.classList.remove('starp-dots');
      bubble.classList.add('err');
      bubble.textContent = '出错了：' + (e as Error).message;
    } finally {
      root.classList.remove('thinking');
      input.disabled = false;
      input.focus();
    }
  }

  // ---------- 事件 ----------
  let booted = false;
  function boot() {
    // 欢迎横幅：终端作品集的惯例开局
    line('plain', '连接星球资料库成功，我是星渚——这颗星球的管理员。');
    line('plain', '问我关于站上的一切：文章、知识库、废话条、项目。');
    line('plain', '直接输入问题开始，↑↓ 可翻历史记录。');
    chat.scrollTop = chat.scrollHeight;
    booted = true;
  }

  /** 手机上换成贴底抽屉：不自动聚焦输入框（会立刻弹出键盘把抽屉顶掉一半） */
  const isNarrow = () => window.matchMedia('(max-width: 640px)').matches;

  async function setOpen(open: boolean) {
    panel.hidden = !open;
    root.classList.toggle('open', open);
    fab.setAttribute('aria-expanded', String(open));
    // 抽屉展开时锁住背后的页面，避免滑动手势穿透
    document.body.style.overflow = open && isNarrow() ? 'hidden' : '';
    document.body.classList.toggle('starp-sheet-open', open && isNarrow());
    if (open) {
      if (!booted) {
        boot();
        // 回放本地保存的对话（整段渲染，不打字机——历史是批量回看）
        for (const m of history) {
          if (m.role === 'user') {
            line('cmd', m.content, '你');
          } else {
            const el = line('answer', '');
            el.className = 'starp-line answer starp-msg bot md';
            el.innerHTML = await renderMarkdown(m.content);
          }
        }
        booted = true;
      }
      if (!isNarrow()) input.focus();
    }
  }

  fab.addEventListener('click', () => setOpen(panel.hidden));

  // 点遮罩关闭（手机抽屉专用）
  ($('[data-starp-scrim]') as HTMLElement).addEventListener('click', () => setOpen(false));

  // 转屏 / 窗口变化后重新对齐滚动锁，避免桌面尺寸下页面被锁死
  window.addEventListener('resize', () => {
    if (!panel.hidden) document.body.style.overflow = isNarrow() ? 'hidden' : '';
  });
  const dotClose = $('[data-starp-close]') as HTMLElement;
  const dotMin = $('[data-starp-min]') as HTMLElement;
  const dotGrow = $('[data-starp-grow]') as HTMLElement;
  const closeBy = (el: HTMLElement, fn: () => void) => {
    el.addEventListener('click', fn);
    el.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
        e.preventDefault();
        fn();
      }
    });
  };
  closeBy(dotClose, () => setOpen(false));
  closeBy(dotMin, () => panel.classList.toggle('min'));
  closeBy(dotGrow, () => panel.classList.toggle('tall'));

  // 输入状态由真实插入光标（caret-color 蓝色）表达，点击输入框才出现

  // 提交 + ↑↓ 历史记录（终端惯例）
  const cmdHistory: string[] = [];
  let cmdAt = -1;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const q = input.value.trim();
    if (!q) return;
    input.value = '';
    cmdHistory.push(q);
    cmdAt = cmdHistory.length;
    void ask(q);
  });
  input.addEventListener('keydown', (e) => {
    const k = (e as KeyboardEvent).key;
    if (k === 'ArrowUp' && cmdHistory.length) {
      e.preventDefault();
      cmdAt = Math.max(0, cmdAt - 1);
      input.value = cmdHistory[cmdAt] ?? '';
    } else if (k === 'ArrowDown' && cmdHistory.length) {
      e.preventDefault();
      cmdAt = Math.min(cmdHistory.length, cmdAt + 1);
      input.value = cmdHistory[cmdAt] ?? '';
    }
  });
  document.addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent).key === 'Escape' && !panel.hidden) setOpen(false);
  });
</script>
