---
// 页面打开时的「水位」加载层。骨架借鉴 Uiverse.io 的 liquid-loader（ShaikhWahid99），
// 配色与行为按本站重做：莫奈水色单次充填、加载完淡出、无 JS 不显示。
---

<script is:inline>
  // 本会话已经开过站：首帧绘制前就打跳过标记，切页绝不闪加载层
  if (sessionStorage.getItem('sr-booted')) {
    document.documentElement.classList.add('pl-skip');
  }
</script>

<div class="page-loader" id="page-loader" aria-hidden="true">
  <div class="pl-inner">
    <p class="pl-text">roaming<span class="pl-dot"></span><span class="pl-dot"></span><span class="pl-dot"></span></p>
    <div class="pl-track">
      <div class="pl-fill"></div>
    </div>
  </div>
</div>

<style>
  /* 无 JS（html.js 类没打上）时绝不出现，内容不受影响；
     pl-skip = 本会话已开过站（切页 / 刷新），同样直接不出现 */
  :global(html:not(.js)) .page-loader,
  :global(html.pl-skip) .page-loader {
    display: none;
  }

  .page-loader {
    position: fixed;
    inset: 0;
    z-index: 200; /* 盖过灯箱(100) */
    display: grid;
    place-items: center;
    background: var(--bg);
    transition: opacity 0.45s var(--ease-out), visibility 0s linear 0.45s;
  }

  .page-loader.pl-done {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .pl-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .pl-text {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--ink-2);
    animation: pl-glow 1.2s ease-in-out infinite;
  }

  .pl-dot {
    display: inline-block;
    margin-left: 3px;
    animation: pl-blink 1.5s infinite;
  }

  .pl-dot:nth-of-type(1) { animation-delay: 0s; }
  .pl-dot:nth-of-type(2) { animation-delay: 0.3s; }
  .pl-dot:nth-of-type(3) { animation-delay: 0.6s; }

  /* 水位槽：浅浅的内凹，深浅主题自动跟随 */
  .pl-track {
    position: relative;
    width: 172px;
    height: 22px;
    padding: 2px;
    background: var(--surface-2);
    border-radius: 999px;
    box-shadow: inset 0 1px 3px color-mix(in srgb, var(--ink) 12%, transparent);
    overflow: hidden;
  }

  /* 水位：站内三个点缀色的水彩流动（雾蓝→湖水绿→陶土玫瑰），充填时逐段展开，
     再叠一层轻微的色相呼吸让它像活水；刻意压低幅度，不走霓虹路线 */
  .pl-fill {
    position: relative;
    height: 100%;
    width: 0;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--accent), #8aa595, #b4766b, var(--accent));
    animation: pl-fill 1.1s var(--ease-out) 0.1s forwards, pl-breathe 2.4s ease-in-out infinite;
  }

  .pl-fill::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      105deg,
      transparent 30%,
      color-mix(in srgb, var(--bg) 45%, transparent) 48%,
      transparent 62%
    );
    background-size: 240% 100%;
    animation: pl-shimmer 1.4s linear 0.3s infinite;
  }

  @keyframes pl-fill {
    to { width: 100%; }
  }

  @keyframes pl-breathe {
    0%, 100% { filter: hue-rotate(0deg) saturate(1); }
    50% { filter: hue-rotate(-16deg) saturate(1.18); }
  }

  @keyframes pl-shimmer {
    from { background-position: 120% 0; }
    to { background-position: -120% 0; }
  }

  @keyframes pl-glow {
    0%, 100% { opacity: 0.65; }
    50% { opacity: 1; }
  }

  @keyframes pl-blink {
    0%, 50% { opacity: 1; transform: none; }
    51%, 100% { opacity: 0.15; }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-loader {
      display: none; /* 不看动画的人直接看内容 */
    }
  }
</style>

<script>
  // 首次进站：等水位走完（1.1s 充填 + 半拍停顿）再退场，页面加载完也不提前砍；
  // 切页（pl-skip）：整个节点直接移除，什么都不演
  const loader = document.getElementById('page-loader');
  if (loader) {
    if (document.documentElement.classList.contains('pl-skip')) {
      loader.remove();
    } else {
      sessionStorage.setItem('sr-booted', '1');
      const MIN_SHOW = 1600; // 水位 1.1s + 0.1s 起手 + 0.4s 停顿
      const MAX_SHOW = 3600; // load 被大图拖住时的兜底
      const t0 = performance.now();
      let hidden = false;
      const hide = () => {
        if (hidden) return;
        hidden = true;
        loader.classList.add('pl-done');
        setTimeout(() => loader.remove(), 700);
      };
      const tryHide = () =>
        performance.now() - t0 >= MIN_SHOW ? hide() : setTimeout(tryHide, 150);
      if (document.readyState === 'complete') {
        setTimeout(tryHide, 50);
      } else {
        window.addEventListener('load', tryHide, { once: true });
      }
      setTimeout(hide, MAX_SHOW);
    }
  }
</script>
