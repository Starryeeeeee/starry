---
import '@fontsource/stix-two-text/400.css';
import '@fontsource/stix-two-text/600.css';
import '@fontsource/stix-two-text/700.css';
import '@fontsource/stix-two-text/400-italic.css';
import 'lxgw-wenkai-screen-webfont/style.css';
import 'katex/dist/katex.min.css'; // 数学公式（知识库的定理/公式条目）
import '../styles/global.css';
// 后台专用的 macOS 视觉层：只在 /admin 页面挂载，不进其他页面的样式包
import adminMacCss from '../styles/admin-mac.css?url';
// 后台玻璃点缀层（Uiverse 工艺翻译）：叠在 mac 层之上，只改控制条材质
import adminGlassCss from '../styles/admin-glass.css?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageLoader from '../components/PageLoader.astro';
import QuickCapture from '../components/QuickCapture.astro';
import { u } from '../lib/base';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Starry 的个人星球：作品集、AI Skills 分享、文章随感和日常废话条。' } = Astro.props;
const isAdmin = Astro.url.pathname.replace(/\/+$/, '').endsWith('/admin');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="alternate" type="application/rss+xml" title="星野漫游 RSS" href={u('/rss.xml')} />
    <link rel="icon" type="image/svg+xml" href={u('/favicon.svg')} />
    <!-- cn-font-split 子集字体（来自站长仓库）：阿里汉仪AI黑体（大标题）/ 寒蝉全圆体（正文圆体选项） -->
    <link rel="stylesheet" href={u('/fonts/alihei/result.css')} />
    <link rel="stylesheet" href={u('/fonts/hanchan/result.css')} />
    {isAdmin && <link rel="stylesheet" href={adminMacCss} />}
    {isAdmin && <link rel="stylesheet" href={adminGlassCss} />}
    <script is:inline>
      // 首屏前设定主题与背景偏好，避免闪烁
      const saved = localStorage.getItem('sr-theme');
      const theme =
        saved === 'light' || saved === 'dark'
          ? saved
          : matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
      document.documentElement.dataset.theme = theme;
      if (localStorage.getItem('sr-decor') === 'off') {
        document.documentElement.classList.add('no-decor');
      }
      // 正文字体偏好：kai（霞鹜文楷，默认）/ song（宋体）/ round（寒蝉全圆体）
      const bodyFont = localStorage.getItem('sr-body-font');
      document.documentElement.dataset.bodyFont =
        bodyFont === 'song' || bodyFont === 'round' ? bodyFont : 'kai';
      // 标记 JS 可用：滚动浮现的初始隐藏只在有 JS 时生效，避免无 JS 时内容消失
      document.documentElement.classList.add('js');
      // 动画标记：GSAP 入场的初始隐藏只在本标记存在时生效（尊重减少动态）
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('anim');
      }
    </script>
  </head>
  <body class={isAdmin ? 'macos-admin' : undefined}>
    <PageLoader />
    <div class="bg-decor" aria-hidden="true">
      <div class="bg-stars">
        <!-- 四芒星形取自 Uiverse.io by RiccardoRapelli（MIT），低频呼吸闪烁作背景点缀 -->
        <svg class="bg-star gold" style="left:8%; top:13%; width:15px; height:15px; animation-delay:-1s" viewBox="0 0 20 20"><path d="M 0 10 C 10 10,10 10 ,0 10 C 10 10 , 10 10 , 10 20 C 10 10 , 10 10 , 20 10 C 10 10 , 10 10 , 10 0 C 10 10,10 10 ,0 10 Z"/></svg>
        <svg class="bg-star blue" style="left:24%; top:34%; width:10px; height:10px; animation-delay:-4s" viewBox="0 0 20 20"><path d="M 0 10 C 10 10,10 10 ,0 10 C 10 10 , 10 10 , 10 20 C 10 10 , 10 10 , 20 10 C 10 10 , 10 10 , 10 0 C 10 10,10 10 ,0 10 Z"/></svg>
        <svg class="bg-star gold" style="left:47%; top:9%; width:12px; height:12px; animation-delay:-2.6s" viewBox="0 0 20 20"><path d="M 0 10 C 10 10,10 10 ,0 10 C 10 10 , 10 10 , 10 20 C 10 10 , 10 10 , 20 10 C 10 10 , 10 10 , 10 0 C 10 10,10 10 ,0 10 Z"/></svg>
        <svg class="bg-star blue" style="left:71%; top:20%; width:17px; height:17px; animation-delay:-5.2s" viewBox="0 0 20 20"><path d="M 0 10 C 10 10,10 10 ,0 10 C 10 10 , 10 10 , 10 20 C 10 10 , 10 10 , 20 10 C 10 10 , 10 10 , 10 0 C 10 10,10 10 ,0 10 Z"/></svg>
        <svg class="bg-star gold" style="left:90%; top:38%; width:11px; height:11px; animation-delay:-3.4s" viewBox="0 0 20 20"><path d="M 0 10 C 10 10,10 10 ,0 10 C 10 10 , 10 10 , 10 20 C 10 10 , 10 10 , 20 10 C 10 10 , 10 10 , 10 0 C 10 10,10 10 ,0 10 Z"/></svg>
        <svg class="bg-star blue" style="left:15%; top:72%; width:13px; height:13px; animation-delay:-6.1s" viewBox="0 0 20 20"><path d="M 0 10 C 10 10,10 10 ,0 10 C 10 10 , 10 10 , 10 20 C 10 10 , 10 10 , 20 10 C 10 10 , 10 10 , 10 0 C 10 10,10 10 ,0 10 Z"/></svg>
        <svg class="bg-star gold" style="left:82%; top:76%; width:14px; height:14px; animation-delay:-0.6s" viewBox="0 0 20 20"><path d="M 0 10 C 10 10,10 10 ,0 10 C 10 10 , 10 10 , 10 20 C 10 10 , 10 10 , 20 10 C 10 10 , 10 10 , 10 0 C 10 10,10 10 ,0 10 Z"/></svg>
      </div>
    </div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <QuickCapture />
  </body>
</html>

<script>
  // 滚动浮现：带 .reveal 的元素进入视口时淡入上移，只触发一次
  const reveals = document.querySelectorAll<HTMLElement>('.reveal');

  if ('IntersectionObserver' in window && reveals.length > 0) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
    );
    reveals.forEach((el) => io.observe(el));
  } else {
    reveals.forEach((el) => el.classList.add('is-revealed'));
  }
</script>
