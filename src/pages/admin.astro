---
// 站长管理面板：纯客户端，通过 GitHub API 直接读写仓库（等于把 GitHub 当后端）
// 登录方式：GitHub 个人访问令牌（PAT），只存在站长自己浏览器的 localStorage 里
import Base from '../layouts/Base.astro';
---

<Base title="管理 · 星野漫游" description="站长管理面板。">
  <div class="container admin">
    <header class="admin-head">
      <div>
        <h1>管理面板</h1>
        <p class="admin-greet"><span data-greet></span>，Starry。</p>
      </div>
      <div class="admin-user" hidden>
        <img alt="" width="30" height="30" />
        <b></b>
        <button class="admin-btn ghost" type="button" data-act="logout">退出</button>
      </div>
    </header>

    <p class="admin-overview" data-overview hidden>
      <span>文章 <b data-o="posts">–</b></span>
      <span>动态 <b data-o="moments">–</b></span>
      <span>知识库 <b data-o="kb">–</b></span>
      <span>画廊 <b data-o="gallery">–</b></span>
    </p>

    <!-- 登录 -->
    <section class="admin-login" hidden>
      <img class="login-mascot" src="/starry/favicon.svg" alt="" width="88" height="88" />
      <h2 class="login-title">站长通道</h2>
      <p class="login-sub">粘贴 GitHub 个人访问令牌登录。令牌只存在这台电脑的浏览器里，不上站、不进仓库。</p>
      <ol>
        <li>打开 <a href="https://github.com/settings/tokens/new?scopes=repo,workflow&description=starry-roam-admin" target="_blank" rel="noopener">github.com/settings/tokens/new</a>（已预选 repo + workflow 权限）</li>
        <li>Generate token，复制生成的一串字符</li>
        <li>粘贴到下面，登录</li>
      </ol>
      <div class="login-row">
        <input type="password" placeholder="ghp_…" autocomplete="off" spellcheck="false" />
        <button class="admin-btn primary" type="button" data-act="login">登录</button>
      </div>
      <p class="admin-msg" role="status"></p>
    </section>

    <!-- 主体 -->
    <section class="admin-body" hidden>
      <nav class="admin-tabs" role="tablist">
        <button class="admin-tab active" type="button" data-tab="moment" role="tab">动态</button>
        <button class="admin-tab" type="button" data-tab="post" role="tab">文章</button>
        <button class="admin-tab" type="button" data-tab="kb" role="tab">知识库</button>
        <button class="admin-tab" type="button" data-tab="gallery" role="tab">画廊</button>
        <button class="admin-tab" type="button" data-tab="site" role="tab">站点</button>
        <button class="admin-tab" type="button" data-tab="ai" role="tab">AI 助手</button>
      </nav>

      <!-- 动态（废话条 / 箴言 / 看法，同一入口不同标签） -->
      <div class="admin-panel" data-panel="moment">
        <div class="field-grid">
          <label class="field">
            <span>发布到</span>
            <select data-moment-label>
              <option value="moment">废话条</option>
              <option value="quote">箴言</option>
              <option value="view">看法</option>
            </select>
          </label>
        </div>
        <textarea rows="3" placeholder="这一刻的想法…"></textarea>
        <div class="row-end">
          <button class="admin-btn primary" type="button" data-act="publish-moment">发布</button>
        </div>
        <h3><span data-moment-list-title>已发布的动态</span><i class="sec-count" data-sec-count="moments"></i></h3>
        <ul class="admin-list" data-list="moments"></ul>
      </div>

      <!-- 文章 -->
      <div class="admin-panel" data-panel="post" hidden>
        <div class="edit-banner" data-edit-banner="post" hidden>
          正在编辑 <b data-edit-name></b><span class="edit-note">保存后保留原发布日期</span>
          <button class="admin-btn ghost" type="button" data-act="cancel-edit-post">取消编辑</button>
        </div>
        <label class="field">
          <span>标题</span>
          <input type="text" data-post="title" placeholder="文章标题" />
        </label>
        <div class="field-grid">
          <label class="field">
            <span>文件名（英文）</span>
            <input type="text" data-post="slug" placeholder="my-first-post" />
          </label>
          <label class="field">
            <span>标签（逗号分隔）</span>
            <input type="text" data-post="tags" placeholder="随感, 记录" />
          </label>
        </div>
        <label class="field">
          <span>状态</span>
          <select data-post="status">
            <option value="public">公开</option>
            <option value="draft">草稿（不上站）</option>
            <option value="archived">归档（列表隐藏，直链可见）</option>
          </select>
        </label>
        <label class="field">
          <span>摘要</span>
          <input type="text" data-post="desc" placeholder="一句话摘要（可空）" />
        </label>
        <label class="field">
          <span>正文（Markdown）</span>
          <textarea rows="10" data-post="body" placeholder="# 用 Markdown 写…"></textarea>
        </label>
        <div class="row-end">
          <button class="admin-btn primary" type="button" data-act="publish-post">发布文章</button>
        </div>
        <h3>已有文章<i class="sec-count" data-sec-count="posts"></i></h3>
        <ul class="admin-list" data-list="posts"></ul>
      </div>

      <!-- 知识库 -->
      <div class="admin-panel" data-panel="kb" hidden>
        <div class="kb-modes">
          <label class="kb-mode"><input type="radio" name="kb-mode" value="note" checked /> 写笔记 / 技巧</label>
          <label class="kb-mode"><input type="radio" name="kb-mode" value="file" /> 上传文档</label>
        </div>

        <!-- 写条目 -->
        <div class="kb-form" data-kb-form="note">
          <div class="edit-banner" data-edit-banner="kb" hidden>
            正在编辑 <b data-edit-name></b><span class="edit-note">保存后保留原日期</span>
            <button class="admin-btn ghost" type="button" data-act="cancel-edit-kb">取消编辑</button>
          </div>
          <label class="field">
            <span>标题</span>
            <input type="text" data-kb-note="title" placeholder="如：圆锥曲线常用小结论" />
          </label>
          <div class="field-grid">
            <label class="field">
              <span>科目 / 主题</span>
              <input type="text" data-kb-note="subject" list="kb-subjects" placeholder="数学" />
              <datalist id="kb-subjects">
                <option value="数学"></option>
                <option value="英语"></option>
                <option value="语文"></option>
                <option value="物理"></option>
                <option value="化学"></option>
                <option value="生物"></option>
                <option value="信息技术"></option>
                <option value="方法论"></option>
                <option value="资料"></option>
              </datalist>
            </label>
            <label class="field">
              <span>标签（逗号分隔）</span>
              <input type="text" data-kb-note="tags" placeholder="解析几何, 小结论" />
            </label>
          </div>
          <label class="field">
            <span>状态</span>
            <select data-kb-note="status">
              <option value="public">公开</option>
              <option value="draft">草稿（不上站）</option>
              <option value="archived">归档（列表隐藏，直链可见）</option>
            </select>
          </label>
          <label class="field">
            <span>一句话说明</span>
            <input type="text" data-kb-note="desc" placeholder="列表页显示的摘要（可空）" />
          </label>
          <label class="field">
            <span>正文（Markdown，支持 $行内$ 与 $$公式块$$）</span>
            <textarea rows="8" data-kb-note="body" placeholder="## 结论&#10;椭圆焦点弦最短为 $2b^2/a$…"></textarea>
          </label>
          <div class="row-end">
            <button class="admin-btn primary" type="button" data-act="publish-kb-note">发布条目</button>
          </div>
        </div>

        <!-- 传文档 -->
        <div class="kb-form" data-kb-form="file" hidden>
          <label class="field">
            <span>选择文件（PDF / Word / PPT / Markdown 等）</span>
            <input type="file" data-kb-file />
          </label>
          <label class="field">
            <span>标题（不填就用文件名）</span>
            <input type="text" data-kb-file="title" placeholder="函数专题讲义" />
          </label>
          <div class="field-grid">
            <label class="field">
              <span>科目 / 主题</span>
              <input type="text" data-kb-file="subject" list="kb-subjects" placeholder="数学" />
            </label>
            <label class="field">
              <span>标签（逗号分隔）</span>
              <input type="text" data-kb-file="tags" placeholder="函数, 讲义" />
            </label>
          </div>
          <label class="field">
            <span>一句话说明</span>
            <input type="text" data-kb-file="desc" placeholder="这份资料讲了什么（可空）" />
          </label>
          <div class="row-end">
            <button class="admin-btn primary" type="button" data-act="upload-kb-file">上传并发布</button>
          </div>
          <p class="hint">上传的文件会存进仓库 public/kb/，随站点一起发布；PDF 在详情页可直接预览。</p>
        </div>

        <h3>已有条目<i class="sec-count" data-sec-count="kb"></i></h3>
        <ul class="admin-list" data-list="kb"></ul>
      </div>

      <!-- 画廊 -->
      <div class="admin-panel" data-panel="gallery" hidden>
        <div
          class="gallery-drop"
          data-gallery-drop
          role="button"
          tabindex="0"
          aria-label="选择或拖入图片"
        >
          <b>选择图片，或把图片拖到这里</b>
          <span>可多选 · 自动按今天日期命名 · 大图自动压缩</span>
        </div>
        <input type="file" data-gallery-input accept="image/*" multiple hidden />
        <label class="field">
          <span>图注（不填就用文件名；多选时对所有图片生效）</span>
          <input type="text" data-gallery-caption placeholder="如：社团活动合影" />
        </label>
        <div class="row-end">
          <button class="admin-btn primary" type="button" data-act="gallery-upload">上传所选</button>
        </div>
        <p class="hint" data-gallery-status role="status"></p>

        <h3>已有图片<i class="sec-count" data-sec-count="gallery"></i></h3>
        <ul class="admin-list" data-list="gallery"></ul>
      </div>

      <!-- 站点 -->
      <div class="admin-panel" data-panel="site" hidden>
        <h3>构建</h3>
        <p class="hint">发布内容后一般会自动构建；发完废话条或想立刻刷新站点时手动点一次。</p>
        <button class="admin-btn" type="button" data-act="rebuild">触发重新构建</button>

        <h3>评论（giscus · GitHub 登录评论）</h3>
        <p class="hint">开启前提（各做一次）：仓库 Settings → Features 勾选 Discussions；安装 <a href="https://github.com/apps/giscus" target="_blank" rel="noopener">giscus App</a>。都完成后点下面按钮，自动写入配置，1-2 分钟后文章页出现评论区。</p>
        <button class="admin-btn" type="button" data-act="setup-giscus">一键配置评论</button>

        <h3>音乐</h3>
        <p class="hint">在「站点」之外操作：把 mp3 放进仓库 <code>public/music/</code>，再改 <code>src/components/MusicPlayer.astro</code> 顶部的曲目列表。</p>
      </div>

      <!-- AI 助手 -->
      <div class="admin-panel" data-panel="ai" hidden>
        <h3>模型管理</h3>
        <p class="hint">每个「模型」是一位成员：起一个名字（也是它在对话里的身份），配一套接口。任何 OpenAI 兼容接口都能接；API Key 只保存在本浏览器 localStorage，不会写入网站仓库。聊天时用输入框左侧的小切换器随时换人。</p>
        <div class="ai-profiles" data-ai="profiles"></div>
        <label class="field">
          <span>名字（显示名，也是它的自我介绍身份）</span>
          <input type="text" data-ai="name" placeholder="星渚（Stellula-2.5）" />
        </label>
        <label class="field">
          <span>服务商预设</span>
          <select data-ai="preset"></select>
        </label>
        <p class="hint" data-ai="preset-note"></p>
        <div class="field-grid">
          <label class="field">
            <span>Base URL</span>
            <input type="text" data-ai="baseUrl" placeholder="https://api.agnes-ai.cn/v1" spellcheck="false" />
          </label>
          <label class="field">
            <span>模型</span>
            <input type="text" data-ai="model" placeholder="agnes-2.5-flash" spellcheck="false" />
          </label>
        </div>
        <label class="field">
          <span>API Key</span>
          <input type="password" data-ai="apiKey" placeholder="sk-…" autocomplete="off" spellcheck="false" />
        </label>
        <div class="row-end">
          <button class="admin-btn ghost" type="button" data-act="ai-profile-new">另起新模型</button>
          <button class="admin-btn" type="button" data-act="ai-test">测试连接</button>
          <button class="admin-btn primary" type="button" data-act="ai-save">保存模型</button>
        </div>
        <p class="hint" data-ai="status" role="status"></p>

        <h3>资料问答</h3>
        <p class="hint">AI 会先从全站索引（构建时生成的 <code>/api-index.json</code>）里检索最相关的几条内容，再据此回答；新发布的内容要等构建完成后才能被检索到。对话记录保存在本浏览器。</p>
        <div class="ai-session-bar">
          <button class="admin-btn ghost" type="button" data-act="ai-new-chat">＋ 新对话</button>
          <select class="ai-session-select" data-ai="session"></select>
          <button class="admin-btn ghost" type="button" data-act="ai-del-chat">删除此对话</button>
        </div>
        <div class="ai-chat" data-ai-chat hidden></div>
        <div class="ai-quick">
          <button class="admin-btn ghost" type="button" data-ai-q="用几句话总结一下我的网站上都有哪些内容">总结站上内容</button>
          <button class="admin-btn ghost" type="button" data-ai-q="帮我把下面这句话润色成一条废话条，保持原意、语言更有味道，只输出润色后的一句话：">润色废话条</button>
        </div>
        <div class="ai-modes">
          <label class="kb-mode"><input type="checkbox" data-ai="think" /> 深度思考</label>
          <label class="kb-mode"><input type="checkbox" data-ai="web" /> 联网搜索</label>
          <span class="ai-mode-note">都不开 = 快速模式，只基于站内资料；开思考更缜密但更慢；开联网则站内资料与网上结果结合分析</span>
        </div>
        <div class="ai-input-row">
          <div class="ai-model-switch">
            <button class="ai-model-pill" type="button" data-ai="model-pill">模型</button>
            <div class="ai-model-pop" data-ai="model-pop" hidden></div>
          </div>
          <input type="text" data-ai="input" placeholder="问点什么…（Enter 发送）" />
          <button class="admin-btn primary" type="button" data-act="ai-send">发送</button>
        </div>
      </div>

      <p class="admin-msg" role="status"></p>
    </section>
  </div>
</Base>

<style>
  /* hidden 属性会被本文件的 display 规则覆盖，这里统一压回来 */
  .admin [hidden] {
    display: none !important;
  }

  .admin {
    padding-top: 44px;
    padding-bottom: 120px; /* 给左下角音乐唱片留位 */
  }
  .admin-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
  }
  .admin-head h1 {
    font-family: var(--font-display-cn);
    font-weight: 400;
    font-size: 1.7rem;
  }
  .admin-greet {
    margin-top: 4px;
    font-size: 0.9rem;
    color: var(--ink-2);
  }
  .admin-user {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    padding: 5px 8px 5px 6px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .admin-user img {
    border-radius: 50%;
  }
  .admin-user b {
    font-weight: 650;
  }
  .admin-overview {
    margin-top: 18px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
    font-size: 0.86rem;
    color: var(--ink-3);
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
  }
  .admin-overview b {
    color: var(--ink-2);
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }
  /* 登录：居中的站长通道，bloub 负责迎接 */
  .admin-login {
    max-width: 460px;
    margin: 56px auto 0;
    text-align: center;
  }
  .login-mascot {
    display: block;
    width: 88px;
    height: 88px;
    margin: 0 auto 20px;
  }
  .login-title {
    font-family: var(--font-display-cn);
    font-weight: 400;
    font-size: 1.5rem;
  }
  .login-sub {
    margin-top: 10px;
    font-size: 0.94rem;
    color: var(--ink-2);
    line-height: 1.9;
  }
  .admin-login ol {
    text-align: left;
    margin: 18px 0 24px;
    padding-left: 1.4em;
    color: var(--ink-3);
    font-size: 0.88rem;
    line-height: 2.1;
  }
  .admin-login a {
    color: var(--accent-ink);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
    text-underline-offset: 4px;
  }
  .login-row {
    display: flex;
    gap: 10px;
  }
  .login-row input {
    flex: 1;
  }
  /* 页签：与站内胶囊筛选一致的分段样式 */
  .admin-tabs {
    display: flex;
    gap: 4px;
    margin: 34px 0 26px;
    padding: 4px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 999px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .admin-tabs::-webkit-scrollbar {
    display: none;
  }
  .admin-tab {
    flex-shrink: 0;
    padding: 7px 20px;
    border: none;
    background: none;
    font-family: inherit;
    font-size: 0.92rem;
    color: var(--ink-2);
    cursor: pointer;
    border-radius: 999px;
    transition: color 0.2s ease, background 0.2s ease;
  }
  .admin-tab.active {
    background: var(--surface);
    color: var(--ink);
    font-weight: 650;
    box-shadow: 0 1px 5px rgba(22, 22, 45, 0.1);
  }
  .admin-tab:hover:not(.active) {
    color: var(--ink);
  }
  .admin-panel textarea,
  .admin-panel input,
  .admin-panel select {
    width: 100%;
    margin-top: 6px;
    padding: 10px 14px;
    font-family: inherit;
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .admin-panel textarea:focus,
  .admin-panel input:focus,
  .admin-panel select:focus {
    outline: 2px solid var(--accent);
    outline-offset: 0;
    border-color: transparent;
  }
  .field {
    display: block;
    margin-top: 14px;
    font-size: 0.85rem;
    color: var(--ink-2);
  }
  .field-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  @media (max-width: 560px) {
    .field-grid {
      grid-template-columns: 1fr;
    }
  }
  .row-end {
    display: flex;
    justify-content: flex-end;
    margin-top: 12px;
  }
  :global(.admin-btn) {
    padding: 8px 20px;
    font-family: inherit;
    font-size: 0.92rem;
    font-weight: 550;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    cursor: pointer;
    transition: transform 0.15s ease, border-color 0.2s ease, color 0.2s ease;
  }
  :global(.admin-btn.primary) {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  :global(.admin-btn:hover) {
    transform: translateY(-1px);
    border-color: var(--accent);
  }
  :global(.admin-btn:active) {
    transform: scale(0.97);
  }
  :global(.admin-btn.ghost) {
    padding: 4px 12px;
    font-size: 0.82rem;
  }
  :global(.admin-btn.danger) {
    color: #b4766b;
    border-color: #b4766b;
    background: color-mix(in srgb, #b4766b 10%, var(--surface));
  }
  .admin-panel h3 {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 34px;
    font-family: var(--font-display-cn);
    font-weight: 400;
    font-size: 1.1rem;
  }
  .sec-count {
    font-family: var(--font-sans);
    font-style: normal;
    font-size: 0.76rem;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .sec-count:empty {
    display: none;
  }
  .hint {
    margin-top: 8px;
    font-size: 0.88rem;
    color: var(--ink-3);
    line-height: 1.9;
  }
  .hint code {
    font-family: var(--font-mono);
    background: var(--surface-2);
    border-radius: 6px;
    padding: 0.1em 0.4em;
    font-size: 0.9em;
  }
  /* 拖放/选择图片区域 */
  .gallery-drop {
    margin-top: 14px;
    padding: 26px 20px;
    text-align: center;
