---
// 站长管理面板：纯客户端，通过 GitHub API 直接读写仓库（等于把 GitHub 当后端）
// 登录方式：GitHub 个人访问令牌（PAT），只存在站长自己浏览器的 localStorage 里
import Base from '../layouts/Base.astro';
---

<Base title="管理 · 星野漫游" description="站长管理面板。">
  <div class="container admin">
    <header class="admin-head">
      <h1>管理面板</h1>
      <div class="admin-user" hidden>
        <img alt="" width="28" height="28" />
        <b></b>
        <button class="admin-btn ghost" type="button" data-act="logout">退出</button>
      </div>
    </header>

    <!-- 登录 -->
    <section class="admin-login" hidden>
      <p>粘贴你的 GitHub 个人访问令牌（Token）登录。</p>
      <ol>
        <li>打开 <a href="https://github.com/settings/tokens/new?scopes=repo,workflow&description=starry-roam-admin" target="_blank" rel="noopener">github.com/settings/tokens/new</a>（已预选 repo + workflow 权限）</li>
        <li>拉到底部 Generate token，复制生成的一串字符</li>
        <li>粘贴到下面并登录</li>
      </ol>
      <div class="login-row">
        <input type="password" placeholder="ghp_…" autocomplete="off" spellcheck="false" />
        <button class="admin-btn primary" type="button" data-act="login">登录</button>
      </div>
      <p class="admin-msg" role="status"></p>
    </section>

    <!-- 主体 -->
    <section class="admin-body" hidden>
      <nav class="admin-tabs" role="tablist">
        <button class="admin-tab active" type="button" data-tab="moment" role="tab">废话条</button>
        <button class="admin-tab" type="button" data-tab="post" role="tab">文章</button>
        <button class="admin-tab" type="button" data-tab="kb" role="tab">知识库</button>
        <button class="admin-tab" type="button" data-tab="site" role="tab">站点</button>
        <button class="admin-tab" type="button" data-tab="ai" role="tab">AI 助手</button>
      </nav>

      <!-- 废话条 -->
      <div class="admin-panel" data-panel="moment">
        <textarea rows="3" placeholder="这一刻的想法…" maxlength="300"></textarea>
        <div class="row-end">
          <button class="admin-btn primary" type="button" data-act="publish-moment">发布</button>
        </div>
        <h3>已发布的动态</h3>
        <ul class="admin-list" data-list="moments"></ul>
      </div>

      <!-- 文章 -->
      <div class="admin-panel" data-panel="post" hidden>
        <div class="edit-banner" data-edit-banner="post" hidden>
          正在编辑 <b data-edit-name></b><span class="edit-note">保存后保留原发布日期</span>
          <button class="admin-btn ghost" type="button" data-act="cancel-edit-post">取消编辑</button>
        </div>
        <label class="field">
          <span>标题</span>
          <input type="text" data-post="title" placeholder="文章标题" />
        </label>
        <div class="field-grid">
          <label class="field">
            <span>文件名（英文）</span>
            <input type="text" data-post="slug" placeholder="my-first-post" />
          </label>
          <label class="field">
            <span>标签（逗号分隔）</span>
            <input type="text" data-post="tags" placeholder="随感, 记录" />
          </label>
        </div>
        <label class="field">
          <span>状态</span>
          <select data-post="status">
            <option value="public">公开</option>
            <option value="draft">草稿（不上站）</option>
            <option value="archived">归档（列表隐藏，直链可见）</option>
          </select>
        </label>
        <label class="field">
          <span>摘要</span>
          <input type="text" data-post="desc" placeholder="一句话摘要（可空）" />
        </label>
        <label class="field">
          <span>正文（Markdown）</span>
          <textarea rows="10" data-post="body" placeholder="# 用 Markdown 写…"></textarea>
        </label>
        <div class="row-end">
          <button class="admin-btn primary" type="button" data-act="publish-post">发布文章</button>
        </div>
        <h3>已有文章</h3>
        <ul class="admin-list" data-list="posts"></ul>
      </div>

      <!-- 知识库 -->
      <div class="admin-panel" data-panel="kb" hidden>
        <div class="kb-modes">
          <label class="kb-mode"><input type="radio" name="kb-mode" value="note" checked /> 写笔记 / 技巧</label>
          <label class="kb-mode"><input type="radio" name="kb-mode" value="file" /> 上传文档</label>
        </div>

        <!-- 写条目 -->
        <div class="kb-form" data-kb-form="note">
          <div class="edit-banner" data-edit-banner="kb" hidden>
            正在编辑 <b data-edit-name></b><span class="edit-note">保存后保留原日期</span>
            <button class="admin-btn ghost" type="button" data-act="cancel-edit-kb">取消编辑</button>
          </div>
          <label class="field">
            <span>标题</span>
            <input type="text" data-kb-note="title" placeholder="如：圆锥曲线常用小结论" />
          </label>
          <div class="field-grid">
            <label class="field">
              <span>科目 / 主题</span>
              <input type="text" data-kb-note="subject" list="kb-subjects" placeholder="数学" />
              <datalist id="kb-subjects">
                <option value="数学"></option>
                <option value="英语"></option>
                <option value="语文"></option>
                <option value="物理"></option>
                <option value="化学"></option>
                <option value="生物"></option>
                <option value="信息技术"></option>
                <option value="方法论"></option>
                <option value="资料"></option>
              </datalist>
            </label>
            <label class="field">
              <span>标签（逗号分隔）</span>
              <input type="text" data-kb-note="tags" placeholder="解析几何, 小结论" />
            </label>
          </div>
          <label class="field">
            <span>状态</span>
            <select data-kb-note="status">
              <option value="public">公开</option>
              <option value="draft">草稿（不上站）</option>
              <option value="archived">归档（列表隐藏，直链可见）</option>
            </select>
          </label>
          <label class="field">
            <span>一句话说明</span>
            <input type="text" data-kb-note="desc" placeholder="列表页显示的摘要（可空）" />
          </label>
          <label class="field">
            <span>正文（Markdown，支持 $行内$ 与 $$公式块$$）</span>
            <textarea rows="8" data-kb-note="body" placeholder="## 结论&#10;椭圆焦点弦最短为 $2b^2/a$…"></textarea>
          </label>
          <div class="row-end">
            <button class="admin-btn primary" type="button" data-act="publish-kb-note">发布条目</button>
          </div>
        </div>

        <!-- 传文档 -->
        <div class="kb-form" data-kb-form="file" hidden>
          <label class="field">
            <span>选择文件（PDF / Word / PPT / Markdown 等）</span>
            <input type="file" data-kb-file />
          </label>
          <label class="field">
            <span>标题（不填就用文件名）</span>
            <input type="text" data-kb-file="title" placeholder="函数专题讲义" />
          </label>
          <div class="field-grid">
            <label class="field">
              <span>科目 / 主题</span>
              <input type="text" data-kb-file="subject" list="kb-subjects" placeholder="数学" />
            </label>
            <label class="field">
              <span>标签（逗号分隔）</span>
              <input type="text" data-kb-file="tags" placeholder="函数, 讲义" />
            </label>
          </div>
          <label class="field">
            <span>一句话说明</span>
            <input type="text" data-kb-file="desc" placeholder="这份资料讲了什么（可空）" />
          </label>
          <div class="row-end">
            <button class="admin-btn primary" type="button" data-act="upload-kb-file">上传并发布</button>
          </div>
          <p class="hint">上传的文件会存进仓库 public/kb/，随站点一起发布；PDF 在详情页可直接预览。</p>
        </div>

        <h3>已有条目</h3>
        <ul class="admin-list" data-list="kb"></ul>
      </div>

      <!-- 站点 -->
      <div class="admin-panel" data-panel="site" hidden>
        <h3>构建</h3>
        <p class="hint">发布内容后一般会自动构建；发完废话条或想立刻刷新站点时手动点一次。</p>
        <button class="admin-btn" type="button" data-act="rebuild">触发重新构建</button>

        <h3>评论（giscus · GitHub 登录评论）</h3>
        <p class="hint">开启前提（各做一次）：仓库 Settings → Features 勾选 Discussions；安装 <a href="https://github.com/apps/giscus" target="_blank" rel="noopener">giscus App</a>。都完成后点下面按钮，自动写入配置，1-2 分钟后文章页出现评论区。</p>
        <button class="admin-btn" type="button" data-act="setup-giscus">一键配置评论</button>

        <h3>音乐</h3>
        <p class="hint">在「站点」之外操作：把 mp3 放进仓库 <code>public/music/</code>，再改 <code>src/components/MusicPlayer.astro</code> 顶部的曲目列表。</p>
      </div>

      <!-- AI 助手 -->
      <div class="admin-panel" data-panel="ai" hidden>
        <h3>接口配置</h3>
        <p class="hint">任何 OpenAI 兼容接口都能接（Agnes / DeepSeek / …），换服务商 = 换三个配置项。API Key 只保存在本浏览器 localStorage（和登录令牌同级），不会写入网站仓库。</p>
        <label class="field">
          <span>服务商预设</span>
          <select data-ai="preset"></select>
        </label>
        <p class="hint" data-ai="preset-note"></p>
        <div class="field-grid">
          <label class="field">
            <span>Base URL</span>
            <input type="text" data-ai="baseUrl" placeholder="https://api.agnes-ai.cn/v1" spellcheck="false" />
          </label>
          <label class="field">
            <span>模型</span>
            <input type="text" data-ai="model" placeholder="agnes-2.5-flash" spellcheck="false" />
          </label>
        </div>
        <label class="field">
          <span>API Key</span>
          <input type="password" data-ai="apiKey" placeholder="sk-…" autocomplete="off" spellcheck="false" />
        </label>
        <div class="row-end">
          <button class="admin-btn" type="button" data-act="ai-test">测试连接</button>
          <button class="admin-btn primary" type="button" data-act="ai-save">保存配置</button>
        </div>
        <p class="hint" data-ai="status" role="status"></p>

        <h3>资料问答</h3>
        <p class="hint">AI 会先从全站索引（构建时生成的 <code>/api-index.json</code>）里检索最相关的几条内容，再据此回答；新发布的内容要等构建完成后才能被检索到。</p>
        <div class="ai-chat" data-ai-chat hidden></div>
        <div class="ai-quick">
          <button class="admin-btn ghost" type="button" data-ai-q="用几句话总结一下我的网站上都有哪些内容">总结站上内容</button>
          <button class="admin-btn ghost" type="button" data-ai-q="帮我把下面这句话润色成一条废话条，保持原意、语言更有味道，只输出润色后的一句话：">润色废话条</button>
        </div>
        <div class="login-row">
          <input type="text" data-ai="input" placeholder="问点什么…（Enter 发送）" />
          <button class="admin-btn primary" type="button" data-act="ai-send">发送</button>
        </div>
      </div>

      <p class="admin-msg" role="status"></p>
    </section>
  </div>
</Base>

<style>
  .admin {
    padding-top: 48px;
    padding-bottom: 96px;
  }
  .admin-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .admin-head h1 {
    font-family: var(--font-display-cn);
    font-weight: 400;
    font-size: 1.7rem;
  }
  .admin-user {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.92rem;
  }
  .admin-user img {
    border-radius: 50%;
  }
  .admin-login ol {
    margin: 10px 0 18px;
    padding-left: 1.4em;
    color: var(--ink-2);
    font-size: 0.94rem;
    line-height: 2;
  }
  .login-row {
    display: flex;
    gap: 10px;
  }
  .login-row input {
    flex: 1;
  }
  .admin-tabs {
    display: flex;
    gap: 6px;
    margin: 26px 0 18px;
    border-bottom: 1px solid var(--line);
  }
  .admin-tab {
    padding: 8px 18px;
    border: none;
    background: none;
    font-family: inherit;
    font-size: 0.95rem;
    color: var(--ink-2);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  .admin-tab.active {
    color: var(--ink);
    font-weight: 650;
    border-bottom-color: var(--accent);
  }
  .admin-panel textarea,
  .admin-panel input,
  .admin-panel select {
    width: 100%;
    margin-top: 6px;
    padding: 10px 14px;
    font-family: inherit;
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .admin-panel textarea:focus,
  .admin-panel input:focus,
  .admin-panel select:focus {
    outline: 2px solid var(--accent);
    outline-offset: 0;
    border-color: transparent;
  }
  .field {
    display: block;
    margin-top: 14px;
    font-size: 0.85rem;
    color: var(--ink-2);
  }
  .field-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  @media (max-width: 560px) {
    .field-grid {
      grid-template-columns: 1fr;
    }
  }
  .row-end {
    display: flex;
    justify-content: flex-end;
    margin-top: 12px;
  }
  .admin-btn {
    padding: 8px 20px;
    font-family: inherit;
    font-size: 0.92rem;
    font-weight: 550;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    cursor: pointer;
    transition: transform 0.15s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .admin-btn.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .admin-btn:hover {
    transform: translateY(-1px);
    border-color: var(--accent);
  }
  .admin-btn:active {
    transform: scale(0.97);
  }
  .admin-btn.ghost {
    padding: 4px 12px;
    font-size: 0.82rem;
  }
  .admin-btn.danger {
    color: #b4766b;
    border-color: #b4766b;
    background: color-mix(in srgb, #b4766b 10%, var(--surface));
  }
  .admin-panel h3 {
    margin-top: 30px;
    font-family: var(--font-display-cn);
    font-weight: 400;
    font-size: 1.1rem;
  }
  .hint {
    margin-top: 8px;
    font-size: 0.88rem;
    color: var(--ink-3);
    line-height: 1.9;
  }
  .hint code {
    font-family: var(--font-mono);
    background: var(--surface-2);
    border-radius: 6px;
    padding: 0.1em 0.4em;
    font-size: 0.9em;
  }
  .admin-list {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
  }
  .admin-list li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 4px;
    border-bottom: 1px solid var(--line);
    font-size: 0.92rem;
  }
  .admin-list .name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .admin-list .meta {
    flex-shrink: 0;
    font-size: 0.78rem;
    color: var(--ink-3);
  }
  .admin-msg {
    margin-top: 16px;
    font-size: 0.88rem;
    color: var(--accent-ink);
    min-height: 1.4em;
  }
  .kb-modes {
    display: flex;
    gap: 18px;
    margin-bottom: 6px;
    font-size: 0.92rem;
  }
  .kb-mode {
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
  }
  .kb-mode input {
    margin: 0;
  }
  .edit-banner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 10px;
    margin-bottom: 14px;
    padding: 10px 14px;
    font-size: 0.88rem;
    color: var(--ink-2);
    background: var(--wash);
    border-radius: 8px;
  }
  .edit-banner b {
    color: var(--accent-ink);
  }
  .edit-banner .edit-note {
    font-size: 0.78rem;
    color: var(--ink-3);
  }
  .edit-banner .admin-btn {
    margin-left: auto;
  }
  .ai-chat {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-height: 420px;
    overflow-y: auto;
    margin-top: 10px;
    padding: 4px;
  }
  .ai-msg {
    max-width: 92%;
    padding: 10px 14px;
    border-radius: 10px;
    font-size: 0.92rem;
    line-height: 1.8;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .ai-msg.user {
    align-self: flex-end;
    background: var(--accent);
    color: #fff;
  }
  .ai-msg.bot {
    align-self: flex-start;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .ai-msg.bot.thinking {
    color: var(--ink-3);
  }
  .ai-src {
    margin-top: 8px;
    padding-top: 6px;
    border-top: 1px dashed var(--line);
    font-size: 0.78rem;
    color: var(--ink-3);
  }
  .ai-src a {
    color: var(--accent-ink);
  }
  .ai-quick {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }
</style>

<script>
  // ============ 管理面板：GitHub API 即后端 ============
  import { u } from '../lib/base';
  import {
    AI_PRESETS,
    loadAiConfig,
    saveAiConfig,
    aiChat,
    aiTestConnection,
    searchIndex,
    buildContextBlock,
    type AiConfig,
    type AiIndexEntry,
    type AiMessage,
  } from '../lib/ai';

  const REPO = 'Starryeeeeee/starry';
  const BRANCH = 'main';
  const TOKEN_KEY = 'sr-admin-token';

  const api = async (path: string, init: RequestInit = {}) => {
    const token = localStorage.getItem(TOKEN_KEY) ?? '';
    const r = await fetch(`https://api.github.com${path}`, {
      ...init,
      headers: {
        Authorization: `Bearer ${token}`,
        Accept: 'application/vnd.github+json',
        'X-GitHub-Api-Version': '2022-11-28',
        ...(init.body ? { 'Content-Type': 'application/json' } : {}),
        ...init.headers,
      },
    });
    if (!r.ok) {
      const body = await r.json().catch(() => ({}));
      throw new Error(`${r.status} ${body.message ?? r.statusText}`);
    }
    return r.status === 204 ? null : r.json();
  };

  const b64 = (s: string) => btoa(String.fromCharCode(...new TextEncoder().encode(s)));

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const msg = (m: string) => {
    // 页面里有两个提示位（登录区一个、面板底部一个），全都要更新——
    // 只更新第一个的话，登录后第一个正好是隐藏的，所有反馈都会"消失"
    for (const el of document.querySelectorAll('.admin-msg')) el.textContent = m;
    console.log('[admin]', m);
  };

  const dispatchBuild = () =>
    api(`/repos/${REPO}/actions/workflows/deploy.yml/dispatches`, {
      method: 'POST',
      body: JSON.stringify({ ref: BRANCH }),
    });

  // ---------- 删除确认：两段式自绘按钮（替代浏览器原生 confirm） ----------
  // 第一次点 → 按钮变红显示「确认删除？」，4 秒内再点才真删，超时自动还原
  function armDelete(btn: HTMLButtonElement, run: () => Promise<void>) {
    if (btn.dataset.armed) {
      btn.disabled = true;
      try {
        void run();
      } catch (e) {
        msg('删除失败：' + (e as Error).message);
      }
      return;
    }
    btn.dataset.armed = '1';
    btn.dataset.original = btn.textContent ?? '';
    btn.textContent = '确认删除？';
    btn.classList.add('danger');
    window.setTimeout(() => disarmDelete(btn), 4000);
  }

  function disarmDelete(btn: HTMLButtonElement) {
    btn.dataset.armed = '';
    btn.classList.remove('danger');
    btn.disabled = false;
    if (btn.dataset.original) btn.textContent = btn.dataset.original;
  }

  // ---------- 登录态 ----------
  async function showLogin(loggedIn: { login: string; avatar_url: string } | null) {
    $('.admin-login').hidden = !!loggedIn;
    $('.admin-body').hidden = !loggedIn;
    $('.admin-user').hidden = !loggedIn;
    if (loggedIn) {
      const img = $('.admin-user img');
      img.src = loggedIn.avatar_url;
      $('.admin-user b').textContent = loggedIn.login;
    }
  }

  async function verify() {
    const token = localStorage.getItem(TOKEN_KEY);
    if (!token) return showLogin(null);
    try {
      const me = await api('/user');
      await showLogin(me);
      await refreshMoments();
      await refreshPosts();
      await refreshKb().catch((e) => console.warn('[admin] 知识库列表加载失败', e));
    } catch {
      localStorage.removeItem(TOKEN_KEY);
      await showLogin(null);
      msg('令牌无效或已过期，请重新登录');
    }
  }

  // ---------- 编辑模式状态 ----------
  // metaId = 内容已有的稳定 ID（没有则保存时生成）；status = 原状态
  let editingPost: {
    name: string;
    sha: string;
    date: string;
    metaId?: string;
    metaStatus?: string;
  } | null = null;
  let editingKbNote: {
    name: string;
    sha: string;
    date: string;
    metaId?: string;
    metaStatus?: string;
  } | null = null;

  // 稳定内容 ID：c-日期-随机码，创建后永不变（改名/迁移靠它保住评论和点赞）
  const newCid = (date: string) =>
    `c-${date.replace(/-/g, '')}-${Math.random().toString(36).slice(2, 6)}`;

  // frontmatter 简易解析：够用即可（写入方是我们自己）
  function parseFrontmatter(raw: string): {
    meta: Record<string, string | string[]>;
    body: string;
  } {
    const m = raw.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/);
    if (!m) return { meta: {}, body: raw };
    const meta: Record<string, string | string[]> = {};
    for (const line of m[1].split(/\r?\n/)) {
      const i = line.indexOf(':');
      if (i === -1) continue;
      const k = line.slice(0, i).trim();
      let v: string | string[] = line.slice(i + 1).trim();
      if (v.startsWith('[') && v.endsWith(']')) {
        v = v
          .slice(1, -1)
          .split(',')
          .map((s) => s.trim().replace(/^["']|["']$/g, ''))
          .filter(Boolean);
      } else {
        v = v.replace(/^["']|["']$/g, '');
      }
      if (k) meta[k] = v;
    }
    return { meta, body: m[2] };
  }

  function setBanner(kind: 'post' | 'kb', name: string | null) {
    const banner = $(`[data-edit-banner="${kind}"]`) as HTMLElement;
    banner.hidden = !name;
    if (name) (banner.querySelector('[data-edit-name]') as HTMLElement).textContent = name;
  }

  function activateTab(name: string) {
    document.querySelectorAll('.admin-tab').forEach((el) => el.classList.remove('active'));
    document
      .querySelector<HTMLButtonElement>(`.admin-tab[data-tab="${name}"]`)
      ?.classList.add('active');
    document.querySelectorAll('.admin-panel').forEach((p) => {
      (p as HTMLElement).hidden = p.getAttribute('data-panel') !== name;
    });
  }

  async function startEditPost(f: { name: string }) {
    const r = await api(
      `/repos/${REPO}/contents/src/content/posts/${encodeURIComponent(f.name)}?ref=${BRANCH}`,
    );
    const { meta, body } = parseFrontmatter(b64ToText(r.content.replace(/\s/g, '')));
    editingPost = {
      name: f.name,
      sha: r.sha,
      date: String(meta.date ?? todayStr()),
      metaId: typeof meta.id === 'string' ? meta.id : undefined,
      metaStatus: typeof meta.status === 'string' ? meta.status : 'public',
    };
    ($('[data-post="title"]') as HTMLInputElement).value = String(meta.title ?? '');
    ($('[data-post="slug"]') as HTMLInputElement).value = f.name.replace(/\.md$/, '');
    ($('[data-post="slug"]') as HTMLInputElement).disabled = true; // 编辑模式不改文件名
    ($('[data-post="tags"]') as HTMLInputElement).value = Array.isArray(meta.tags)
      ? meta.tags.join(', ')
      : '';
    ($('[data-post="desc"]') as HTMLInputElement).value = String(meta.description ?? '');
    ($('[data-post="status"]') as HTMLSelectElement).value =
      editingPost.metaStatus === 'draft' || editingPost.metaStatus === 'archived'
        ? editingPost.metaStatus
        : 'public';
    ($('[data-post="body"]') as HTMLTextAreaElement).value = body;
    ($('[data-act="publish-post"]') as HTMLElement).textContent = '保存修改';
    setBanner('post', f.name);
    activateTab('post');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function exitPostEdit(clearForm: boolean) {
    editingPost = null;
    ($('[data-post="slug"]') as HTMLInputElement).disabled = false;
    ($('[data-act="publish-post"]') as HTMLElement).textContent = '发布文章';
    setBanner('post', null);
    if (clearForm)
      ['title', 'slug', 'tags', 'desc', 'body'].forEach(
        (k) => (($(`[data-post="${k}"]`) as HTMLInputElement).value = ''),
      );
  }

  async function startEditKbNote(f: { name: string }) {
    const r = await api(
      `/repos/${REPO}/contents/${KB_NOTE_DIR}/${encodeURIComponent(f.name)}?ref=${BRANCH}`,
    );
    const { meta, body } = parseFrontmatter(b64ToText(r.content.replace(/\s/g, '')));
    editingKbNote = {
      name: f.name,
      sha: r.sha,
      date: String(meta.date ?? todayStr()),
      metaId: typeof meta.id === 'string' ? meta.id : undefined,
      metaStatus: typeof meta.status === 'string' ? meta.status : 'public',
    };
    ($('[data-kb-note="title"]') as HTMLInputElement).value = String(meta.title ?? '');
    ($('[data-kb-note="subject"]') as HTMLInputElement).value = String(meta.subject ?? '');
    ($('[data-kb-note="tags"]') as HTMLInputElement).value = Array.isArray(meta.tags)
      ? meta.tags.join(', ')
      : '';
    ($('[data-kb-note="desc"]') as HTMLInputElement).value = String(meta.description ?? '');
    ($('[data-kb-note="status"]') as HTMLSelectElement).value =
      editingKbNote.metaStatus === 'draft' || editingKbNote.metaStatus === 'archived'
        ? editingKbNote.metaStatus
        : 'public';
    ($('[data-kb-note="body"]') as HTMLTextAreaElement).value = body;
    ($('[data-act="publish-kb-note"]') as HTMLElement).textContent = '保存修改';
    setBanner('kb', f.name);
    // 确保处于「写笔记」模式
    const radio = document.querySelector<HTMLInputElement>('input[name="kb-mode"][value="note"]');
    if (radio) {
      radio.checked = true;
      radio.dispatchEvent(new Event('change'));
    }
    activateTab('kb');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function exitKbEdit(clearForm: boolean) {
    editingKbNote = null;
    ($('[data-act="publish-kb-note"]') as HTMLElement).textContent = '发布条目';
    setBanner('kb', null);
    if (clearForm)
      ['title', 'tags', 'desc', 'body'].forEach(
        (k) => (($(`[data-kb-note="${k}"]`) as HTMLInputElement).value = ''),
      );
  }

  // ---------- 废话条（Issues） ----------
  async function refreshMoments() {
    const list = $('[data-list="moments"]');
    list.innerHTML = '<li class="meta">加载中…</li>';
    const issues = await api(`/repos/${REPO}/issues?labels=moment&state=open&per_page=30`);
    list.innerHTML = '';
    if (!issues.length) {
      list.innerHTML = '<li class="meta">还没有动态</li>';
      return;
    }
    for (const it of issues) {
      const li = document.createElement('li');
      li.innerHTML = `<span class="name"></span><span class="meta">${it.created_at.slice(0, 10)}</span>`;
      (li.querySelector('.name') as HTMLElement).textContent = it.title;
      const del = document.createElement('button');
      del.className = 'admin-btn ghost';
      del.type = 'button';
      del.textContent = '删除';
      del.onclick = () => {
        armDelete(del, async () => {
          await api(`/repos/${REPO}/issues/${it.number}`, {
            method: 'PATCH',
            body: JSON.stringify({ state: 'closed' }),
          });
          await dispatchBuild();
          msg('已删除，站点构建中（1-2 分钟生效）');
          await refreshMoments();
        });
      };
      li.appendChild(del);
      list.appendChild(li);
    }
  }

  // ---------- 文章（contents API） ----------
  async function refreshPosts() {
    const list = $('[data-list="posts"]');
    list.innerHTML = '<li class="meta">加载中…</li>';
    const files = await api(`/repos/${REPO}/contents/src/content/posts?ref=${BRANCH}`);
    list.innerHTML = '';
    if (!files.length) {
      list.innerHTML = '<li class="meta">还没有文章</li>';
      return;
    }
    for (const f of files) {
      const li = document.createElement('li');
      const name = document.createElement('span');
      name.className = 'name';
      name.textContent = f.name;
      const edit = document.createElement('button');
      edit.className = 'admin-btn ghost';
      edit.type = 'button';
      edit.textContent = '编辑';
      edit.onclick = () => {
        startEditPost(f).catch((e) => msg('打开编辑失败：' + (e as Error).message));
      };
      const del = document.createElement('button');
      del.className = 'admin-btn ghost';
      del.type = 'button';
      del.textContent = '删除';
      del.onclick = () => {
        armDelete(del, async () => {
          await api(`/repos/${REPO}/contents/src/content/posts/${f.name}`, {
            method: 'DELETE',
            body: JSON.stringify({ message: `删文章 ${f.name}`, sha: f.sha, branch: BRANCH }),
          });
          msg('已删除，构建中…（push 自动触发）');
          await refreshPosts();
        });
      };
      li.append(name, edit, del);
      list.appendChild(li);
    }
  }

  // ---------- 知识库（笔记 = contents API；文档 = public/kb + 清单 JSON） ----------
  const KB_NOTE_DIR = 'src/content/kb';
  const KB_FILE_DIR = 'public/kb';
  const KB_JSON_PATH = 'src/data/kb-files.json';

  const todayStr = () => new Date().toISOString().slice(0, 10);

  // base64 → UTF-8 文本（清单里有中文，直接 atob 会乱码）
  const b64ToText = (b64: string) =>
    new TextDecoder().decode(Uint8Array.from(atob(b64), (c) => c.charCodeAt(0)));

  const getKbJson = async (): Promise<{ sha: string | null; list: any[] }> => {
    try {
      const r = await api(`/repos/${REPO}/contents/${KB_JSON_PATH}?ref=${BRANCH}`);
      return { sha: r.sha, list: JSON.parse(b64ToText(r.content.replace(/\s/g, ''))) };
    } catch (e) {
      if (String((e as Error).message).startsWith('404')) return { sha: null, list: [] };
      throw e;
    }
  };

  const putKbJson = (list: any[], sha: string | null, message: string) =>
    api(`/repos/${REPO}/contents/${KB_JSON_PATH}`, {
      method: 'PUT',
      body: JSON.stringify({
        message,
        branch: BRANCH,
        content: b64(JSON.stringify(list, null, 2) + '\n'),
        ...(sha ? { sha } : {}),
      }),
    });

  const safeName = (n: string) =>
    n.replace(/^.*[/\\]/, '').replace(/[#?%*"<>|]/g, '').replace(/\s+/g, '-').slice(-80) || 'file';

  const titleToFileName = (t: string) =>
    t.replace(/[#?%*"<>|:/\\]/g, '').replace(/\s+/g, '-').slice(0, 60) ||
    `kb-${Date.now().toString(36)}`;

  async function refreshKb() {
    const list = $('[data-list="kb"]');
    list.innerHTML = '<li class="meta">加载中…</li>';
    const [notes, kbJson] = await Promise.all([
      api(`/repos/${REPO}/contents/${KB_NOTE_DIR}?ref=${BRANCH}`).catch(() => []),
      getKbJson().catch(() => ({ list: [] })),
    ]);
    const files: any[] = kbJson.list ?? [];
    list.innerHTML = '';
    if (!notes.length && !files.length) {
      list.innerHTML = '<li class="meta">还没有条目——先写一条笔记或传一份文档</li>';
      return;
    }
    for (const f of notes) {
      const li = document.createElement('li');
      li.innerHTML = `<span class="name"></span><span class="meta">笔记</span>`;
      (li.querySelector('.name') as HTMLElement).textContent = f.name;
      const edit = document.createElement('button');
      edit.className = 'admin-btn ghost';
      edit.type = 'button';
      edit.textContent = '编辑';
      edit.onclick = () => {
        startEditKbNote(f).catch((e) => msg('打开编辑失败：' + (e as Error).message));
      };
      li.appendChild(edit);
      li.appendChild(makeKbDeleteBtn(async () => {
        await api(`/repos/${REPO}/contents/${KB_NOTE_DIR}/${encodeURIComponent(f.name)}`, {
          method: 'DELETE',
          body: JSON.stringify({ message: `删知识库条目 ${f.name}`, sha: f.sha, branch: BRANCH }),
        });
      }, li));
      list.appendChild(li);
    }
    for (const rec of files) {
      const li = document.createElement('li');
      li.innerHTML = `<span class="name"></span><span class="meta"></span>`;
      (li.querySelector('.name') as HTMLElement).textContent =
        `${rec.title}（${(rec.ext ?? '').toUpperCase()}，${Math.max(1, Math.round((rec.size ?? 0) / 1024))} KB）`;
      li.querySelector('.meta')!.textContent = rec.date ?? '';
      li.appendChild(makeKbDeleteBtn(async () => {
        // 先删文件本体（不存在也不报错跳过），再把记录从清单里拿掉
        try {
          const meta = await api(`/repos/${REPO}/contents/${encodeURIComponent(KB_FILE_DIR)}/${encodeURIComponent(rec.file.split('/').pop() ?? '')}?ref=${BRANCH}`);
          await api(`/repos/${REPO}/contents/${KB_FILE_DIR}/${encodeURIComponent(rec.file.split('/').pop() ?? '')}`, {
            method: 'DELETE',
            body: JSON.stringify({ message: `删知识库文件 ${rec.file}`, sha: meta.sha, branch: BRANCH }),
          });
        } catch { /* 文件本体可能已不在，继续清清单 */ }
        const { sha, list: cur } = await getKbJson();
        await putKbJson(cur.filter((x: any) => x.slug !== rec.slug), sha, '更新知识库清单');
      }, li));
      list.appendChild(li);
    }
  }

  function makeKbDeleteBtn(fn: () => Promise<void>, li: HTMLLIElement) {
    const del = document.createElement('button');
    del.className = 'admin-btn ghost';
    del.type = 'button';
    del.textContent = '删除';
    del.onclick = () => {
      armDelete(del, async () => {
        await fn();
        await dispatchBuild();
        msg('已删除，站点构建中（1-2 分钟生效）');
        await refreshKb();
      });
    };
    return del;
  }

  // ---------- 事件绑定 ----------
  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const act = t.closest('[data-act]')?.getAttribute('data-act');
    if (!act) return;
    try {
      if (act === 'login') {
        const input = $('.login-row input') as HTMLInputElement;
        if (!input.value.trim()) return msg('先粘贴令牌');
        localStorage.setItem(TOKEN_KEY, input.value.trim());
        input.value = '';
        await verify();
        msg('登录成功');
      }
      if (act === 'logout') {
        localStorage.removeItem(TOKEN_KEY);
        await showLogin(null);
      }
      if (act === 'publish-moment') {
        const ta = $('[data-panel="moment"] textarea') as HTMLTextAreaElement;
        const text = ta.value.trim();
        if (!text) return msg('写点什么再发');
        t.setAttribute('disabled', '');
        await api(`/repos/${REPO}/issues`, {
          method: 'POST',
          body: JSON.stringify({ title: text, labels: ['moment'] }),
        });
        await dispatchBuild();
        ta.value = '';
        msg('已发布，站点构建中（1-2 分钟上站）');
        await refreshMoments();
        t.removeAttribute('disabled');
      }
      if (act === 'publish-post') {
        const g = (k: string) => ($(`[data-post="${k}"]`) as HTMLInputElement).value.trim();
        const title = g('title');
        if (!title) return msg('标题必填');
        const isEdit = !!editingPost;
        let slug: string;
        if (isEdit) {
          slug = editingPost!.name.replace(/\.md$/, '');
        } else {
          slug = g('slug');
          if (!slug) {
            slug =
              /^[a-z0-9\- ]+$/i.test(title) && title.trim().length >= 3
                ? title.trim().toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '')
                : `post-${Date.now().toString(36)}`;
          }
          if (!/^[a-z0-9-]+$/.test(slug)) return msg('文件名只能用小写英文、数字和连字符');
        }
        // 编辑时保留原发布日期与内容 ID；新建才用今天/生成新 ID
        const date = isEdit ? editingPost!.date : new Date().toISOString().slice(0, 10);
        const cid = isEdit
          ? (editingPost!.metaId ?? newCid(date)) // 旧内容没有 ID：首次编辑时惰性补上
          : newCid(date);
        const status = g('status') || 'public';
        const tags = g('tags')
          ? g('tags')
              .split(/[,，]/)
              .map((s) => s.trim())
              .filter(Boolean)
          : [];
        const fm = [
          '---',
          `id: ${cid}`,
          `title: ${title}`,
          `date: ${date}`,
          g('desc') ? `description: ${g('desc')}` : null,
          tags.length ? `tags: [${tags.join(', ')}]` : null,
          `status: ${status}`,
          '---',
          '',
          '',
        ]
          .filter((l) => l !== null)
          .join('\n');
        t.setAttribute('disabled', '');
        await api(`/repos/${REPO}/contents/src/content/posts/${slug}.md`, {
          method: 'PUT',
          body: JSON.stringify({
            message: isEdit ? `修改文章：${title}` : `发文：${title}`,
            branch: BRANCH,
            content: b64(fm + $('[data-post="body"]').value),
            ...(isEdit ? { sha: editingPost!.sha } : {}),
          }),
        });
        msg(
          isEdit
            ? `《${title}》已保存修改，push 自动构建中（1-2 分钟上站）`
            : `已发布《${title}》，push 自动构建中（1-2 分钟上站）`,
        );
        exitPostEdit(true);
        await refreshPosts();
        t.removeAttribute('disabled');
      }
      if (act === 'publish-kb-note') {
        const g = (k: string) => ($(`[data-kb-note="${k}"]`) as HTMLInputElement).value.trim();
        const title = g('title');
        if (!title) return msg('标题必填');
        const isEdit = !!editingKbNote;
        const tags = g('tags')
          .split(/[,，]/)
          .map((s) => s.trim())
          .filter(Boolean);
        // 编辑时保留原日期、原文件名与内容 ID（没有则惰性补上）；新建才用今天/生成新 ID
        const date = isEdit ? editingKbNote!.date : todayStr();
        const cid = isEdit
          ? (editingKbNote!.metaId ?? newCid(date))
          : newCid(date);
        const status = g('status') || 'public';
        const name = isEdit ? editingKbNote!.name : `${titleToFileName(title)}.md`;
        const fm = [
          '---',
          `id: ${cid}`,
          `title: ${title}`,
          `date: ${date}`,
          g('desc') ? `description: ${g('desc')}` : null,
          `subject: ${g('subject') || '未分类'}`,
          tags.length ? `tags: [${tags.join(', ')}]` : null,
          `status: ${status}`,
          '---',
          '',
          '',
        ]
          .filter((l) => l !== null)
          .join('\n');
        t.setAttribute('disabled', '');
        await api(`/repos/${REPO}/contents/${KB_NOTE_DIR}/${encodeURIComponent(name)}`, {
          method: 'PUT',
          body: JSON.stringify({
            message: isEdit ? `知识库修改：${title}` : `知识库：${title}`,
            branch: BRANCH,
            content: b64(fm + ($('[data-kb-note="body"]') as HTMLTextAreaElement).value),
            ...(isEdit ? { sha: editingKbNote!.sha } : {}),
          }),
        });
        msg(
          isEdit
            ? `《${title}》已保存修改，构建中（1-2 分钟上站）`
            : `已发布《${title}》，构建中（1-2 分钟上站）`,
        );
        exitKbEdit(true);
        await refreshKb();
        t.removeAttribute('disabled');
      }
      if (act === 'upload-kb-file') {
        const input = $('[data-kb-file]') as HTMLInputElement;
        const f = input.files?.[0];
        if (!f) return msg('先选一个文件');
        if (f.size > 40 * 1024 * 1024) return msg('文件超过 40MB，放进 git 仓库会让克隆变慢，建议拆小或换链接');
        const date = todayStr();
        const safe = safeName(f.name);
        const stem = safe.replace(/\.[^.]+$/, '') || 'file';
        const ext = (f.name.match(/\.([^.]+)$/)?.[1] ?? '').toLowerCase();
        const slug = `${date}-${stem}`.slice(0, 100);
        const g = (k: string) => ($(`[data-kb-file="${k}"]`) as HTMLInputElement).value.trim();
        t.setAttribute('disabled', '');
        msg('上传中…（文件较大时会慢一些）');
        const dataUrl = await new Promise<string>((res, rej) => {
          const r = new FileReader();
          r.onload = () => res(r.result as string);
          r.onerror = () => rej(new Error('读取文件失败'));
          r.readAsDataURL(f);
        });
        await api(`/repos/${REPO}/contents/${KB_FILE_DIR}/${encodeURIComponent(safe)}`, {
          method: 'PUT',
          body: JSON.stringify({
            message: `知识库文件：${safe}`,
            branch: BRANCH,
            content: dataUrl.split(',')[1],
          }),
        });
        const { sha, list } = await getKbJson();
        list.unshift({
          slug,
          title: g('title') || stem,
          subject: g('subject') || '未分类',
          tags: g('tags')
            .split(/[,，]/)
            .map((s) => s.trim())
            .filter(Boolean),
          description: g('desc'),
          file: `/kb/${safe}`,
          ext,
          size: f.size,
          date,
        });
        await putKbJson(list, sha, '知识库清单：新增文档条目');
        msg('已上传，构建中（1-2 分钟上站）');
        input.value = '';
        ['title', 'subject', 'tags', 'desc'].forEach(
          (k) => (($(`[data-kb-file="${k}"]`) as HTMLInputElement).value = ''),
        );
        await refreshKb();
        t.removeAttribute('disabled');
      }
      if (act === 'cancel-edit-post') {
        exitPostEdit(true);
        msg('已退出编辑');
      }
      if (act === 'cancel-edit-kb') {
        exitKbEdit(true);
        msg('已退出编辑');
      }
      if (act === 'rebuild') {
        await dispatchBuild();
        msg('已触发构建，1-2 分钟后生效');
      }
      if (act === 'setup-giscus') {
        t.setAttribute('disabled', '');
        const q = await api('/graphql', {
          method: 'POST',
          body: JSON.stringify({
            query: `query{repository(owner:"Starryeeeeee",name:"starry"){id discussionCategories(first:10){nodes{id name}}}}`,
          }),
        });
        const repo = q.data?.repository;
        if (!repo?.discussionCategories) {
          msg('读不到 Discussions：请先在仓库 Settings 勾选 Discussions，并安装 giscus App');
          t.removeAttribute('disabled');
          return;
        }
        const cats = repo.discussionCategories.nodes;
        const cat = cats.find((c: { name: string }) => c.name === 'Announcements') ?? cats[0];
        await api(`/repos/${REPO}/contents/public/site-config.json`, {
          method: 'PUT',
          body: JSON.stringify({
            message: '配置 giscus 评论',
            branch: BRANCH,
            content: b64(
              JSON.stringify(
                { giscus: { repoId: repo.id, categoryId: cat.id, category: cat.name } },
                null,
                2,
              ),
            ),
          }),
        });
        msg(`评论已配置（分类：${cat.name}），构建完成后文章页即可评论`);
        t.removeAttribute('disabled');
      }
    } catch (err) {
      msg('出错了：' + (err as Error).message);
      t.removeAttribute('disabled');
    }
  });

  // ---------- AI 助手（配置 + 资料问答） ----------
  const aiFields = (k: string) => $(`[data-ai="${k}"]`) as HTMLInputElement;
  let aiIndex: AiIndexEntry[] | null = null;
  let aiIndexAt = 0;
  const aiHistory: AiMessage[] = [];

  // 全站索引带 10 分钟缓存，避免每问一次都重新拉
  async function ensureAiIndex(): Promise<AiIndexEntry[]> {
    if (aiIndex && Date.now() - aiIndexAt < 10 * 60 * 1000) return aiIndex;
    const r = await fetch(u('/api-index.json'));
    if (!r.ok) throw new Error('读不到全站索引 /api-index.json（站点还没构建？先触发一次构建）');
    const data = (await r.json()) as { entries: AiIndexEntry[] };
    aiIndex = data.entries ?? [];
    aiIndexAt = Date.now();
    return aiIndex;
  }

  function initAiPanel() {
    const presetSel = aiFields('preset') as unknown as HTMLSelectElement;
    for (const p of AI_PRESETS) {
      const opt = document.createElement('option');
      opt.value = p.key;
      opt.textContent = p.label;
      presetSel.appendChild(opt);
    }
    const applyPreset = () => {
      const p = AI_PRESETS.find((x) => x.key === presetSel.value);
      (aiFields('preset-note') as HTMLElement).textContent = p?.note ?? '';
      if (p && p.key !== 'custom') {
        aiFields('baseUrl').value = p.baseUrl;
        aiFields('model').value = p.model;
      }
    };
    presetSel.addEventListener('change', applyPreset);
    // 已有配置就回填；预设按 baseUrl 反推，对不上就落在自定义
    const saved = loadAiConfig();
    if (saved) {
      const matched = AI_PRESETS.find((p) => p.baseUrl === saved.baseUrl && p.key !== 'custom');
      presetSel.value = matched?.key ?? 'custom';
      aiFields('baseUrl').value = saved.baseUrl;
      aiFields('model').value = saved.model;
      aiFields('apiKey').value = saved.apiKey;
      // 回填后不能再跑 applyPreset（会拿预设默认模型覆盖用户改过的模型名），只补说明文字
      (aiFields('preset-note') as HTMLElement).textContent = matched?.note ?? AI_PRESETS[2].note;
    } else {
      presetSel.value = AI_PRESETS[0].key;
      applyPreset();
    }
  }

  const readAiForm = (): AiConfig | null => {
    const baseUrl = aiFields('baseUrl').value.trim();
    const model = aiFields('model').value.trim();
    const apiKey = aiFields('apiKey').value.trim();
    if (!baseUrl || !model || !apiKey) {
      msg('Base URL、模型、API Key 都要填');
      return null;
    }
    return { baseUrl, model, apiKey };
  };

  function appendAiMsg(kind: 'user' | 'bot', text: string): HTMLElement {
    const box = $('[data-ai-chat]') as HTMLElement;
    box.hidden = false;
    const div = document.createElement('div');
    div.className = `ai-msg ${kind}${kind === 'bot' && !text ? ' thinking' : ''}`;
    div.textContent = text || (kind === 'bot' ? '思考中…' : '');
    box.appendChild(div);
    box.scrollTop = box.scrollHeight;
    return div;
  }

  function appendAiSources(hits: Array<{ entry: AiIndexEntry }>) {
    const named = hits.filter((h) => h.entry.path);
    if (!named.length) return;
    const src = document.createElement('div');
    src.className = 'ai-src';
    src.append('参考：');
    named.forEach(({ entry }, i) => {
      if (i > 0) src.append('、');
      const a = document.createElement('a');
      a.href = u(entry.path!);
      a.target = '_blank';
      a.rel = 'noopener';
      a.textContent = `《${entry.title}》`;
      src.appendChild(a);
    });
    ($('[data-ai-chat]') as HTMLElement).lastElementChild?.appendChild(src);
  }

  async function sendAiQuestion() {
    const cfg = loadAiConfig();
    if (!cfg) {
      msg('先填好上面的接口配置并点「保存配置」');
      return;
    }
    const q = aiFields('input').value.trim();
    if (!q) return;
    aiFields('input').value = '';
    appendAiMsg('user', q);
    const bubble = appendAiMsg('bot', '');
    try {
      const index = await ensureAiIndex();
      const hits = searchIndex(index, q, 5);
      const system =
        '你是个人网站「星野漫游」的站内助手。下面是站长站上内容的检索结果。' +
        '请优先依据这些资料回答；资料里没有的就直说没有，不要编造。' +
        '用简体中文回答，简洁自然。\n\n' +
        (buildContextBlock(hits) || '（本次未检索到相关资料）');
      const reply = await aiChat(cfg, [
        { role: 'system', content: system },
        ...aiHistory.slice(-6),
        { role: 'user', content: q },
      ]);
      aiHistory.push({ role: 'user', content: q }, { role: 'assistant', content: reply });
      while (aiHistory.length > 8) aiHistory.shift();
      bubble.textContent = reply;
      bubble.classList.remove('thinking');
      appendAiSources(hits);
      const box = $('[data-ai-chat]') as HTMLElement;
      box.scrollTop = box.scrollHeight;
      msg('');
    } catch (e) {
      bubble.textContent = '出错了：' + (e as Error).message;
      bubble.classList.add('thinking');
    }
  }

  // AI tab 的事件绑定
  // 配置区自己的状态行：反馈就显示在按钮正下方，不依赖全局 msg
  const aiStatus = (m: string) => {
    (aiFields('status') as HTMLElement).textContent = m;
  };
  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const act = t.closest('[data-act]')?.getAttribute('data-act');
    const quickQ = (t.closest('[data-ai-q]') as HTMLElement | null)?.getAttribute('data-ai-q');
    if (quickQ) {
      aiFields('input').value = quickQ;
      aiFields('input').focus();
      return;
    }
    if (act !== 'ai-save' && act !== 'ai-test' && act !== 'ai-send') return;
    try {
      if (act === 'ai-save') {
        const cfg = readAiForm();
        if (!cfg) return;
        saveAiConfig(cfg);
        aiStatus('✓ 配置已保存（只存在本浏览器）');
      }
      if (act === 'ai-test') {
        const cfg = readAiForm();
        if (!cfg) return;
        const btn = t.closest('button') as HTMLButtonElement;
        btn.disabled = true;
        aiStatus('测试中…');
        try {
          const reply = await aiTestConnection(cfg);
          aiStatus('✓ 连接成功，模型回复：' + reply);
        } catch (err) {
          aiStatus('✗ 连接失败：' + (err as Error).message);
          throw err;
        } finally {
          btn.disabled = false;
        }
      }
      if (act === 'ai-send') await sendAiQuestion();
    } catch (err) {
      msg('出错了：' + (err as Error).message);
    }
  });
  aiFields('input').addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !(e as KeyboardEvent).isComposing) {
      e.preventDefault();
      sendAiQuestion();
    }
  });

  // Tab 切换
  for (const tab of document.querySelectorAll<HTMLButtonElement>('.admin-tab')) {
    tab.addEventListener('click', () => activateTab(tab.dataset.tab ?? 'moment'));
  }

  initAiPanel();

  // 知识库：写笔记 / 传文档 两种模式切换
  for (const radio of document.querySelectorAll<HTMLInputElement>('input[name="kb-mode"]')) {
    radio.addEventListener('change', () => {
      const v = document.querySelector<HTMLInputElement>('input[name="kb-mode"]:checked')?.value;
      ($('[data-kb-form="note"]') as HTMLElement).hidden = v !== 'note';
      ($('[data-kb-form="file"]') as HTMLElement).hidden = v !== 'file';
    });
  }

  await verify();
</script>
