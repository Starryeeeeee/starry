<script>
  // ============ 管理面板：GitHub API 即后端 ============
  import { u } from '../lib/base';
  import {
    AI_PRESETS,
    loadAiConfig,
    saveAiConfig,
    loadProfiles,
    saveProfiles,
    loadActiveProfileId,
    saveActiveProfileId,
    personaForModel,
    aiChat,
    aiTestConnection,
    searchIndex,
    buildContextBlock,
    webSearch,
    buildWebBlock,
    renderMarkdown,
    type AiConfig,
    type AiIndexEntry,
    type AiMessage,
    type AiProfile,
  } from '../lib/ai';

  const REPO = 'Starryeeeeee/starry';
  const BRANCH = 'main';
  const TOKEN_KEY = 'sr-admin-token';

  const api = async (path: string, init: RequestInit = {}) => {
    const token = localStorage.getItem(TOKEN_KEY) ?? '';
    const r = await fetch(`https://api.github.com${path}`, {
      ...init,
      headers: {
        Authorization: `Bearer ${token}`,
        Accept: 'application/vnd.github+json',
        'X-GitHub-Api-Version': '2022-11-28',
        ...(init.body ? { 'Content-Type': 'application/json' } : {}),
        ...init.headers,
      },
    });
    if (!r.ok) {
      const body = await r.json().catch(() => ({}));
      throw new Error(`${r.status} ${body.message ?? r.statusText}`);
    }
    return r.status === 204 ? null : r.json();
  };

  const b64 = (s: string) => btoa(String.fromCharCode(...new TextEncoder().encode(s)));
  async function compressImage(file: File): Promise<Blob> {
    const ext = (file.name.match(/\.([^.]+)$/)?.[1] ?? '').toLowerCase();
    if (file.size < 1.2 * 1024 * 1024 || ext === 'gif') return file;
    try {
      const img = await createImageBitmap(file);
      const scale = Math.min(1, 2000 / Math.max(img.width, img.height));
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(img.width * scale);
      canvas.height = Math.round(img.height * scale);
      const ctx = canvas.getContext('2d')!;
      ctx.fillStyle = '#fff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
      const blob = await new Promise<Blob | null>((res) => canvas.toBlob(res, 'image/jpeg', 0.85));
      return blob ?? file;
    } catch {
      return file; // 解码失败就原样上传
    }
  }

  const b64bin = (buf: Uint8Array) => {
    let out = '';
    for (let i = 0; i < buf.length; i += 0x8000)
      out += String.fromCharCode(...buf.subarray(i, i + 0x8000));
    return btoa(out);
  };

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  let msgTimer: number | undefined;
  const msg = (m: string) => {
    // 页面里有两个提示位（登录区一个、面板底部一个），全都要更新——
    // 只更新第一个的话，登录后第一个正好是隐藏的，所有反馈都会"消失"
    // 样式：底部居中气泡，自动消散；报错时变陶土玫瑰
    const isErr = /失败|出错/.test(m);
    for (const el of document.querySelectorAll<HTMLElement>('.admin-msg')) {
      el.textContent = m;
      el.classList.add('show');
      el.classList.toggle('err', isErr);
    }
    clearTimeout(msgTimer);
    msgTimer = window.setTimeout(() => {
      for (const el of document.querySelectorAll<HTMLElement>('.admin-msg')) el.classList.remove('show');
    }, 3800);
  };

  // 时段问候
  {
    const h = new Date().getHours();
    const greet = h < 5 ? '夜深了' : h < 11 ? '早上好' : h < 14 ? '中午好' : h < 18 ? '下午好' : '晚上好';
    const g = document.querySelector('[data-greet]');
    if (g) g.textContent = greet;
  }

  const dispatchBuild = () =>
    api(`/repos/${REPO}/actions/workflows/deploy.yml/dispatches`, {
      method: 'POST',
      body: JSON.stringify({ ref: BRANCH }),
    });

  // ---------- 删除确认：两段式自绘按钮（替代浏览器原生 confirm） ----------
  // 第一次点 → 按钮变红显示「确认删除？」，4 秒内再点才真删，超时自动还原
  function armDelete(btn: HTMLButtonElement, run: () => Promise<void>) {
    if (btn.dataset.armed) {
      btn.disabled = true;
      try {
        void run();
      } catch (e) {
        msg('删除失败：' + (e as Error).message);
      }
      return;
    }
    btn.dataset.armed = '1';
    btn.dataset.original = btn.textContent ?? '';
    btn.textContent = '确认删除？';
    btn.classList.add('danger');
    window.setTimeout(() => disarmDelete(btn), 4000);
  }

  function disarmDelete(btn: HTMLButtonElement) {
    btn.dataset.armed = '';
    btn.classList.remove('danger');
    btn.disabled = false;
    if (btn.dataset.original) btn.textContent = btn.dataset.original;
  }

  // ---------- 登录态 ----------
  async function showLogin(loggedIn: { login: string; avatar_url: string } | null) {
    $('.admin-login').hidden = !!loggedIn;
    $('.admin-body').hidden = !loggedIn;
    $('.admin-user').hidden = !loggedIn;
    if (loggedIn) {
      const img = $('.admin-user img');
      img.src = loggedIn.avatar_url;
      $('.admin-user b').textContent = loggedIn.login;
    }
  }

  async function verify() {
    const token = localStorage.getItem(TOKEN_KEY);
    if (!token) return showLogin(null);
    try {
      const me = await api('/user');
      await showLogin(me);
      await refreshMoments();
      await refreshPosts();
      await refreshKb().catch((e) => console.warn('[admin] 知识库列表加载失败', e));
      await refreshGallery().catch((e) => console.warn('[admin] 画廊列表加载失败', e));
    } catch {
      localStorage.removeItem(TOKEN_KEY);
      await showLogin(null);
      msg('令牌无效或已过期，请重新登录');
    }
  }

  // ---------- 编辑模式状态 ----------
  // metaId = 内容已有的稳定 ID（没有则保存时生成）；status = 原状态
  let editingPost: {
    name: string;
    sha: string;
    date: string;
    metaId?: string;
    metaStatus?: string;
  } | null = null;
  let editingKbNote: {
    name: string;
    sha: string;
    date: string;
    metaId?: string;
    metaStatus?: string;
  } | null = null;

  // 稳定内容 ID：c-日期-随机码，创建后永不变（改名/迁移靠它保住评论和点赞）
  const newCid = (date: string) =>
    `c-${date.replace(/-/g, '')}-${Math.random().toString(36).slice(2, 6)}`;

  // frontmatter 简易解析：够用即可（写入方是我们自己）
  function parseFrontmatter(raw: string): {
    meta: Record<string, string | string[]>;
    body: string;
  } {
    const m = raw.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/);
    if (!m) return { meta: {}, body: raw };
    const meta: Record<string, string | string[]> = {};
    for (const line of m[1].split(/\r?\n/)) {
      const i = line.indexOf(':');
      if (i === -1) continue;
      const k = line.slice(0, i).trim();
      let v: string | string[] = line.slice(i + 1).trim();
      if (v.startsWith('[') && v.endsWith(']')) {
        v = v
          .slice(1, -1)
          .split(',')
          .map((s) => s.trim().replace(/^["']|["']$/g, ''))
          .filter(Boolean);
      } else {
        v = v.replace(/^["']|["']$/g, '');
      }
      if (k) meta[k] = v;
    }
    return { meta, body: m[2] };
  }

  function setBanner(kind: 'post' | 'kb', name: string | null) {
    const banner = $(`[data-edit-banner="${kind}"]`) as HTMLElement;
    banner.hidden = !name;
    if (name) (banner.querySelector('[data-edit-name]') as HTMLElement).textContent = name;
  }

  function activateTab(name: string) {
    document.querySelectorAll('.admin-tab').forEach((el) => el.classList.remove('active'));
    document
      .querySelector<HTMLButtonElement>(`.admin-tab[data-tab="${name}"]`)
      ?.classList.add('active');
    document.querySelectorAll('.admin-panel').forEach((p) => {
      (p as HTMLElement).hidden = p.getAttribute('data-panel') !== name;
    });
  }

  async function startEditPost(f: { name: string }) {
    const r = await api(
      `/repos/${REPO}/contents/src/content/posts/${encodeURIComponent(f.name)}?ref=${BRANCH}`,
    );
    const { meta, body } = parseFrontmatter(b64ToText(r.content.replace(/\s/g, '')));
    editingPost = {
      name: f.name,
      sha: r.sha,
      date: String(meta.date ?? todayStr()),
      metaId: typeof meta.id === 'string' ? meta.id : undefined,
      metaStatus: typeof meta.status === 'string' ? meta.status : 'public',
    };
    ($('[data-post="title"]') as HTMLInputElement).value = String(meta.title ?? '');
    ($('[data-post="slug"]') as HTMLInputElement).value = f.name.replace(/\.md$/, '');
    ($('[data-post="slug"]') as HTMLInputElement).disabled = true; // 编辑模式不改文件名
    ($('[data-post="tags"]') as HTMLInputElement).value = Array.isArray(meta.tags)
      ? meta.tags.join(', ')
      : '';
    ($('[data-post="desc"]') as HTMLInputElement).value = String(meta.description ?? '');
    ($('[data-post="status"]') as HTMLSelectElement).value =
      editingPost.metaStatus === 'draft' || editingPost.metaStatus === 'archived'
        ? editingPost.metaStatus
        : 'public';
    ($('[data-post="body"]') as HTMLTextAreaElement).value = body;
    ($('[data-act="publish-post"]') as HTMLElement).textContent = '保存修改';
    setBanner('post', f.name);
    activateTab('post');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function exitPostEdit(clearForm: boolean) {
    editingPost = null;
    ($('[data-post="slug"]') as HTMLInputElement).disabled = false;
    ($('[data-act="publish-post"]') as HTMLElement).textContent = '发布文章';
    setBanner('post', null);
    if (clearForm)
      ['title', 'slug', 'tags', 'desc', 'body'].forEach(
        (k) => (($(`[data-post="${k}"]`) as HTMLInputElement).value = ''),
      );
  }

  async function startEditKbNote(f: { name: string }) {
    const r = await api(
      `/repos/${REPO}/contents/${KB_NOTE_DIR}/${encodeURIComponent(f.name)}?ref=${BRANCH}`,
    );
    const { meta, body } = parseFrontmatter(b64ToText(r.content.replace(/\s/g, '')));
    editingKbNote = {
      name: f.name,
      sha: r.sha,
      date: String(meta.date ?? todayStr()),
      metaId: typeof meta.id === 'string' ? meta.id : undefined,
      metaStatus: typeof meta.status === 'string' ? meta.status : 'public',
    };
    ($('[data-kb-note="title"]') as HTMLInputElement).value = String(meta.title ?? '');
    ($('[data-kb-note="subject"]') as HTMLInputElement).value = String(meta.subject ?? '');
    ($('[data-kb-note="tags"]') as HTMLInputElement).value = Array.isArray(meta.tags)
      ? meta.tags.join(', ')
      : '';
    ($('[data-kb-note="desc"]') as HTMLInputElement).value = String(meta.description ?? '');
    ($('[data-kb-note="status"]') as HTMLSelectElement).value =
      editingKbNote.metaStatus === 'draft' || editingKbNote.metaStatus === 'archived'
        ? editingKbNote.metaStatus
        : 'public';
    ($('[data-kb-note="body"]') as HTMLTextAreaElement).value = body;
    ($('[data-act="publish-kb-note"]') as HTMLElement).textContent = '保存修改';
    setBanner('kb', f.name);
    // 确保处于「写笔记」模式
    const radio = document.querySelector<HTMLInputElement>('input[name="kb-mode"][value="note"]');
    if (radio) {
      radio.checked = true;
      radio.dispatchEvent(new Event('change'));
    }
    activateTab('kb');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function exitKbEdit(clearForm: boolean) {
    editingKbNote = null;
    ($('[data-act="publish-kb-note"]') as HTMLElement).textContent = '发布条目';
    setBanner('kb', null);
    if (clearForm)
      ['title', 'tags', 'desc', 'body'].forEach(
        (k) => (($(`[data-kb-note="${k}"]`) as HTMLInputElement).value = ''),
      );
  }

  // ---------- 总览计数（/admin 顶部一行） ----------
  function setCount(key: string, n: number) {
    const el = document.querySelector(`[data-o="${key}"]`);
    if (el) el.textContent = String(n);
  }

  // ---------- 动态（废话条 / 箴言 / 看法，同一入口不同标签） ----------
  const MOMENT_TYPES: Record<string, string> = { moment: '废话条', quote: '箴言', view: '看法' };
  const currentMomentLabel = () =>
    ($('[data-moment-label]') as HTMLSelectElement | null)?.value ?? 'moment';

  async function refreshMoments() {
    const label = currentMomentLabel();
    const typeName = MOMENT_TYPES[label] ?? '动态';
    const titleEl = document.querySelector('[data-moment-list-title]');
    if (titleEl) titleEl.textContent = `已发布的${typeName}`;
    const list = $('[data-list="moments"]');
    list.innerHTML = '<li class="meta">加载中…</li>';
    const issues = await api(`/repos/${REPO}/issues?labels=${encodeURIComponent(label)}&state=open&per_page=30`);
    list.innerHTML = '';
    if (!issues.length) {
      list.innerHTML = `<li class="meta">还没有${typeName}</li>`;
      setCount('moments', 0);
      return;
    }
    setCount('moments', issues.length);
    for (const it of issues) {
      const li = document.createElement('li');
      li.innerHTML = `<span class="name"></span><span class="meta">${it.created_at.slice(0, 10)}</span>`;
      (li.querySelector('.name') as HTMLElement).textContent = it.title;
      const del = document.createElement('button');
      del.className = 'admin-btn ghost';
      del.type = 'button';
      del.textContent = '删除';
      del.onclick = () => {
        armDelete(del, async () => {
          await api(`/repos/${REPO}/issues/${it.number}`, {
            method: 'PATCH',
            body: JSON.stringify({ state: 'closed' }),
          });
          await dispatchBuild();
          msg('已删除，站点构建中（1-2 分钟生效）');
          await refreshMoments();
        });
      };
      li.appendChild(del);
      list.appendChild(li);
    }
  }

  // ---------- 文章（contents API） ----------
  async function refreshPosts() {
    const list = $('[data-list="posts"]');
    list.innerHTML = '<li class="meta">加载中…</li>';
    const files = await api(`/repos/${REPO}/contents/src/content/posts?ref=${BRANCH}`);
    list.innerHTML = '';
    if (!files.length) {
      list.innerHTML = '<li class="meta">还没有文章</li>';
      setCount('posts', 0);
      return;
    }
    setCount('posts', files.length);
    for (const f of files) {
      const li = document.createElement('li');
      const name = document.createElement('span');
      name.className = 'name';
      name.textContent = f.name;
      const edit = document.createElement('button');
      edit.className = 'admin-btn ghost';
      edit.type = 'button';
      edit.textContent = '编辑';
      edit.onclick = () => {
        startEditPost(f).catch((e) => msg('打开编辑失败：' + (e as Error).message));
      };
      const del = document.createElement('button');
      del.className = 'admin-btn ghost';
      del.type = 'button';
      del.textContent = '删除';
      del.onclick = () => {
        armDelete(del, async () => {
          await api(`/repos/${REPO}/contents/src/content/posts/${f.name}`, {
            method: 'DELETE',
            body: JSON.stringify({ message: `删文章 ${f.name}`, sha: f.sha, branch: BRANCH }),
          });
          msg('已删除，构建中…（push 自动触发）');
          await refreshPosts();
        });
      };
      li.append(name, edit, del);
      list.appendChild(li);
    }
  }

  // ---------- 知识库（笔记 = contents API；文档 = public/kb + 清单 JSON） ----------
  const KB_NOTE_DIR = 'src/content/kb';
  const KB_FILE_DIR = 'public/kb';
  const KB_JSON_PATH = 'src/data/kb-files.json';
  const GALLERY_DIR = 'src/assets/gallery';

  // ---------- 画廊（图片 = contents API + 前端压缩） ----------
  async function refreshGallery() {
    const list = $('[data-list="gallery"]');
    list.innerHTML = '<li class="meta">加载中…</li>';
    const files = await api(
      `/repos/${REPO}/contents/src/assets/gallery?ref=${BRANCH}`,
    ).catch(() => []);
    const images = (Array.isArray(files) ? files : []).filter((f: any) =>
      /\.(jpe?g|png|webp|avif|gif)$/i.test(f.name),
    );
    setCount('gallery', images.length);
    list.innerHTML = '';
    if (!images.length) {
      list.innerHTML = '<li class="meta">还没有图片</li>';
      return;
    }
    for (const f of images) {
      const li = document.createElement('li');
      const stem = f.name.replace(/\.[^.]+$/, '');
      const caption = stem.replace(/^\d{4}-\d{2}-\d{2}[\s_-]?/, '') || stem;
      li.innerHTML = `<span class="name"></span><span class="meta">${Math.max(1, Math.round(f.size / 1024))} KB</span>`;
      (li.querySelector('.name') as HTMLElement).textContent = caption;
      li.appendChild(makeKbDeleteBtn(async () => {
        await api(`/repos/${REPO}/contents/${encodeURIComponent('src/assets/gallery/' + f.name)}`, {
          method: 'DELETE',
          body: JSON.stringify({ message: `删画廊图片 ${f.name}`, sha: f.sha, branch: BRANCH }),
        });
      }, li));
      list.appendChild(li);
    }
  }

  async function uploadGalleryFiles(files: File[], caption: string) {
    const date = todayStr();
    for (let i = 0; i < files.length; i++) {
      const f = files[i];
      msg(`上传中 ${i + 1}/${files.length}：${f.name}`);
      const blob = await compressImage(f);
      const buf = new Uint8Array(await blob.arrayBuffer());
      const ext = blob.type === 'image/jpeg' && !/\.jpe?g$/i.test(f.name) ? 'jpg' : (f.name.match(/\.([^.]+)$/)?.[1] ?? 'jpg').toLowerCase();
      const rawStem = caption || f.name.replace(/\.[^.]+$/, '').replace(/^\d{4}-\d{2}-\d{2}[\s_-]?/, '') || '图片';
      const stem = rawStem.replace(/[/\\?#%*"<>|:]/g, '').trim() || '图片';
      const name = `${date} ${stem}.${ext}`;
      await api(`/repos/${REPO}/contents/${encodeURIComponent('src/assets/gallery/' + name)}`, {
        method: 'PUT',
        body: JSON.stringify({
          message: `画廊：${stem}`,
          branch: BRANCH,
          content: b64bin(buf),
        }),
      });
    }
    await dispatchBuild();
  }

  const todayStr = () => new Date().toISOString().slice(0, 10);

  // base64 → UTF-8 文本（清单里有中文，直接 atob 会乱码）
  const b64ToText = (b64: string) =>
    new TextDecoder().decode(Uint8Array.from(atob(b64), (c) => c.charCodeAt(0)));

  const getKbJson = async (): Promise<{ sha: string | null; list: any[] }> => {
    try {
      const r = await api(`/repos/${REPO}/contents/${KB_JSON_PATH}?ref=${BRANCH}`);
      return { sha: r.sha, list: JSON.parse(b64ToText(r.content.replace(/\s/g, ''))) };
    } catch (e) {
      if (String((e as Error).message).startsWith('404')) return { sha: null, list: [] };
      throw e;
    }
  };

  const putKbJson = (list: any[], sha: string | null, message: string) =>
    api(`/repos/${REPO}/contents/${KB_JSON_PATH}`, {
      method: 'PUT',
      body: JSON.stringify({
        message,
        branch: BRANCH,
        content: b64(JSON.stringify(list, null, 2) + '\n'),
        ...(sha ? { sha } : {}),
      }),
    });

  const safeName = (n: string) =>
    n.replace(/^.*[/\\]/, '').replace(/[#?%*"<>|]/g, '').replace(/\s+/g, '-').slice(-80) || 'file';

  const titleToFileName = (t: string) =>
    t.replace(/[#?%*"<>|:/\\]/g, '').replace(/\s+/g, '-').slice(0, 60) ||
    `kb-${Date.now().toString(36)}`;

  async function refreshKb() {
    const list = $('[data-list="kb"]');
    list.innerHTML = '<li class="meta">加载中…</li>';
    const [notes, kbJson] = await Promise.all([
      api(`/repos/${REPO}/contents/${KB_NOTE_DIR}?ref=${BRANCH}`).catch(() => []),
      getKbJson().catch(() => ({ list: [] })),
    ]);
    const files: any[] = kbJson.list ?? [];
    list.innerHTML = '';
    setCount('kb', notes.length + files.length);
    if (!notes.length && !files.length) {
      list.innerHTML = '<li class="meta">还没有条目——先写一条笔记或传一份文档</li>';
      return;
    }
    for (const f of notes) {
      const li = document.createElement('li');
      li.innerHTML = `<span class="name"></span><span class="meta">笔记</span>`;
      (li.querySelector('.name') as HTMLElement).textContent = f.name;
      const edit = document.createElement('button');
      edit.className = 'admin-btn ghost';
      edit.type = 'button';
      edit.textContent = '编辑';
      edit.onclick = () => {
        startEditKbNote(f).catch((e) => msg('打开编辑失败：' + (e as Error).message));
      };
      li.appendChild(edit);
      li.appendChild(makeKbDeleteBtn(async () => {
        await api(`/repos/${REPO}/contents/${KB_NOTE_DIR}/${encodeURIComponent(f.name)}`, {
          method: 'DELETE',
          body: JSON.stringify({ message: `删知识库条目 ${f.name}`, sha: f.sha, branch: BRANCH }),
        });
      }, li));
      list.appendChild(li);
    }
    for (const rec of files) {
      const li = document.createElement('li');
      li.innerHTML = `<span class="name"></span><span class="meta"></span>`;
      (li.querySelector('.name') as HTMLElement).textContent =
        `${rec.title}（${(rec.ext ?? '').toUpperCase()}，${Math.max(1, Math.round((rec.size ?? 0) / 1024))} KB）`;
      li.querySelector('.meta')!.textContent = rec.date ?? '';
      li.appendChild(makeKbDeleteBtn(async () => {
        // 先删文件本体（不存在也不报错跳过），再把记录从清单里拿掉
        try {
          const meta = await api(`/repos/${REPO}/contents/${encodeURIComponent(KB_FILE_DIR)}/${encodeURIComponent(rec.file.split('/').pop() ?? '')}?ref=${BRANCH}`);
          await api(`/repos/${REPO}/contents/${KB_FILE_DIR}/${encodeURIComponent(rec.file.split('/').pop() ?? '')}`, {
            method: 'DELETE',
            body: JSON.stringify({ message: `删知识库文件 ${rec.file}`, sha: meta.sha, branch: BRANCH }),
          });
        } catch { /* 文件本体可能已不在，继续清清单 */ }
        const { sha, list: cur } = await getKbJson();
        await putKbJson(cur.filter((x: any) => x.slug !== rec.slug), sha, '更新知识库清单');
      }, li));
      list.appendChild(li);
    }
  }

  function makeKbDeleteBtn(fn: () => Promise<void>, li: HTMLLIElement) {
    const del = document.createElement('button');
    del.className = 'admin-btn ghost';
    del.type = 'button';
    del.textContent = '删除';
    del.onclick = () => {
      armDelete(del, async () => {
        await fn();
        await dispatchBuild();
        msg('已删除，站点构建中（1-2 分钟生效）');
        await refreshKb();
      });
    };
    return del;
  }

  // ---------- 事件绑定 ----------
  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const act = t.closest('[data-act]')?.getAttribute('data-act');
    if (!act) return;
    try {
      if (act === 'login') {
        const input = $('.login-row input') as HTMLInputElement;
        if (!input.value.trim()) return msg('先粘贴令牌');
        localStorage.setItem(TOKEN_KEY, input.value.trim());
        input.value = '';
        // 画廊：点击/拖拽选图
  const drop = document.querySelector('[data-gallery-drop]');
  const gInput = document.querySelector<HTMLInputElement>('[data-gallery-input]');
  drop?.addEventListener('click', () => gInput?.click());
  drop?.addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent).key === 'Enter') gInput?.click();
  });
  ['dragover', 'dragenter'].forEach((ev) =>
    drop?.addEventListener(ev, (e) => {
      e.preventDefault();
      drop.classList.add('dragging');
    }),
  );
  ['dragleave', 'drop'].forEach((ev) =>
    drop?.addEventListener(ev, () => drop?.classList.remove('dragging')),
  );
  drop?.addEventListener('drop', (e) => {
    e.preventDefault();
    const files = [...(e as DragEvent).dataTransfer!.files].filter((f) => f.type.startsWith('image/'));
    if (gInput && files.length) {
      const dt = new DataTransfer();
      files.forEach((f) => dt.items.add(f));
      gInput.files = dt.files;
    }
  });

  await verify();
        msg('登录成功');
      }
      if (act === 'logout') {
        localStorage.removeItem(TOKEN_KEY);
        await showLogin(null);
        window.dispatchEvent(new Event('sr-token-changed')); // 快速输入按钮即时隐藏
      }
      if (act === 'publish-moment') {
        const ta = $('[data-panel="moment"] textarea') as HTMLTextAreaElement;
        const text = ta.value.trim();
        if (!text) return msg('写点什么再发');
        const label = ($('[data-moment-label]') as HTMLSelectElement).value;
        const typeName = label === 'quote' ? '箴言' : label === 'view' ? '看法' : '废话条';
        t.setAttribute('disabled', '');
        await api(`/repos/${REPO}/issues`, {
          method: 'POST',
          body: JSON.stringify({ title: text, labels: [label] }),
        });
        await dispatchBuild();
        ta.value = '';
        msg(`已发布到「${typeName}」，站点构建中（1-2 分钟上站）`);
        await refreshMoments();
        t.removeAttribute('disabled');
      }
      if (act === 'publish-post') {
        const g = (k: string) => ($(`[data-post="${k}"]`) as HTMLInputElement).value.trim();
        const title = g('title');
        if (!title) return msg('标题必填');
        const isEdit = !!editingPost;
        let slug: string;
        if (isEdit) {
          slug = editingPost!.name.replace(/\.md$/, '');
        } else {
          slug = g('slug');
          if (!slug) {
            slug =
              /^[a-z0-9\- ]+$/i.test(title) && title.trim().length >= 3
                ? title.trim().toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '')
                : `post-${Date.now().toString(36)}`;
          }
          if (!/^[a-z0-9-]+$/.test(slug)) return msg('文件名只能用小写英文、数字和连字符');
        }
        // 编辑时保留原发布日期与内容 ID；新建才用今天/生成新 ID
        const date = isEdit ? editingPost!.date : new Date().toISOString().slice(0, 10);
        const cid = isEdit
          ? (editingPost!.metaId ?? newCid(date)) // 旧内容没有 ID：首次编辑时惰性补上
          : newCid(date);
        const status = g('status') || 'public';
        const tags = g('tags')
          ? g('tags')
              .split(/[,，]/)
              .map((s) => s.trim())
              .filter(Boolean)
          : [];
        const fm = [
          '---',
          `id: ${cid}`,
          `title: ${title}`,
          `date: ${date}`,
          g('desc') ? `description: ${g('desc')}` : null,
          tags.length ? `tags: [${tags.join(', ')}]` : null,
          `status: ${status}`,
          '---',
          '',
          '',
        ]
          .filter((l) => l !== null)
          .join('\n');
        t.setAttribute('disabled', '');
        await api(`/repos/${REPO}/contents/src/content/posts/${slug}.md`, {
          method: 'PUT',
          body: JSON.stringify({
            message: isEdit ? `修改文章：${title}` : `发文：${title}`,
            branch: BRANCH,
            content: b64(fm + $('[data-post="body"]').value),
            ...(isEdit ? { sha: editingPost!.sha } : {}),
          }),
        });
        msg(
          isEdit
            ? `《${title}》已保存修改，push 自动构建中（1-2 分钟上站）`
            : `已发布《${title}》，push 自动构建中（1-2 分钟上站）`,
        );
        exitPostEdit(true);
        await refreshPosts();
        t.removeAttribute('disabled');
      }
      if (act === 'publish-kb-note') {
        const g = (k: string) => ($(`[data-kb-note="${k}"]`) as HTMLInputElement).value.trim();
        const title = g('title');
        if (!title) return msg('标题必填');
        const isEdit = !!editingKbNote;
        const tags = g('tags')
          .split(/[,，]/)
          .map((s) => s.trim())
          .filter(Boolean);
        // 编辑时保留原日期、原文件名与内容 ID（没有则惰性补上）；新建才用今天/生成新 ID
        const date = isEdit ? editingKbNote!.date : todayStr();
        const cid = isEdit
          ? (editingKbNote!.metaId ?? newCid(date))
          : newCid(date);
        const status = g('status') || 'public';
        const name = isEdit ? editingKbNote!.name : `${titleToFileName(title)}.md`;
        const fm = [
          '---',
          `id: ${cid}`,
          `title: ${title}`,
          `date: ${date}`,
          g('desc') ? `description: ${g('desc')}` : null,
          `subject: ${g('subject') || '未分类'}`,
          tags.length ? `tags: [${tags.join(', ')}]` : null,
          `status: ${status}`,
          '---',
          '',
          '',
        ]
          .filter((l) => l !== null)
          .join('\n');
        t.setAttribute('disabled', '');
        await api(`/repos/${REPO}/contents/${KB_NOTE_DIR}/${encodeURIComponent(name)}`, {
          method: 'PUT',
          body: JSON.stringify({
            message: isEdit ? `知识库修改：${title}` : `知识库：${title}`,
            branch: BRANCH,
            content: b64(fm + ($('[data-kb-note="body"]') as HTMLTextAreaElement).value),
            ...(isEdit ? { sha: editingKbNote!.sha } : {}),
          }),
        });
        msg(
          isEdit
            ? `《${title}》已保存修改，构建中（1-2 分钟上站）`
            : `已发布《${title}》，构建中（1-2 分钟上站）`,
        );
        exitKbEdit(true);
        await refreshKb();
        t.removeAttribute('disabled');
      }
      if (act === 'upload-kb-file') {
        const input = $('[data-kb-file]') as HTMLInputElement;
        const f = input.files?.[0];
        if (!f) return msg('先选一个文件');
        if (f.size > 40 * 1024 * 1024) return msg('文件超过 40MB，放进 git 仓库会让克隆变慢，建议拆小或换链接');
        const date = todayStr();
        const safe = safeName(f.name);
        const stem = safe.replace(/\.[^.]+$/, '') || 'file';
        const ext = (f.name.match(/\.([^.]+)$/)?.[1] ?? '').toLowerCase();
        const slug = `${date}-${stem}`.slice(0, 100);
        const g = (k: string) => ($(`[data-kb-file="${k}"]`) as HTMLInputElement).value.trim();
        t.setAttribute('disabled', '');
        msg('上传中…（文件较大时会慢一些）');
        const dataUrl = await new Promise<string>((res, rej) => {
          const r = new FileReader();
          r.onload = () => res(r.result as string);
          r.onerror = () => rej(new Error('读取文件失败'));
          r.readAsDataURL(f);
        });
        await api(`/repos/${REPO}/contents/${KB_FILE_DIR}/${encodeURIComponent(safe)}`, {
          method: 'PUT',
          body: JSON.stringify({
            message: `知识库文件：${safe}`,
            branch: BRANCH,
            content: dataUrl.split(',')[1],
          }),
        });
        const { sha, list } = await getKbJson();
        list.unshift({
          slug,
          title: g('title') || stem,
          subject: g('subject') || '未分类',
          tags: g('tags')
            .split(/[,，]/)
            .map((s) => s.trim())
            .filter(Boolean),
          description: g('desc'),
          file: `/kb/${safe}`,
          ext,
          size: f.size,
          date,
        });
        await putKbJson(list, sha, '知识库清单：新增文档条目');
        msg('已上传，构建中（1-2 分钟上站）');
        input.value = '';
        ['title', 'subject', 'tags', 'desc'].forEach(
          (k) => (($(`[data-kb-file="${k}"]`) as HTMLInputElement).value = ''),
        );
        await refreshKb();
        t.removeAttribute('disabled');
      }
      if (act === 'cancel-edit-post') {
        exitPostEdit(true);
        msg('已退出编辑');
      }
      if (act === 'cancel-edit-kb') {
        exitKbEdit(true);
        msg('已退出编辑');
      }
      if (act === 'gallery-upload') {
        const input = $('[data-gallery-input]') as HTMLInputElement;
        const caption = ($('[data-gallery-caption]') as HTMLInputElement).value.trim();
        const files = [...(input.files ?? [])];
        if (!files.length) return msg('先选择图片');
        t.setAttribute('disabled', '');
        await uploadGalleryFiles(files, caption);
        msg(`已上传 ${files.length} 张，构建中（1-2 分钟上站）`);
        input.value = '';
        await refreshGallery();
        t.removeAttribute('disabled');
      }
      if (act === 'rebuild') {
        await dispatchBuild();
        msg('已触发构建，1-2 分钟后生效');
      }
      if (act === 'setup-giscus') {
        t.setAttribute('disabled', '');
        const q = await api('/graphql', {
          method: 'POST',
          body: JSON.stringify({
            query: `query{repository(owner:"Starryeeeeee",name:"starry"){id discussionCategories(first:10){nodes{id name}}}}`,
          }),
        });
        const repo = q.data?.repository;
        if (!repo?.discussionCategories) {
          msg('读不到 Discussions：请先在仓库 Settings 勾选 Discussions，并安装 giscus App');
          t.removeAttribute('disabled');
          return;
        }
        const cats = repo.discussionCategories.nodes;
        const cat = cats.find((c: { name: string }) => c.name === 'Announcements') ?? cats[0];
        await api(`/repos/${REPO}/contents/public/site-config.json`, {
          method: 'PUT',
          body: JSON.stringify({
            message: '配置 giscus 评论',
            branch: BRANCH,
            content: b64(
              JSON.stringify(
                { giscus: { repoId: repo.id, categoryId: cat.id, category: cat.name } },
                null,
                2,
              ),
            ),
          }),
        });
        msg(`评论已配置（分类：${cat.name}），构建完成后文章页即可评论`);
        t.removeAttribute('disabled');
      }
    } catch (err) {
      msg('出错了：' + (err as Error).message);
      t.removeAttribute('disabled');
    }
  });

  // ---------- AI 助手（模型档案 + 会话记录 + 资料问答） ----------
  const aiFields = (k: string) => $(`[data-ai="${k}"]`) as HTMLInputElement;
  let aiIndex: AiIndexEntry[] | null = null;
  let aiIndexAt = 0;

  // 全站索引带 10 分钟缓存，避免每问一次都重新拉
  async function ensureAiIndex(): Promise<AiIndexEntry[]> {
    if (aiIndex && Date.now() - aiIndexAt < 10 * 60 * 1000) return aiIndex;
    const r = await fetch(u('/api-index.json'));
    if (!r.ok) throw new Error('读不到全站索引 /api-index.json（站点还没构建？先触发一次构建）');
    const data = (await r.json()) as { entries: AiIndexEntry[] };
    aiIndex = data.entries ?? [];
    aiIndexAt = Date.now();
    return aiIndex;
  }

  // ---------- 模型档案 ----------
  let aiProfiles: AiProfile[] = [];
  let aiActiveId: string | null = null;
  let aiEditingId: string | null = null; // 正在编辑的档案；null = 表单是"另起新模型"

  const activeProfile = (): AiProfile | null =>
    aiProfiles.find((p) => p.id === aiActiveId) ?? aiProfiles[0] ?? null;

  /** 人格短名：去掉括号里的英文名，气泡标签用 */
  const shortName = (name: string) => name.split('（')[0].trim() || name;

  function fillProfileForm(p: AiProfile) {
    aiFields('name').value = p.name;
    aiFields('baseUrl').value = p.baseUrl;
    aiFields('model').value = p.model;
    aiFields('apiKey').value = p.apiKey;
    const matched = AI_PRESETS.find((x) => x.baseUrl === p.baseUrl && x.key !== 'custom');
    const presetSel = aiFields('preset') as unknown as HTMLSelectElement;
    presetSel.value = matched?.key ?? 'custom';
    (aiFields('preset-note') as HTMLElement).textContent =
      matched?.note ?? (AI_PRESETS.find((x) => x.key === 'custom')?.note ?? '');
  }

  function refreshProfileList() {
    const wrap = $('[data-ai="profiles"]') as HTMLElement;
    wrap.innerHTML = '';
    if (!aiProfiles.length) {
      const s = document.createElement('span');
      s.className = 'ai-profile-empty';
      s.textContent = '还没有模型，用下面的表单添加第一位成员';
      wrap.appendChild(s);
      return;
    }
    for (const p of aiProfiles) {
      const chip = document.createElement('span');
      chip.className = 'ai-profile-chip' + (p.id === aiActiveId ? ' active' : '');
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'ai-profile-name';
      b.textContent = p.id === aiActiveId ? `◉ ${p.name}` : p.name;
      b.title = '点击选用，并载入下方表单编辑';
      b.onclick = () => {
        aiActiveId = p.id;
        aiEditingId = p.id;
        saveActiveProfileId(p.id);
        fillProfileForm(p);
        refreshProfileList();
        refreshModelPop();
        updateModelPill();
      };
      chip.appendChild(b);
      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'ai-profile-del';
      del.textContent = '✕';
      del.title = '删除这个模型';
      del.onclick = () => {
        armDelete(del, async () => {
          aiProfiles = aiProfiles.filter((x) => x.id !== p.id);
          if (aiActiveId === p.id) aiActiveId = aiProfiles[0]?.id ?? null;
          if (aiEditingId === p.id) aiEditingId = null;
          saveProfiles(aiProfiles);
          saveActiveProfileId(aiActiveId);
          refreshProfileList();
          refreshModelPop();
          updateModelPill();
        });
      };
      chip.appendChild(del);
      wrap.appendChild(chip);
    }
  }

  function updateModelPill() {
    const p = activeProfile();
    (aiFields('model-pill') as HTMLElement).textContent = p ? `◉ ${shortName(p.name)}` : '⚙ 选择模型';
  }

  function refreshModelPop() {
    const pop = $('[data-ai="model-pop"]') as HTMLElement;
    pop.innerHTML = '';
    if (!aiProfiles.length) {
      const s = document.createElement('span');
      s.className = 'ai-model-empty';
      s.textContent = '还没有配置模型，去下方「模型管理」添加';
      pop.appendChild(s);
      return;
    }
    for (const p of aiProfiles) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'ai-model-item' + (p.id === aiActiveId ? ' active' : '');
      b.textContent = p.id === aiActiveId ? `● ${p.name}` : p.name;
      b.onclick = () => {
        aiActiveId = p.id;
        aiEditingId = p.id;
        saveActiveProfileId(p.id);
        fillProfileForm(p);
        refreshProfileList();
        refreshModelPop();
        updateModelPill();
        pop.hidden = true;
      };
      pop.appendChild(b);
    }
  }

  // ---------- 会话记录（存本浏览器 localStorage） ----------
  type AiStoredSource = { title: string; path?: string; url?: string };
  type AiStoredNote = { text: string; links?: Array<{ title: string; url: string }> } | null;
  type AiStoredMsg = {
    role: 'user' | 'bot';
    content: string;
    /** bot 消息：当时的模型人格短名 */
    by?: string;
    sources?: AiStoredSource[];
    note?: AiStoredNote;
  };
  type AiSession = { id: string; title: string; date: string; messages: AiStoredMsg[] };

  const SESSIONS_KEY = 'sr-ai-sessions';
  const ACTIVE_SESSION_KEY = 'sr-ai-session';
  const MAX_SESSIONS = 30;

  let aiSessions: AiSession[] = [];
  let aiSessionId: string | null = null;
  try {
    aiSessions = JSON.parse(localStorage.getItem(SESSIONS_KEY) ?? '[]') as AiSession[];
  } catch {
    aiSessions = [];
  }
  aiSessionId = localStorage.getItem(ACTIVE_SESSION_KEY);

  const saveSessions = () => {
    localStorage.setItem(SESSIONS_KEY, JSON.stringify(aiSessions.slice(0, MAX_SESSIONS)));
  };
  const curSession = (): AiSession | null => aiSessions.find((s) => s.id === aiSessionId) ?? null;

  function refreshSessionSelect() {
    const sel = aiFields('session') as unknown as HTMLSelectElement;
    sel.innerHTML = '';
    for (const s of aiSessions) {
      const opt = document.createElement('option');
      opt.value = s.id;
      opt.textContent = `${s.title} · ${s.date}`;
      sel.appendChild(opt);
    }
    if (aiSessionId) sel.value = aiSessionId;
  }

  function newSession(): AiSession {
    const s: AiSession = {
      id: 's-' + Date.now().toString(36),
      title: '新对话',
      date: todayStr(),
      messages: [],
    };
    aiSessions.unshift(s);
    if (aiSessions.length > MAX_SESSIONS) aiSessions = aiSessions.slice(0, MAX_SESSIONS);
    aiSessionId = s.id;
    localStorage.setItem(ACTIVE_SESSION_KEY, s.id);
    saveSessions();
    refreshSessionSelect();
    return s;
  }

  async function openSession(id: string) {
    aiSessionId = id;
    localStorage.setItem(ACTIVE_SESSION_KEY, id);
    const s = curSession();
    const box = $('[data-ai-chat]') as HTMLElement;
    box.innerHTML = '';
    box.hidden = false;
    if (s) {
      for (const m of s.messages) {
        if (m.role === 'user') {
          appendAiMsg('user', m.content);
          continue;
        }
        const bubble = appendAiMsg('bot', '', m.by);
        bubble.classList.add('md');
        bubble.innerHTML = await renderMarkdown(m.content);
        if (m.sources?.length) appendAiSources(bubble, m.sources);
        if (m.note) {
          const n = document.createElement('div');
          n.className = 'ai-src';
          n.textContent = m.note.text;
          for (const l of m.note.links ?? []) {
            const a = document.createElement('a');
            a.href = l.url;
            a.target = '_blank';
            a.rel = 'noopener';
            a.textContent = ` ${l.title} ·`;
            n.appendChild(a);
          }
          bubble.insertAdjacentElement('afterend', n);
        }
      }
    }
    box.scrollTop = box.scrollHeight;
    refreshSessionSelect();
  }

  function appendAiMsg(kind: 'user' | 'bot', text: string, byLabel?: string): HTMLElement {
    const box = $('[data-ai-chat]') as HTMLElement;
    box.hidden = false;
    // 每条消息一个 turn：角色标签 + 气泡，问答两侧对齐一眼可分
    const turn = document.createElement('div');
    turn.className = `ai-turn ${kind}`;
    const role = document.createElement('span');
    role.className = 'ai-role';
    const p = activeProfile();
    role.textContent =
      kind === 'user' ? '你' : byLabel ?? (p ? shortName(p.name) : '星野助手');
    const div = document.createElement('div');
    div.className = `ai-msg ${kind}${kind === 'bot' && !text ? ' thinking' : ''}`;
    div.textContent = text || (kind === 'bot' ? '思考中…' : '');
    turn.append(role, div);
    box.appendChild(turn);
    box.scrollTop = box.scrollHeight;
    return div;
  }

  function appendAiSources(bubble: HTMLElement, refs: AiStoredSource[]) {
    const named = refs.filter((r) => r.path || r.url);
    if (!named.length) return;
    const src = document.createElement('div');
    src.className = 'ai-src';
    src.append('参考：');
    named.forEach((r, i) => {
      if (i > 0) src.append('、');
      const a = document.createElement('a');
      a.href = r.path ? u(r.path) : r.url!;
      a.target = '_blank';
      a.rel = 'noopener';
      a.textContent = `《${r.title}》`;
      src.appendChild(a);
    });
    bubble.insertAdjacentElement('afterend', src);
  }

  async function sendAiQuestion() {
    const profile = activeProfile();
    if (!profile) {
      aiStatus('先在「模型管理」里配置并保存一个模型');
      return;
    }
    const q = aiFields('input').value.trim();
    if (!q) return;
    aiFields('input').value = '';
    appendAiMsg('user', q);
    const thinkOn = (aiFields('think') as HTMLInputElement).checked;
    const webOn = (aiFields('web') as HTMLInputElement).checked;
    const bubble = appendAiMsg('bot', '');
    bubble.textContent = thinkOn ? '深度思考中…' : '思考中…';
    try {
      const index = await ensureAiIndex();
      const hits = searchIndex(index, q, 5);
      // 联网搜索两种走法：智谱等原生工具 = 服务端搜，最稳；
      // 其余服务商 = 浏览器经公共中转搜必应 RSS，尽力而为。两者都不拖累站内资料回答。
      const nativeSearch = !!profile.webSearchTool;
      const webTask =
        webOn && !nativeSearch
          ? webSearch(q).then(
              (rs) => ({ ok: true, rs }),
              (e) => ({ ok: false, err: e as Error }),
            )
          : null;
      const web = webTask ? await webTask : null;
      // 人格：它就是这个名字本身，不报底层模型和厂商
      const persona = shortName(profile.name);
      const system =
        `你是「${persona}」，个人网站「星野漫游」的站内助手，由站长亲手配置并起了这个名字。` +
        `有人问你是谁、是什么模型、来自哪家公司时：你就是${persona}，是星野漫游的一员，不要提及底层模型与服务商。` +
        `语气亲切自然，可以带一点星空的浪漫气质，但回答保持准确、简洁。` +
        (web?.ok
          ? '回答时把【网】开头的网络搜索结果与站内资料结合分析，网络来源在句末注明（标题）。'
          : nativeSearch
            ? '联网搜索由模型服务端完成，可结合最新网络信息与站内资料回答。'
            : '请优先依据站内资料回答；资料里没有的就直说没有，不要编造。') +
        (thinkOn ? '这道问题开启了深度思考，请先想清楚再作答。' : '用简体中文回答。') +
        '\n\n== 站内资料 ==\n' +
        (buildContextBlock(hits) || '（本次未检索到相关站内资料）') +
        (web?.ok ? '\n\n== 网络搜索结果 ==\n' + buildWebBlock(web.rs) : '') +
        (web && !web.ok
          ? '\n\n== 网络搜索 ==\n（联网搜索失败：' + web.err.message + '，请仅依据站内资料回答）'
          : '');
      // 短期记忆直接取当前会话的最近几条
      const session = curSession() ?? newSession();
      const recent = session.messages.slice(-6).map((m) => ({
        role: (m.role === 'user' ? 'user' : 'assistant') as AiMessage['role'],
        content: m.content,
      }));
      const reply = await aiChat(
        profile,
        [
          { role: 'system', content: system },
          ...recent,
          { role: 'user', content: q },
        ],
        { thinking: thinkOn, webSearch: webOn && nativeSearch },
      );
      // 模型输出常是 Markdown（加粗/列表/代码/公式），渲染成 HTML；
      // renderMarkdown 转义优先，模型输出里的任何 HTML 都只会被当纯文本显示
      bubble.classList.add('md');
      bubble.innerHTML = await renderMarkdown(reply);
      bubble.classList.remove('thinking');
      const sources: AiStoredSource[] = hits
        .filter((h) => h.entry.path)
        .map((h) => ({ title: h.entry.title, path: h.entry.path }));
      appendAiSources(bubble, sources);
      let note: AiStoredNote = null;
      if (nativeSearch && webOn) {
        note = { text: '已联网搜索（服务端搜索）' };
      } else if (web?.ok) {
        note = {
          text: `已联网搜索 ${web.rs.length} 条结果`,
          links: web.rs.slice(0, 3).map((r) => ({ title: r.title, url: r.url })),
        };
      } else if (web && !web.ok) {
        note = { text: '联网搜索失败，本次仅基于站内资料回答' };
      }
      if (note) {
        const el = document.createElement('div');
        el.className = 'ai-src';
        el.textContent = note.text;
        for (const l of note.links ?? []) {
          const a = document.createElement('a');
          a.href = l.url;
          a.target = '_blank';
          a.rel = 'noopener';
          a.textContent = ` ${l.title} ·`;
          el.appendChild(a);
        }
        bubble.insertAdjacentElement('afterend', el);
      }
      // 写进会话并持久化
      session.messages.push({ role: 'user', content: q }, { role: 'bot', content: reply, by: persona, sources, note });
      if (session.title === '新对话') {
        session.title = q.slice(0, 24);
        session.date = todayStr();
      }
      saveSessions();
      refreshSessionSelect();
      const box = $('[data-ai-chat]') as HTMLElement;
      box.scrollTop = box.scrollHeight;
      msg('');
    } catch (e) {
      bubble.textContent = '出错了：' + (e as Error).message;
      bubble.classList.add('thinking');
    }
  }

  function initAiPanel() {
    const presetSel = aiFields('preset') as unknown as HTMLSelectElement;
    for (const p of AI_PRESETS) {
      const opt = document.createElement('option');
      opt.value = p.key;
      opt.textContent = p.label;
      presetSel.appendChild(opt);
    }
    const applyPreset = () => {
      const p = AI_PRESETS.find((x) => x.key === presetSel.value);
      (aiFields('preset-note') as HTMLElement).textContent = p?.note ?? '';
      if (p && p.key !== 'custom') {
        aiFields('baseUrl').value = p.baseUrl;
        aiFields('model').value = p.model;
        // 名字留空时按底层模型自动建议艺名（星渚 / 曜魄 / 云渚 …）
        if (!aiFields('name').value.trim()) {
          aiFields('name').value = personaForModel(p.model) ?? '';
        }
      }
    };
    presetSel.addEventListener('change', applyPreset);
    // 模型档案：读档 → 恢复上次选用 → 表单载入当前档案
    aiProfiles = loadProfiles();
    const savedActive = loadActiveProfileId();
    aiActiveId = aiProfiles.find((p) => p.id === savedActive)?.id ?? aiProfiles[0]?.id ?? null;
    saveActiveProfileId(aiActiveId);
    if (aiActiveId) {
      aiEditingId = aiActiveId;
      fillProfileForm(activeProfile()!);
    } else {
      presetSel.value = AI_PRESETS[0].key;
      applyPreset();
    }
    refreshProfileList();
    refreshModelPop();
    updateModelPill();
    // 恢复上次的深度思考 / 联网搜索开关状态
    const toggles = loadAiToggles();
    (aiFields('think') as HTMLInputElement).checked = toggles.think;
    (aiFields('web') as HTMLInputElement).checked = toggles.web;
    for (const box of [aiFields('think'), aiFields('web')]) {
      box.addEventListener('change', saveAiToggles);
    }
    // 会话下拉 + 恢复上次对话
    refreshSessionSelect();
    if (aiSessionId && curSession()) void openSession(aiSessionId);
  }

  // 深度思考 / 联网搜索两个开关：记住上次的选择
  const AI_TOGGLES_KEY = 'sr-ai-toggles';
  function loadAiToggles(): { think: boolean; web: boolean } {
    try {
      const t = JSON.parse(localStorage.getItem(AI_TOGGLES_KEY) ?? '{}');
      return { think: !!t.think, web: !!t.web };
    } catch {
      return { think: false, web: false };
    }
  }
  function saveAiToggles() {
    localStorage.setItem(
      AI_TOGGLES_KEY,
      JSON.stringify({
        think: (aiFields('think') as HTMLInputElement).checked,
        web: (aiFields('web') as HTMLInputElement).checked,
      }),
    );
  }

  /** 读表单 → 档案可用的接口配置；思考/搜索实现方式跟预设走 */
  const readAiForm = (): AiConfig | null => {
    const baseUrl = aiFields('baseUrl').value.trim();
    const model = aiFields('model').value.trim();
    const apiKey = aiFields('apiKey').value.trim();
    if (!baseUrl || !model || !apiKey) {
      aiStatus('Base URL、模型、API Key 都要填');
      return null;
    }
    const preset = AI_PRESETS.find(
      (p) => p.key === (aiFields('preset') as unknown as HTMLSelectElement).value,
    );
    return {
      baseUrl,
      model,
      apiKey,
      thinkingModel: preset?.thinkingModel,
      thinkingKwargs: preset?.thinkingKwargs,
      thinkingParam: preset?.thinkingParam,
      webSearchTool: preset?.webSearchTool,
    };
  };

  // AI tab 的事件绑定
  // 配置区自己的状态行：反馈就显示在按钮正下方，不依赖全局 msg
  const aiStatus = (m: string) => {
    (aiFields('status') as HTMLElement).textContent = m;
  };
  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const act = t.closest('[data-act]')?.getAttribute('data-act');
    const quickQ = (t.closest('[data-ai-q]') as HTMLElement | null)?.getAttribute('data-ai-q');
    // 模型切换 pill：点击弹出/收起；点其他地方收起
    if (t.closest('[data-ai="model-pill"]')) {
      const pop = $('[data-ai="model-pop"]') as HTMLElement;
      pop.hidden = !pop.hidden;
      return;
    }
    const pill = $('[data-ai="model-pill"]') as HTMLElement;
    const pop = $('[data-ai="model-pop"]') as HTMLElement;
    if (!pop.hidden && !t.closest('[data-ai="model-pop"]')) pop.hidden = true;
    void pill;
    if (quickQ) {
      aiFields('input').value = quickQ;
      aiFields('input').focus();
      return;
    }
    if (
      !act ||
      ![
        'ai-save',
        'ai-test',
        'ai-send',
        'ai-profile-new',
        'ai-new-chat',
        'ai-del-chat',
      ].includes(act)
    )
      return;
    try {
      if (act === 'ai-save') {
        const cfg = readAiForm();
        if (!cfg) return;
        const name = aiFields('name').value.trim() || personaForModel(cfg.model) || cfg.model;
        const id = aiEditingId ?? 'p-' + Date.now().toString(36);
        const profile: AiProfile = { id, name, ...cfg };
        const at = aiProfiles.findIndex((p) => p.id === id);
        if (at >= 0) aiProfiles[at] = profile;
        else aiProfiles.unshift(profile);
        aiActiveId = id;
        aiEditingId = id;
        saveProfiles(aiProfiles);
        saveActiveProfileId(id);
        refreshProfileList();
        refreshModelPop();
        updateModelPill();
        aiStatus(
          at >= 0
            ? `✓ 「${name}」已保存修改`
            : `✓ 「${name}」已就位，现在就可以在聊天里用了`,
        );
      }
      if (act === 'ai-profile-new') {
        aiEditingId = null;
        ['name', 'baseUrl', 'model', 'apiKey'].forEach((k) => (aiFields(k).value = ''));
        const presetSel = aiFields('preset') as unknown as HTMLSelectElement;
        presetSel.value = AI_PRESETS[0].key;
        presetSel.dispatchEvent(new Event('change'));
        aiFields('name').focus();
        aiStatus('填好后点「保存模型」，就是一个新成员');
      }
      if (act === 'ai-test') {
        const cfg = readAiForm();
        if (!cfg) return;
        const btn = t.closest('button') as HTMLButtonElement;
        btn.disabled = true;
        aiStatus('测试中…');
        try {
          const reply = await aiTestConnection(cfg);
          aiStatus('✓ 连接成功，模型回复：' + reply);
        } catch (err) {
          aiStatus('✗ 连接失败：' + (err as Error).message);
          throw err;
        } finally {
          btn.disabled = false;
        }
      }
      if (act === 'ai-send') await sendAiQuestion();
      if (act === 'ai-new-chat') {
        aiSessionId = null;
        localStorage.removeItem(ACTIVE_SESSION_KEY);
        const box = $('[data-ai-chat]') as HTMLElement;
        box.innerHTML = '';
        box.hidden = true;
        refreshSessionSelect();
        aiFields('input').focus();
      }
      if (act === 'ai-del-chat') {
        const btn = t.closest('button') as HTMLButtonElement;
        armDelete(btn, async () => {
          aiSessions = aiSessions.filter((s) => s.id !== aiSessionId);
          saveSessions();
          aiSessionId = null;
          localStorage.removeItem(ACTIVE_SESSION_KEY);
          if (aiSessions.length) {
            await openSession(aiSessions[0].id);
          } else {
            const box = $('[data-ai-chat]') as HTMLElement;
            box.innerHTML = '';
            box.hidden = true;
            refreshSessionSelect();
          }
        });
      }
    } catch (err) {
      msg('出错了：' + (err as Error).message);
    }
  });
  aiFields('input').addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !(e as KeyboardEvent).isComposing) {
      e.preventDefault();
      sendAiQuestion();
    }
  });
  // 会话下拉切换
  (aiFields('session') as unknown as HTMLSelectElement).addEventListener('change', (e) => {
    const id = (e.target as HTMLSelectElement).value;
    if (id && id !== aiSessionId) void openSession(id);
  });

  // Tab 切换
  for (const tab of document.querySelectorAll<HTMLButtonElement>('.admin-tab')) {
    tab.addEventListener('click', () => activateTab(tab.dataset.tab ?? 'moment'));
  }

  initAiPanel();

  // 知识库：写笔记 / 传文档 两种模式切换
  for (const radio of document.querySelectorAll<HTMLInputElement>('input[name="kb-mode"]')) {
    radio.addEventListener('change', () => {
      const v = document.querySelector<HTMLInputElement>('input[name="kb-mode"]:checked')?.value;
      ($('[data-kb-form="note"]') as HTMLElement).hidden = v !== 'note';
      ($('[data-kb-form="file"]') as HTMLElement).hidden = v !== 'file';
    });
  }

  // 画廊：点击/拖拽选图
  const drop = document.querySelector('[data-gallery-drop]');
  const gInput = document.querySelector<HTMLInputElement>('[data-gallery-input]');
  drop?.addEventListener('click', () => gInput?.click());
  drop?.addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent).key === 'Enter') gInput?.click();
  });
  ['dragover', 'dragenter'].forEach((ev) =>
    drop?.addEventListener(ev, (e) => {
      e.preventDefault();
      drop.classList.add('dragging');
    }),
  );
  ['dragleave', 'drop'].forEach((ev) =>
    drop?.addEventListener(ev, () => drop?.classList.remove('dragging')),
  );
  drop?.addEventListener('drop', (e) => {
    e.preventDefault();
    const files = [...(e as DragEvent).dataTransfer!.files].filter((f) => f.type.startsWith('image/'));
    if (gInput && files.length) {
      const dt = new DataTransfer();
      files.forEach((f) => dt.items.add(f));
      gInput.files = dt.files;
    }
  });

  await verify();
</script>
