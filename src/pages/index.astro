---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getMoments } from '../lib/moments';
import { getKbEntries, fileKindLabel } from '../lib/kb';
import { fmtDate, fmtDateShort } from '../lib/format';
import { u } from '../lib/base';
import avatar from '../assets/avatar.jpg';

// 图标从 src/icons 图标库内联进来（?raw 保留 currentColor）
import handIcon from '../icons/hand/wave-fluent-emoji-hc.svg?raw';
import githubIcon from '../icons/social/github.svg?raw';
import bilibiliIcon from '../icons/social/bilibili.svg?raw';
import neteaseIcon from '../icons/social/netease-cloud-music.svg?raw';
import outlookIcon from '../icons/social/outlook.svg?raw';
import AiPet from '../components/AiPet.astro';

const allPosts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const posts = allPosts.slice(0, 3);
const moments = (await getMoments()).slice(0, 2);
const projects = (await getCollection('projects'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
const skills = (await getCollection('skills'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
const kbEntries = (await getKbEntries())
  .filter((e) => e.access === 'public' && e.status !== 'draft' && e.status !== 'archived')
  .slice(0, 3);

// 建站数据：与 innei 一样，把「这个站活了多久、写了多少」摆出来
const founded = new Date('2026-10-25T00:00:00Z');
const days = Math.max(1, Math.ceil((Date.now() - founded.valueOf()) / 86400000));
const chars = allPosts.reduce((sum, p) => sum + (p.body?.length ?? 0), 0);
const lastUpdate = allPosts[0] ? fmtDate(allPosts[0].data.date) : fmtDate(new Date());
---

<Base title="星野漫游 · Starry Roam">
  <section class="hero container wide">
    <span class="hero-ghost" aria-hidden="true">Roam</span>
    <span class="hero-flowers" aria-hidden="true">
      <svg viewBox="0 0 120 110" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- 茎 -->
        <path d="M58 104c-2-18 2-34 8-46M74 104c3-14 1-26-4-36M42 104c-1-10 1-18 4-24"
              stroke="var(--accent)" stroke-width="1.4" stroke-linecap="round" opacity="0.55"/>
        <!-- 叶 -->
        <path d="M52 78c-8-2-13-8-14-15 8 0 14 5 14 15Z" fill="var(--accent)" opacity="0.3"/>
        <path d="M78 84c7-3 11-9 11-16-7 1-12 7-11 16Z" fill="var(--accent)" opacity="0.3"/>
        <!-- 花朵一：花粉 -->
        <g transform="translate(66 56)">
          <circle cx="0" cy="-6" r="4.6" fill="var(--rose)" opacity="0.62"/>
          <circle cx="5.7" cy="-1.9" r="4.6" fill="var(--rose)" opacity="0.62"/>
          <circle cx="3.5" cy="4.9" r="4.6" fill="var(--rose)" opacity="0.62"/>
          <circle cx="-3.5" cy="4.9" r="4.6" fill="var(--rose)" opacity="0.62"/>
          <circle cx="-5.7" cy="-1.9" r="4.6" fill="var(--rose)" opacity="0.62"/>
          <circle cx="0" cy="0" r="3.2" fill="var(--sand)"/>
        </g>
        <!-- 花朵二：雏菊黄 -->
        <g transform="translate(70 16) scale(0.86)">
          <circle cx="0" cy="-6" r="4.6" fill="var(--sand)" opacity="0.75"/>
          <circle cx="5.7" cy="-1.9" r="4.6" fill="var(--sand)" opacity="0.75"/>
          <circle cx="3.5" cy="4.9" r="4.6" fill="var(--sand)" opacity="0.75"/>
          <circle cx="-3.5" cy="4.9" r="4.6" fill="var(--sand)" opacity="0.75"/>
          <circle cx="-5.7" cy="-1.9" r="4.6" fill="var(--sand)" opacity="0.75"/>
          <circle cx="0" cy="0" r="3.2" fill="var(--accent-2)"/>
        </g>
        <!-- 花朵三：小叶芽 -->
        <g transform="translate(45 74) scale(0.62)">
          <circle cx="0" cy="-6" r="4.6" fill="var(--sand)" opacity="0.6"/>
          <circle cx="5.7" cy="-1.9" r="4.6" fill="var(--sand)" opacity="0.6"/>
          <circle cx="3.5" cy="4.9" r="4.6" fill="var(--sand)" opacity="0.6"/>
          <circle cx="-3.5" cy="4.9" r="4.6" fill="var(--sand)" opacity="0.6"/>
          <circle cx="-5.7" cy="-1.9" r="4.6" fill="var(--sand)" opacity="0.6"/>
          <circle cx="0" cy="0" r="3.2" fill="var(--rose)"/>
        </g>
      </svg>
    </span>

    <div class="hero-id" data-entrance>
      <img class="hero-avatar-lg" src={avatar.src} alt="Starry 的头像" width="64" height="64" />
    </div>

    <h1 class="heading-1" lang="en">
      <span class="hl-mask"><span class="hl-line"><span class="ht-lead">Hi, I'm</span> <span class="hero-name">Starry</span><span class="hero-wave" aria-hidden="true"><Fragment set:html={handIcon} /></span></span></span>
    </h1>
    <p class="hero-motto" lang="en" data-entrance>"Do not follow the majority, follow the truth."</p>

    <div class="hero-cta" data-entrance>
      <a class="btn-primary" href={u('/projects/')}>看看作品<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg></a>
      <a class="btn-ghost" href={u('/posts/')}>读读文章</a>
    </div>
    <p class="hero-proof caption-2" data-entrance>
      <span>建站 <b class="stat-num" data-value={String(days)}>{days}</b> 天</span>
      <span>文章 <b class="stat-num" data-value={String(allPosts.length)}>{allPosts.length}</b> 篇</span>
      <span>约 <b class="stat-num" data-value={String(chars)}>{chars.toLocaleString('en-US')}</b> 字</span>
      <span>最近更新 <b>{lastUpdate}</b></span>
    </p>
  </section>

  <section class="tagline container" aria-label="站点标语">
    <p id="tagline">
      <span class="w k1">在</span><span class="w k1">星</span><span class="w k1">野</span><span class="w k1">里</span><span class="w">漫</span><span class="w">游</span><span class="w">的</span><span class="w">人</span><span class="w">，</span><br /><span class="w">不</span><span class="w">急</span><span class="w">着</span><span class="w k3">抵</span><span class="w k3">达</span><span class="w">。</span>
    </p>
    <div class="tagline-more">
      <p>这里放着我在学编程路上做出来的小东西、整理的 AI Skills，还有随手写下的废话条。更新不定时，想到什么放什么，欢迎随便逛逛。</p>
    </div>
    <p class="tagline-src caption-2">— 站语，也送给每个慢慢做东西的人</p>
  </section>

  <main class="container wide">
    <div class="feed">
      <section class="sec" style="--sec-c: var(--accent)" aria-labelledby="latest-posts">
        <div class="sec-head">
          <h2 id="latest-posts">最近的文章</h2>
          <a class="more" href={u('/posts/')}>全部文章</a>
        </div>
        <ul class="rows">
          {posts.map((post) => (
            <li>
              <a class="row" href={u(`/posts/${post.id}/`)}>
                <span class="row-title">{post.data.title}</span>
                <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="sec" style="--sec-c: var(--rose)" aria-labelledby="latest-moments">
        <div class="sec-head">
          <h2 id="latest-moments">废话条</h2>
          <a class="more" href={u('/moments/')}>更多</a>
        </div>
        {moments.length === 0 ? (
          <p class="list-empty">还没有动态——去仓库发一条带 <code>moment</code> 标签的 Issue 试试。</p>
        ) : (
          moments.map((m) => (
            <a class="quote" href={u('/moments/')}>
              <span class="quote-text">{m.text}</span>
              <time datetime={m.date.toISOString()}>{fmtDateShort(m.date)}</time>
            </a>
          ))
        )}
      </section>

      <section class="sec" style="--sec-c: var(--sand-ink)" aria-labelledby="latest-skills">
        <div class="sec-head">
          <h2 id="latest-skills">AI Skills</h2>
          <a class="more" href={u('/skills/')}>全部</a>
        </div>
        <ul class="rows">
          {skills.map((s) => (
            <li>
              <a class="row" href={u(`/skills/${s.id}/`)}>
                <span class="row-title">{s.data.title}</span>
                <time datetime={s.data.date.toISOString()}>{fmtDate(s.data.date)}</time>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="sec" style="--sec-c: var(--accent-2)" aria-labelledby="latest-projects">
        <div class="sec-head">
          <h2 id="latest-projects">作品</h2>
          <a class="more" href={u('/projects/')}>全部作品</a>
        </div>
        <ul class="rows">
          {projects.map((p) => (
            <li>
              <a
                class="row"
                href={p.data.demo ?? p.data.repo ?? u('/projects/')}
                target={(p.data.demo ?? p.data.repo) ? '_blank' : undefined}
                rel="noopener"
              >
                <span class="row-title">{p.data.title}</span>
                <time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="sec" style="--sec-c: var(--accent)" aria-labelledby="latest-kb">
        <div class="sec-head">
          <h2 id="latest-kb">知识库</h2>
          <a class="more" href={u('/kb/')}>全部条目</a>
        </div>
        {kbEntries.length === 0 ? (
          <p class="list-empty">知识库还空着。</p>
        ) : (
          <ul class="rows">
            {kbEntries.map((e) => (
              <li>
                <a class="row" href={u(`/kb/${e.slug}/`)}>
                  <span class="row-title">{e.title}</span>
                  <time datetime={e.date.toISOString()}>{fmtDate(e.date)}</time>
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>

      <div class="findme">
        <span class="fm-label caption-2">在别处找我</span>
        <div class="hero-social">
          <a href="https://github.com/Starryeeeeee" aria-label="GitHub" target="_blank" rel="noopener"><Fragment set:html={githubIcon} /></a>
          <a href="https://www.bilibili.com" aria-label="哔哩哔哩" target="_blank" rel="noopener"><Fragment set:html={bilibiliIcon} /></a>
          <a href="https://music.163.com" aria-label="网易云音乐" target="_blank" rel="noopener"><Fragment set:html={neteaseIcon} /></a>
          <a href="mailto:Jia100906985211@outlook.com" aria-label="发邮件给我"><Fragment set:html={outlookIcon} /></a>
        </div>
      </div>
    </div>
  </main>
  <AiPet />
</Base>

<style>
  /* ============ 首页 · 编辑部式封面 ============
     设计定稿见预览稿：左对齐大字 + 标语逐字点亮 + 7:5 非对称内容栅格 + 莫奈多色板块 */
  /* 首屏英文标题：衬线（站主选定），中文标题仍走宋体 */
  .heading-1 {
    font-family: var(--font-hero);
    font-size: 72px;
    line-height: 1.14;
    font-weight: 400;
    letter-spacing: -0.008em;
  }
  .caption-2 { font-size: 14px; line-height: 20px; font-weight: 400; }
  h1, h2, h3 { text-wrap: balance; }

  /* ---- Hero ---- */
  .hero { position: relative; padding-block: 128px 96px; overflow: hidden; text-align: left; }

  /* 右下角一簇手绘野花：廉价的不是花，是花太多。这里只放一簇 */
  .hero-flowers {
    position: absolute;
    right: 9%;
    bottom: 132px;
    width: 152px;
    pointer-events: none;
    user-select: none;
  }
  .hero-flowers svg { display: block; width: 100%; height: auto; }
  .hero-ghost {
    position: absolute; right: -24px; top: 32px;
    font-family: var(--font-display-en); font-size: 220px; line-height: 1;
    /* 背景字：绿→浅绿→浅黄，同一色相家族，不掺粉与棕（掺了中间会发脏、显诡异） */
    background: linear-gradient(135deg, var(--accent-light), var(--sand) 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    opacity: 0.13; user-select: none; pointer-events: none;
  }
  :global([data-theme='dark']) .hero-ghost { opacity: 0.22; }
  .hero-id { margin-bottom: 56px; }
  
  .hero-avatar-lg { width: 64px; height: 64px; border-radius: 50%; box-shadow: 0 0 0 2px var(--surface), 0 0 0 3.5px var(--line); }
  .hero-id-left .caption-1 b { font-weight: 600; }
  .hero-id-left .caption-1 span { color: var(--ink-3); margin-left: 6px; }

  /* 标题：按行遮罩升字（GSAP）；纯色墨字（background-clip 渐变与中文字体合成有接缝，弃用） */
  .hero h1 { max-width: 760px; margin: 0 0 40px; letter-spacing: -0.022em; }
  .hl-mask { display: block; overflow: hidden; line-height: 1.3; }
  .hl-line { display: inline-block; line-height: 1.3; color: var(--ink); }
  .ht-lead { color: var(--ink); }
  .hero-name { color: var(--accent); }
  .hero-wave { display: inline-block; transform-origin: 72% 72%; }
  .hero-wave :global(svg) { width: 0.78em; height: 0.78em; vertical-align: -0.04em; }
  .hero:hover .hero-wave { animation: wave-hello 1.6s ease-in-out 0.2s; }
  @keyframes wave-hello {
    0%, 100% { transform: rotate(0deg); }
    20% { transform: rotate(16deg); }
    40% { transform: rotate(-8deg); }
    60% { transform: rotate(12deg); }
    80% { transform: rotate(-4deg); }
  }

  .hero-motto {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 20px; line-height: 28px;
    /* 站主的格言是真实内容不是装饰，用 ink-2（7.4:1）而不是弱化灰（4.59 贴线） */
    color: var(--ink-2);
    margin-bottom: 40px;
  }
  .hero-cta { display: flex; align-items: center; gap: 24px; margin-bottom: 32px; }

  /* cottagecore：实心深草绿药丸（白字 6.15:1 过 AA），去掉扫光（纸面上不该有高光掠过） */
  .btn-primary {
    position: relative; display: inline-flex; align-items: center; gap: 8px;
    padding: 13px 30px; border: none; border-radius: var(--radius-pill);
    background: var(--accent-ink);
    color: var(--on-accent);
    font-size: 16px; line-height: 24px; font-weight: 500;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.18) inset, 0 6px 16px rgba(90, 72, 48, 0.14);
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease),
      background var(--dur) var(--ease);
  }
  .btn-primary:hover {
    background: color-mix(in srgb, var(--accent-ink) 82%, var(--p-ink-950));
    transform: translateY(-2px);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.18) inset, 0 10px 22px rgba(90, 72, 48, 0.18);
  }
  .btn-primary:active { transform: translateY(0) scale(0.98); }
  .btn-ghost { font-size: 16px; line-height: 24px; font-weight: 500; color: var(--ink-2); transition: color 0.3s var(--ease); }
  .btn-ghost:hover { color: var(--accent-ink); }
  .hero-proof { display: flex; flex-wrap: wrap; gap: 4px 24px; color: var(--ink-3); }
  .hero-proof b { color: var(--ink-2); font-weight: 500; }

  /* ---- 标语（GSAP scrub 逐字点亮） ---- */
  .tagline { padding-block: 96px; text-align: left; }
  #tagline {
    max-width: 720px;
    font-family: var(--font-display-cn);
    /* 宋体没有 600 字重，写 600 会被合成伪粗，笔画糊成一团 */
    font-size: 48px; line-height: 1.28; font-weight: 400; letter-spacing: 0.01em;
  }
  #tagline .w { opacity: 0.22; }
  #tagline .w.k1 { color: var(--accent-ink); }
  #tagline .w.k3 { color: var(--rose-ink); }
  .tagline-more { max-width: 560px; margin-top: 40px; color: var(--ink-2); }
  .tagline-more p { font-size: 18px; line-height: 28px; }
  .tagline-src { margin-top: 24px; color: var(--ink-3); }

  /* ---- 内容：单列、统一行距、日期列对齐 ---- */
  .feed { max-width: 720px; padding-bottom: 96px; }
  .sec + .sec { margin-top: 72px; }

  .sec { position: relative; }

  /* 栏目名：大号镂空字（同建站日志的年份处理），压在列表上方当底子 */
  .sec-head {
    position: relative; z-index: 1;
    display: flex; align-items: flex-end; justify-content: space-between; gap: 24px;
    margin-bottom: 14px;
  }
  /* 栏目名左侧的色标：像手账里给每一章贴的彩色小签，给页面一点颜色的起落 */
  .sec-head h2::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 6px;
    height: 0.54em;
    border-radius: 3px;
    transform: translateY(-50%);
    background: var(--sec-c, var(--accent));
  }
  .sec-head h2 {
    position: relative;
    padding-left: 22px;
    font-family: var(--font-display-cn);
    font-size: clamp(38px, 3.6vw, 52px);
    line-height: 1;
    font-weight: 400;
    letter-spacing: 0.01em;
    color: transparent;
    -webkit-text-stroke: 1.8px color-mix(in srgb, var(--accent) 88%, transparent);
    user-select: none;
  }
  @supports not (-webkit-text-stroke: 1px black) {
    .sec-head h2 { color: var(--ink-3); opacity: 0.5; }
  }

  .sec-head .more {
    flex-shrink: 0;
    padding-bottom: 6px;
    font-size: 13px;
    /* 链接=可交互，用深草绿而不是最弱灰（一处颜色一个含义） */
    color: var(--accent-ink);
    transition: color 0.3s var(--ease);
  }
  .sec-head .more:hover { color: var(--p-leaf-400); }

  /* 列表压在字的下缘，形成叠底关系 */
  .rows, .quote { position: relative; z-index: 1; }

  .rows { list-style: none; margin: 0; padding: 0; }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 92px;
    align-items: baseline;
    gap: 24px;
    padding: 13px 0;
  }
  .row-title {
    min-width: 0;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    font-size: 17px; line-height: 26px; color: var(--ink);
    transition: color 0.25s var(--ease);
  }
  .row time {
    justify-self: end;
    font-size: 12.5px; line-height: 26px;
    /* 陶土深一档：82% 混色只有 4.43:1，全量 ink 才过 4.5 */
    color: var(--accent-2-ink);
    font-variant-numeric: tabular-nums; white-space: nowrap;
  }
  .row:hover .row-title { color: var(--accent-ink); }
  .row:active .row-title { color: var(--accent); }

  /* 废话条：留一处呼吸口，正文用楷体，不加卡片 */
  .quote {
    display: block;
    padding: 20px 0 6px 18px;
    border-left: 2px solid color-mix(in srgb, var(--rose) 45%, transparent);
  }
  .quote + .quote { padding-top: 18px; }
  .quote-text {
    display: block;
    font-family: var(--font-body);
    font-size: 20px; line-height: 1.85; color: var(--ink);
    transition: color 0.25s var(--ease);
  }
  .quote time {
    display: block; margin-top: 8px;
    font-size: 12.5px; color: var(--ink-3); font-variant-numeric: tabular-nums;
  }
  .quote:hover .quote-text { color: var(--accent-ink); }

  .findme {
    display: flex; align-items: center; gap: 16px;
    margin-top: 72px; padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .findme .fm-label { color: var(--ink-3); }
  .hero-social { display: flex; gap: 8px; }
  /* 抵消旧版 hero-social 的悬停气泡（findme 行不用 data-tip） */
  .hero-social a::after,
  .hero-social a::before { content: none; }
  .hero-social a {
    display: grid; place-items: center; width: 34px; height: 34px; border-radius: var(--radius-md);
    color: var(--ink-2); transition: color 0.3s var(--ease), background 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .hero-social a:hover { color: var(--accent-ink); background: var(--wash); transform: translateY(-2px); }
  .hero-social a:active { transform: scale(0.96); }
  .hero-social a :global(svg) { width: 16px; height: 16px; }

  /* ---- GSAP 初始态：仅在 JS 可用且未开启减少动态时隐藏（Base 已打 js 标记） ---- */
  :global(html.js.anim) [data-entrance] { opacity: 0; }
  :global(html.js.anim) .hl-line { transform: translateY(110%); }

  @media (max-width: 760px) {
    .feed { max-width: none; }
    /* 窄屏改成「标题一行、日期在下面一行」，不截断长标题 */
    .row { grid-template-columns: minmax(0, 1fr); gap: 2px; padding: 14px 0; }
    .row-title { font-size: 16px; white-space: normal; overflow: visible; }
    .row time { justify-self: start; line-height: 20px; }
    .sec + .sec { margin-top: 56px; }
    .heading-1 { font-size: 40px; line-height: 1.16; }
    #tagline { font-size: 28px; }
    /* 130px 在 390 宽的屏上会顶出右边界，缩小并往下让开头像 */
    .hero-ghost { font-size: 74px; top: 104px; right: 6px; opacity: 0.12; }
    /* 手机屏放不下这簇花，不显示，省得和头像挤在一起 */
    .hero-flowers { display: none; }
    .hero { padding-top: 88px; }
    .hl-mask { display: inline; overflow: visible; }
    :global(html.js.anim) .hl-line { transform: none; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduce || !document.documentElement.classList.contains('anim')) {
    // 减少动态：所有内容直接呈现（CSS 初始隐藏只存在于 anim 标记下，这里兜底数字）
    document.querySelectorAll<HTMLElement>('.stat-num').forEach((el) => {
      el.textContent = el.dataset.value ?? '0';
    });
  } else {
    gsap.registerPlugin(ScrollTrigger);

    // 入场时间线：行遮罩升字，元素错峰浮现
    const tl = gsap.timeline({ defaults: { ease: 'power4.out' } });
    tl.to('.hero-id', { opacity: 1, y: 0, duration: 0.7 }, 0.15)
      .to('.hl-line', { y: 0, duration: 1.1, stagger: 0.14 }, 0.3)
      .to('.hero-motto', { opacity: 1, y: 0, duration: 0.7 }, 0.8)
      .to('.hero-cta', { opacity: 1, y: 0, duration: 0.7 }, 0.95)
      .to('.hero-proof', { opacity: 1, y: 0, duration: 0.7 }, 1.1);
    gsap.set(['.hero-id', '.hero-motto', '.hero-cta', '.hero-proof'], { y: 28 });

    // 数据行数字滚动（沿用原 easeOutCubic 手感）
    tl.add(() => {
      document.querySelectorAll<HTMLElement>('.stat-num').forEach((el) => {
        const target = Number(el.dataset.value ?? '0');
        const obj = { v: 0 };
        gsap.to(obj, {
          v: target, duration: 0.9, ease: 'power2.out',
          onUpdate: () => { el.textContent = Math.round(obj.v).toLocaleString('en-US'); },
        });
      });
    }, 1.25);

    // 标语：逐字随滚动匀速点亮（scrub 跟手）
    gsap.to('#tagline .w', {
      opacity: 1,
      ease: 'none',
      stagger: 0.6,
      scrollTrigger: { trigger: '.tagline', start: 'top 78%', end: 'top 25%', scrub: 0.6 },
    });
    gsap.from('.tagline-more', {
      opacity: 0.45, y: 16, duration: 0.9, ease: 'power2.out',
      scrollTrigger: { trigger: '.tagline-more', start: 'top 92%', once: true },
    });
    gsap.from('.tagline-src', {
      opacity: 0, y: 16, duration: 0.7, ease: 'power3.out',
      scrollTrigger: { trigger: '.tagline-src', start: 'top 92%', once: true },
    });

    // 内容板块：随滚动匀速上移浮现（整板块一个单元，项与项不碰撞）
    // 首屏之后的板块不做「完全隐藏」：默认就淡淡地在，滚动时慢慢浮上来。
    // 42% 起手 + 长距离 scrub，滚到面前才走到 1，不会突然跳出来。
    gsap.utils.toArray<HTMLElement>('.sec').forEach((sec) => {
      gsap.fromTo(
        sec,
        { opacity: 0.42, y: 18 },
        {
          opacity: 1,
          y: 0,
          ease: 'none',
          scrollTrigger: { trigger: sec, start: 'top 96%', end: 'top 38%', scrub: 1.1 },
        },
      );
    });
    gsap.from('.findme', {
      opacity: 0.5, y: 14, duration: 0.9, ease: 'power2.out',
      scrollTrigger: { trigger: '.findme', start: 'top 94%', once: true },
    });
    ScrollTrigger.refresh();
  }
</script>
