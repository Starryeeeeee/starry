---
import Base from '../layouts/Base.astro';
import { getMoments } from '../lib/moments';
import { fmtDateShort } from '../lib/format';
import avatar from '../assets/avatar.jpg';
import heartIcon from '../icons/ui/heart.svg?raw';

const moments = await getMoments();
---

<Base title="废话条 · 星野漫游" description="Starry 的日常动态，朋友圈式的短内容。">
  <div class="container">
    <h1 class="page-title">废话条</h1>
    <p class="page-desc">日常的、碎碎的、不值得写成文章的话，都放在这里。</p>

    {moments.length === 0 ? (
      <div class="list-empty">还没有动态。</div>
    ) : (
      moments.map((m) => (
        <article class="moment-card">
          <div class="moment-head">
            <span class="moment-avatar" aria-hidden="true"><img src={avatar.src} alt="" /></span>
            <span class="moment-name">Starry</span>
            <time datetime={m.date.toISOString()}>{fmtDateShort(m.date)}</time>
          </div>
          <p class="moment-body">{m.text}</p>
          <div class="moment-actions">
            <button class="moment-like" type="button" data-like-id={m.id} disabled aria-label="喜欢" aria-pressed="false">
              <span class="moment-like-icon" aria-hidden="true"><Fragment set:html={heartIcon} /></span>
              <span class="count">0</span>
            </button>
          </div>
        </article>
      ))
    )}
  </div>
</Base>

<style>
  .page-title {
    margin-top: 56px;
    font-size: 2rem;
    font-weight: 800;
  }
  .page-desc {
    margin: 10px 0 26px;
    color: var(--ink-2);
  }
  .moments-empty {
    padding: 36px 24px;
    text-align: center;
    color: var(--ink-3);
    background: var(--wash);
    border-radius: var(--radius);
    font-size: 0.92rem;
    line-height: 2;
  }
  .moments-empty code {
    font-family: var(--font-mono);
    background: var(--surface-2);
    padding: 0.1em 0.4em;
    border-radius: 6px;
    font-size: 0.9em;
  }
  .moment-like.is-liked {
    color: #b4766b; /* 陶土玫瑰：点过的心是有温度的 */
    background: color-mix(in srgb, #b4766b 12%, var(--surface-2));
  }
  .moment-like.is-liked .moment-like-icon svg {
    fill: currentColor;
  }
</style>

<script>
  // 点赞：Supabase 匿名计数（fetchLikes/sendLike 失败全部静默降级）
  import { fetchLikes, sendLike } from '../lib/likes';

  const liked: Set<string> = new Set(JSON.parse(localStorage.getItem('sr-liked') ?? '[]'));

  function paint(btn: HTMLButtonElement, count: number, isLiked: boolean) {
    (btn.querySelector('.count') as HTMLElement).textContent = String(count);
    btn.classList.toggle('is-liked', isLiked);
    btn.setAttribute('aria-pressed', String(isLiked));
  }

  const btns = [...document.querySelectorAll<HTMLButtonElement>('.moment-like')];
  btns.forEach((b) => (b.disabled = true)); // 计数回来之前先不可点

  fetchLikes().then((map) => {
    for (const btn of btns) {
      const id = btn.dataset.likeId as string;
      paint(btn, map[id] ?? 0, liked.has(id));
      btn.disabled = false;
    }
  });

  for (const btn of btns) {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.likeId as string;
      if (liked.has(id) || btn.disabled) return; // 一人一条一次
      btn.disabled = true;
      liked.add(id);
      const countEl = btn.querySelector('.count') as HTMLElement;
      countEl.textContent = String(Number(countEl.textContent ?? '0') + 1);
      btn.classList.add('is-liked');
      btn.setAttribute('aria-pressed', 'true');
      const server = await sendLike(id);
      if (server !== null) countEl.textContent = String(server);
      else {
        // 发送失败就当没点过
        btn.classList.remove('is-liked');
        btn.setAttribute('aria-pressed', 'false');
        liked.delete(id);
      }
      localStorage.setItem('sr-liked', JSON.stringify([...liked]));
      btn.disabled = false;
    });
  }
</script>
