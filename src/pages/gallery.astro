---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import { galleryFileRecords, galleryHref } from '../lib/gallery';

// 仓库里的老图：文件名日期前缀变时间标注，其余变图注（由 Astro 处理尺寸与格式）
const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/gallery/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}',
  { eager: true },
);

const legacyPhotos = Object.entries(modules)
  .map(([path, mod]) => {
    const filename = path.split('/').pop() ?? path;
    const stem = filename.replace(/\.[^.]+$/, '');
    const date = stem.match(/^\d{4}-\d{2}-\d{2}/)?.[0] ?? '';
    const caption = stem.replace(/^\d{4}-\d{2}-\d{2}[\s_-]?/, '') || stem;
    return { href: mod.default.src, meta: mod.default, caption, date, stem, remote: false as const };
  });

// R2 里的新图：清单记元数据，原图直链引用（不再进 Git 仓库）
const remotePhotos = galleryFileRecords.map((r) => ({
  href: galleryHref(r),
  meta: null,
  caption: r.caption,
  date: r.date,
  stem: `${r.date} ${r.id}`,
  remote: true as const,
}));

// 新的照片排前面
const photos = [...legacyPhotos, ...remotePhotos].sort((a, b) =>
  b.date === a.date ? b.stem.localeCompare(a.stem) : b.date.localeCompare(a.date),
);
---

<Base title="画廊 · 星野漫游" description="Starry 分享的照片：拍到的、做出来的、值得留下的画面。">
  <div class="container wide">
    <h1 class="page-title">画廊</h1>
    <p class="page-desc">拍到的、做出来的、值得留下的画面。点开可以看大图。</p>

    {photos.length === 0 ? (
      <div class="gallery-empty">还没有照片。</div>
    ) : (
      <div class="gallery-grid">
        {photos.map((p, i) => (
          <figure class="gallery-item reveal" style={`--i:${i % 3}`}>
            <button
              class="gallery-thumb"
              type="button"
              data-full={p.href}
              data-caption={`${p.caption}${p.date ? ` · ${p.date}` : ''}`}
              aria-label={`放大查看：${p.caption}`}
            >
              {p.remote ? (
                <img
                  src={p.href}
                  alt={p.caption}
                  loading={i < 3 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              ) : (
                <Image
                  src={p.meta!}
                  alt={p.caption}
                  widths={[480, 960]}
                  sizes="(max-width: 560px) 92vw, (max-width: 1024px) 46vw, 31vw"
                  loading={i < 3 ? 'eager' : 'lazy'}
                />
              )}
            </button>
            <figcaption>
              <span>{p.caption}</span>
              {p.date && <span class="date">{p.date}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    )}
  </div>

  <div class="lightbox" id="lightbox" hidden>
    <button class="lightbox-close" type="button" aria-label="关闭大图">✕</button>
    <figure>
      <img id="lightbox-img" src="" alt="" />
      <figcaption id="lightbox-caption"></figcaption>
    </figure>
  </div>
</Base>


<script>
  // 灯箱：点击照片 → 深色房间看大图；ESC / 关闭按钮 / 点空白处退出
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lightboxCaption = document.getElementById('lightbox-caption');
  const closeBtn = lightbox?.querySelector('.lightbox-close');

  let lastFocus: HTMLElement | null = null;

  function openLightbox(src: string, caption: string) {
    if (!lightbox || !lightboxImg || !lightboxCaption) return;
    lastFocus = document.activeElement as HTMLElement | null;
    lightboxImg.src = src;
    lightboxImg.alt = caption;
    lightboxCaption.textContent = caption;
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
    closeBtn instanceof HTMLElement && closeBtn.focus();
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.hidden = true;
    document.body.style.overflow = '';
    lastFocus?.focus();
  }

  document.querySelectorAll<HTMLButtonElement>('.gallery-thumb').forEach((btn) => {
    btn.addEventListener('click', () =>
      openLightbox(btn.dataset.full ?? '', btn.dataset.caption ?? ''),
    );
  });

  closeBtn?.addEventListener('click', closeLightbox);

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox && !lightbox.hidden) closeLightbox();
  });
</script>
