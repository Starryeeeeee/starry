---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Comments from '../../components/Comments.astro';
import { fmtDate } from '../../lib/format';
import { u } from '../../lib/base';
import { kbFileRecords, kbFileHref, fileKindLabel, isPreviewable, type KbFileRecord } from '../../lib/kb';

export async function getStaticPaths() {
  // private 完全不构建；personal 构建但不进列表与索引，只能靠直链访问
  const notes = (await getCollection('kb')).filter(
    (n) => n.data.status !== 'draft' && n.data.access !== 'private',
  );
  const filePages = kbFileRecords
    .filter((f) => f.status !== 'draft' && (f.access ?? 'public') !== 'private')
    .map((file) => ({
      params: { slug: file.slug },
      props: { kind: 'file' as const, file },
    }));
  // 笔记与文档合成一条时间流（新→旧），详情页据此取前后相邻条目
  const stream = [
    ...notes
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
      .map((note) => ({
        slug: note.id,
        title: note.data.title,
        date: note.data.date.valueOf(),
        props: { kind: 'note' as const, note },
      })),
    ...filePages.map((p) => ({
      slug: p.params.slug,
      title: p.props.file!.title,
      date: p.props.file!.date.valueOf(),
      props: p.props,
    })),
  ].sort((a, b) => b.date - a.date);
  return stream.map((item, i) => ({
    params: { slug: item.slug },
    props: {
      ...item.props,
      newer: i > 0 ? { slug: stream[i - 1].slug, title: stream[i - 1].title } : null,
      older:
        i < stream.length - 1
          ? { slug: stream[i + 1].slug, title: stream[i + 1].title }
          : null,
    },
  }));
}

const { kind, note, file, newer, older } = Astro.props as {
  kind: 'note' | 'file';
  note?: import('astro:content').CollectionEntry<'kb'>;
  file?: KbFileRecord;
  newer: { slug: string; title: string } | null;
  older: { slug: string; title: string } | null;
};

const entry = kind === 'note' && note
  ? {
      title: note.data.title,
      subject: note.data.subject,
      tags: note.data.tags,
      description: note.data.description,
      date: note.data.date,
    }
  : {
      title: file!.title,
      subject: file!.subject,
      tags: file!.tags,
      description: file!.description,
      date: new Date(file!.date),
    };

const { Content } = kind === 'note' && note ? await render(note) : { Content: null };
const fileUrl = file ? kbFileHref(file) : '';
const previewable = file ? isPreviewable(file.ext) : false;
const sizeLabel = file ? `${Math.max(1, Math.round(file.size / 1024))} KB` : '';
---

<Base title={`${entry.title} · 星野漫游`} description={entry.description || '知识库条目'}>
  <article class="container prose">
    <p class="kb-crumb"><a href={u('/kb/')}>← 回到知识库</a></p>
    <h1>{entry.title}</h1>
    <p class="prose-meta">
      <span class="kb-kind">{kind === 'note' ? '笔记' : fileKindLabel(file?.ext)}</span>
      <span>{entry.subject}</span>
      <time datetime={entry.date.toISOString()}>{fmtDate(entry.date)}</time>
      {file && <span>{sizeLabel}</span>}
    </p>

    {entry.description && <p class="kb-lead">{entry.description}</p>}

    {kind === 'note' && Content && (
      <div class="prose-body">
        <Content />
      </div>
    )}

    {kind === 'file' && (
      <div class="kb-file-box">
        {previewable ? (
          <iframe class="kb-pdf" src={fileUrl} title={entry.title} loading="lazy"></iframe>
        ) : (
          <div class="kb-file-hint">
            <p>这一类文件（{fileKindLabel(file?.ext)}）浏览器里看不了，下载后打开。</p>
          </div>
        )}
        <div class="kb-file-actions">
          <a
            class="kb-btn primary"
            href={fileUrl}
            target={previewable ? '_blank' : undefined}
            rel={previewable ? 'noopener' : undefined}
            download={previewable ? undefined : true}
          >
            {previewable ? '新窗口打开' : '下载文件'}
          </a>
        </div>
      </div>
    )}

    {entry.tags.length > 0 && (
      <div class="tags">{entry.tags.map((t) => <span>{t}</span>)}</div>
    )}
    {(newer || older) && (
      <nav class="kb-pager" aria-label="相邻条目">
        {newer ? (
          <a class="pager-link" href={u(`/kb/${newer.slug}/`)}>
            <span>← 更新一篇</span>
            <b>{newer.title}</b>
          </a>
        ) : <span class="pager-link ghost-side" aria-hidden="true"></span>}
        {older ? (
          <a class="pager-link next" href={u(`/kb/${older.slug}/`)}>
            <span>更早一篇 →</span>
            <b>{older.title}</b>
          </a>
        ) : <span class="pager-link ghost-side" aria-hidden="true"></span>}
      </nav>
    )}
    <Comments />
  </article>
</Base>

<style>
  .kb-pager {
    display: flex;
    gap: 10px;
    margin-top: 34px;
  }
  .pager-link {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 14px;
    background: var(--wash);
    border-radius: var(--radius);
    text-decoration: none;
    transition: background var(--dur) var(--ease-out);
  }
  .pager-link:hover {
    background: color-mix(in srgb, var(--accent) 10%, var(--wash));
  }
  .pager-link span {
    font-size: var(--text-xs);
    color: var(--ink-3);
  }
  .pager-link.next {
    text-align: right;
  }
  .pager-link b {
    font-weight: 600;
    color: var(--accent-ink);
    overflow-wrap: anywhere;
  }
  .ghost-side {
    background: none;
  }
  .kb-crumb {
    margin-top: 40px;
    font-size: var(--text-sm);
  }
  .kb-crumb a {
    color: var(--ink-2);
    text-decoration: none;
  }
  .kb-crumb a:hover {
    color: var(--accent);
  }
  .kb-kind {
    padding: 2px 10px;
    font-size: var(--text-2xs);
    border-radius: var(--radius-pill);
    background: var(--wash);
    color: var(--accent-ink);
  }
  .kb-lead {
    margin: 6px 0 18px;
    padding: 12px 16px;
    color: var(--ink-2);
    background: var(--wash);
    border-radius: var(--radius);
    font-size: var(--text-sm);
    line-height: 1.9;
  }
  .kb-file-box {
    margin: 18px 0;
  }
  .kb-pdf {
    width: 100%;
    height: 78vh;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .kb-file-hint {
    padding: 48px 24px;
    text-align: center;
    color: var(--ink-3);
    background: var(--wash);
    border-radius: var(--radius);
    font-size: var(--text-sm);
  }
  .kb-file-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 14px;
  }
  .kb-btn {
    display: inline-block;
    padding: 9px 22px;
    font-size: var(--text-sm);
    font-weight: 550;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: transform 0.15s ease;
  }
  .kb-btn:hover {
    transform: translateY(-1px);
  }
  .kb-btn.primary {
    color: var(--on-solid);
    background: var(--accent);
  }
</style>
