---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Comments from '../../components/Comments.astro';
import { fmtDate } from '../../lib/format';
import { u } from '../../lib/base';
import { kbFileRecords, fileKindLabel, isPreviewable, type KbFileRecord } from '../../lib/kb';

export async function getStaticPaths() {
  const notes = await getCollection('kb');
  const notePages = notes.map((note) => ({
    params: { slug: note.id },
    props: { kind: 'note' as const, note },
  }));
  const filePages = kbFileRecords.map((file) => ({
    params: { slug: file.slug },
    props: { kind: 'file' as const, file },
  }));
  return [...notePages, ...filePages];
}

const { kind, note, file } = Astro.props as {
  kind: 'note' | 'file';
  note?: import('astro').CollectionEntry<'kb'>;
  file?: KbFileRecord;
};

const entry = kind === 'note' && note
  ? {
      title: note.data.title,
      subject: note.data.subject,
      tags: note.data.tags,
      description: note.data.description,
      date: note.data.date,
    }
  : {
      title: file!.title,
      subject: file!.subject,
      tags: file!.tags,
      description: file!.description,
      date: new Date(file!.date),
    };

const { Content } = kind === 'note' && note ? await render(note) : { Content: null };
const fileUrl = file ? u(file.file) : '';
const previewable = file ? isPreviewable(file.ext) : false;
const sizeLabel = file ? `${Math.max(1, Math.round(file.size / 1024))} KB` : '';
---

<Base title={`${entry.title} · 星野漫游`} description={entry.description || '知识库条目'}>
  <article class="container prose">
    <p class="kb-crumb"><a href={u('/kb/')}>← 回到知识库</a></p>
    <h1>{entry.title}</h1>
    <p class="prose-meta">
      <span class="kb-kind">{kind === 'note' ? '笔记' : fileKindLabel(file?.ext)}</span>
      <span>{entry.subject}</span>
      <time datetime={entry.date.toISOString()}>{fmtDate(entry.date)}</time>
      {file && <span>{sizeLabel}</span>}
    </p>

    {entry.description && <p class="kb-lead">{entry.description}</p>}

    {kind === 'note' && Content && (
      <div class="prose-body">
        <Content />
      </div>
    )}

    {kind === 'file' && (
      <div class="kb-file-box">
        {previewable ? (
          <iframe class="kb-pdf" src={fileUrl} title={entry.title} loading="lazy"></iframe>
        ) : (
          <div class="kb-file-hint">
            <p>这一类文件（{fileKindLabel(file?.ext)}）浏览器里看不了，下载后打开。</p>
          </div>
        )}
        <div class="kb-file-actions">
          <a
            class="kb-btn primary"
            href={fileUrl}
            target={previewable ? '_blank' : undefined}
            rel={previewable ? 'noopener' : undefined}
            download={previewable ? undefined : true}
          >
            {previewable ? '新窗口打开' : '下载文件'}
          </a>
        </div>
      </div>
    )}

    {entry.tags.length > 0 && (
      <div class="tags">{entry.tags.map((t) => <span>{t}</span>)}</div>
    )}
    <Comments />
  </article>
</Base>

<style>
  .kb-crumb {
    margin-top: 40px;
    font-size: 0.88rem;
  }
  .kb-crumb a {
    color: var(--ink-2);
    text-decoration: none;
  }
  .kb-crumb a:hover {
    color: var(--accent);
  }
  .kb-kind {
    padding: 2px 10px;
    font-size: 0.78rem;
    border-radius: 999px;
    background: var(--wash);
    color: var(--accent-ink);
  }
  .kb-lead {
    margin: 6px 0 18px;
    padding: 12px 16px;
    color: var(--ink-2);
    background: var(--wash);
    border-radius: var(--radius);
    font-size: 0.94rem;
    line-height: 1.9;
  }
  .kb-file-box {
    margin: 18px 0;
  }
  .kb-pdf {
    width: 100%;
    height: 78vh;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .kb-file-hint {
    padding: 48px 24px;
    text-align: center;
    color: var(--ink-3);
    background: var(--wash);
    border-radius: var(--radius);
    font-size: 0.94rem;
  }
  .kb-file-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 14px;
  }
  .kb-btn {
    display: inline-block;
    padding: 9px 22px;
    font-size: 0.92rem;
    font-weight: 550;
    border-radius: 10px;
    text-decoration: none;
    transition: transform 0.15s ease;
  }
  .kb-btn:hover {
    transform: translateY(-1px);
  }
  .kb-btn.primary {
    color: #fff;
    background: var(--accent);
  }
</style>
