---
import Base from '../../layouts/Base.astro';
import { getKbEntries, kbSubjects, fileKindLabel } from '../../lib/kb';
import { fmtDate } from '../../lib/format';
import { u } from '../../lib/base';

// 归档仍可直接访问详情页但不在列表出现；personal / private 一律不进列表
const entries = (await getKbEntries()).filter(
  (e) => e.status !== 'draft' && e.status !== 'archived' && e.access === 'public',
);
const subjects = kbSubjects(entries);
// 标签聚合：按使用次数排序（2026-11-14 采纳 Copilot 建议的标签筛选）
const tagCounts = new Map<string, number>();
for (const e of entries) for (const t of e.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 14);
---

<Base title="知识库 · 星野漫游" description="Starry 的学习笔记、资料文档与定理公式、解题技巧。">
  <div class="container">
    <h1 class="page-title">知识库</h1>
    <p class="page-desc">学习笔记、资料文档，还有值得反复看的定理、公式和解题技巧。</p>

    <div class="kb-toolbar reveal">
      <div class="kb-chips" role="group" aria-label="按科目筛选">
        <button class="chip" type="button" data-subject="" aria-pressed="true">全部</button>
        {subjects.map((s) => (
          <button class="chip" type="button" data-subject={s.name} aria-pressed="false">{s.name}<i>{s.count}</i></button>
        ))}
      </div>
      <input class="field" type="search" placeholder="搜标题、说明、标签…" aria-label="搜索知识库" />
    </div>
    {tags.length > 0 && (
      <div class="kb-chips kb-tag-row reveal" role="group" aria-label="按标签筛选">
        <button class="chip" type="button" data-tag="" aria-pressed="true">全部标签</button>
        {tags.map(([t, n]) => (
          <button class="chip" type="button" data-tag={t} aria-pressed="false">{t}<i>{n}</i></button>
        ))}
      </div>
    )}

    {entries.length === 0 ? (
      <div class="empty">知识库还空着——第一批内容整理好后会出现在这里。</div>
    ) : (
      <div class="kb-list" id="kb-list">
        {entries.map((e) => (
          <a
            class="kb-item reveal"
            href={u(`/kb/${e.slug}/`)}
            data-subject={e.subject}
            data-tags={e.tags.join(' ')}
            data-search={`${e.title} ${e.subject} ${e.tags.join(' ')} ${e.description}`.toLowerCase()}
          >
            <div class="kb-item-head">
              <span class="kb-kind" data-kind={e.kind}>
                {e.kind === 'note' ? '笔记' : fileKindLabel(e.ext)}
              </span>
              <h3>{e.title}</h3>
              <time datetime={e.date.toISOString()}>{fmtDate(e.date)}</time>
            </div>
            {e.description && <p class="kb-desc">{e.description}</p>}
            <div class="kb-item-foot">
              <span class="kb-subject">{e.subject}</span>
              {e.tags.length > 0 && (
                <div class="tags">{e.tags.map((t) => <span>{t}</span>)}</div>
              )}
              {e.kind === 'file' && <span class="kb-size">{e.sizeKB} KB</span>}
            </div>
          </a>
        ))}
      </div>
      <div class="empty" id="kb-list-empty" hidden>没有匹配的内容，换个关键词试试。</div>
    )}
  </div>
</Base>

<script>
  // 前端筛选：科目 chip + 标签 chip + 关键词，三条件取交集；无 JS 时全量展示，不影响阅读
  // 匹配数据在 .kb-item 的 data-search 属性里（标题/科目/标签/说明，构建时写死）
  const chips = document.querySelectorAll<HTMLElement>('.kb-toolbar .chip[aria-pressed]');
  const tagChips = document.querySelectorAll<HTMLElement>('.kb-tag-row .chip[aria-pressed]');
  const search = document.querySelector<HTMLInputElement>('.field');
  const items = document.querySelectorAll<HTMLElement>('.kb-item');
  const emptyTip = document.getElementById('kb-list-empty');
  let subject = '';
  let tag = '';

  function apply() {
    const q = (search?.value ?? '').trim().toLowerCase();
    let visible = 0;
    for (const el of items) {
      const okSubject = !subject || el.dataset.subject === subject;
      const itemTags = (el.dataset.tags ?? '').split(' ').filter(Boolean);
      const okTag = !tag || itemTags.includes(tag);
      const okQuery = !q || (el.dataset.search ?? '').includes(q);
      const show = okSubject && okTag && okQuery;
      el.hidden = !show;
      if (show) visible++;
    }
    if (emptyTip) emptyTip.hidden = visible > 0;
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
      chip.setAttribute('aria-pressed', 'true');
      subject = chip.dataset.subject ?? '';
      apply();
    });
  }
  for (const chip of tagChips) {
    chip.addEventListener('click', () => {
      tagChips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
      chip.setAttribute('aria-pressed', 'true');
      tag = chip.dataset.tag ?? '';
      apply();
    });
  }
  search?.addEventListener('input', apply);
</script>

<style>
  .kb-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    /* 原来 22px，悬浮块一出现就顶到筛选行上，加大到 30px */
    margin-bottom: 30px;
  }
  .kb-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    flex: 1;
    min-width: 200px;
  }
  .kb-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .kb-item {
    position: relative;
    display: block;
    padding: 14px 16px 14px 22px;
    /* 12 比 18 轻：不给文字套一个明显的圆角色块 */
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: background var(--dur) var(--ease-out);
  }
  /* 悬浮：左侧一根草绿竖线长出来，配合极淡的绿意与标题变色。
     不用整块米色填充——那是一块"色框"，在无边框列表里显得笨重。 */
  .kb-item::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 16px;
    bottom: 16px;
    width: 3px;
    border-radius: 2px;
    background: var(--accent);
    opacity: 0;
    transform: scaleY(0.45);
    transition: opacity var(--dur) var(--ease-out), transform var(--dur) var(--ease-out);
  }
  .kb-item:hover::before,
  .kb-item:focus-visible::before {
    opacity: 1;
    transform: scaleY(1);
  }
  /* 不加任何背景填充：一旦有块，就又变成"给文字套了个框"。
     悬浮只做两件事——左侧竖线长出来、标题变绿，足够表达"我在这一行"。 */
  .kb-item:hover,
  .kb-item:focus-visible {
    background: transparent;
  }
  .kb-item:hover h3,
  .kb-item:focus-visible h3 {
    color: var(--accent-ink);
  }
  .kb-item[hidden] {
    display: none;
  }
  .kb-item-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .kb-item-head h3 {
    flex: 1;
    min-width: 0;
    font-size: var(--text-md);
    font-weight: 650;
    color: var(--ink);
  }
  .kb-item-head time {
    flex-shrink: 0;
    font-size: var(--text-xs);
    color: var(--ink-3);
  }
  .kb-kind {
    flex-shrink: 0;
    padding: 2px 9px;
    font-size: var(--text-2xs);
    border-radius: var(--radius-pill);
    background: var(--wash);
    color: var(--accent-ink);
    white-space: nowrap;
  }
  .kb-kind[data-kind='file'] {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .kb-desc {
    margin: 8px 0 0;
    font-size: var(--text-sm);
    color: var(--ink-2);
    line-height: 1.8;
  }
  .kb-item-foot {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 12px;
  }
  .kb-subject {
    font-size: var(--text-2xs);
    color: var(--accent-ink);
    background: var(--wash);
    padding: 2px 10px;
    border-radius: var(--radius-pill);
  }
  .kb-size {
    margin-left: auto;
    font-size: var(--text-2xs);
    color: var(--ink-3);
  }
  @media (max-width: 560px) {
    .kb-item {
      /* 手机上也给左侧竖线留出位置 */
      padding: 14px 12px 14px 18px;
    }
    .kb-item-head {
      flex-wrap: wrap;
    }
    .kb-item-head time {
      order: 3;
    }
  }
</style>
